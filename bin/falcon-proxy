#!/usr/bin/env python3
"""VLESS Reality proxy for the whole system, through falcon-proxyd.

  falcon-proxy set [LINK]      saves a vless:// link, read from stdin without LINK
  falcon-proxy on              asks the server first, connects, goes back to direct on failure
  falcon-proxy start           connects without asking, for a login with no network yet
  falcon-proxy off             goes back to a direct connection
  falcon-proxy status          prints the state as JSON
  falcon-proxy setup           one time setup, asks for sudo, safe to repeat
  falcon-proxy setup --undo    removes the setup, keeps the link

The link is a secret and stays in ~/.config/falcon/proxy.url, never in the repo. Firewall rules need
privileges, so the setup adds a system service running as this user with only that capability, and a
polkit rule letting this user start and stop that one service without a password.
"""
import getpass
import json
import os
import subprocess
import sys
import tempfile
import time
from pathlib import Path
from urllib.parse import parse_qs, urlsplit

sys.dont_write_bytecode = True
from falcon_tr import tr

HOME = Path.home()
LINK = HOME / ".config/falcon/proxy.url"
SOURCE = Path(os.environ.get("FALCON_REPO", HOME / "Downloads/falcon")) / "proxy"
DAEMON = Path("/usr/local/libexec/falcon-proxyd")
SERVICE = "falcon-proxy.service"
UNIT = Path("/etc/systemd/system") / SERVICE
RULE = "/etc/polkit-1/rules.d/50-falcon-proxy.rules"
CHECK_URL = "https://www.gstatic.com/generate_204"

UNIT_TEXT = """[Unit]
Description=falcon proxy
After=network.target

[Service]
User={user}
ExecStart={daemon} run {link}
ExecStopPost=+-/usr/bin/nft destroy table inet falcon_proxy
Restart=on-failure
RestartSec=3
AmbientCapabilities=CAP_NET_ADMIN
CapabilityBoundingSet=CAP_NET_ADMIN
NoNewPrivileges=true
"""

RULE_TEXT = """// Written by falcon-proxy setup.
polkit.addRule(function(action, subject) {{
    if (action.id == "org.freedesktop.systemd1.manage-units"
            && action.lookup("unit") == "{service}"
            && ["start", "stop", "restart"].indexOf(action.lookup("verb")) >= 0
            && subject.user == "{user}") {{
        return polkit.Result.YES;
    }}
}});
"""


def check_link(link):
    """Raises ValueError for a link the proxy cannot use."""
    parts = urlsplit(link)
    query = {key: values[0] for key, values in parse_qs(parts.query).items()}
    if parts.scheme != "vless" or not parts.username or not parts.hostname or not parts.port:
        raise ValueError(tr("This is not a vless:// link."))
    if query.get("security") != "reality" or query.get("type", "tcp") != "tcp" or not query.get("pbk"):
        raise ValueError(tr("Only VLESS over TCP with Reality is supported."))


def write_private(path, text):
    path.parent.mkdir(parents=True, exist_ok=True)
    with tempfile.NamedTemporaryFile("w", dir=path.parent, delete=False) as out:
        out.write(text)
    os.chmod(out.name, 0o600)
    os.replace(out.name, path)


def read_link():
    try:
        return LINK.read_text().strip()
    except OSError:
        return ""


def systemctl(*args):
    return subprocess.run(["systemctl", "--no-ask-password", *args], capture_output=True, text=True, check=False)


def is_active():
    return systemctl("is-active", SERVICE).stdout.strip() == "active"


def status():
    return {"ready": UNIT.exists() and DAEMON.exists(), "link": bool(read_link()), "active": is_active()}


def fail(message):
    print(message, file=sys.stderr)
    return 1


def start():
    now = status()
    if not now["ready"]:
        return fail(tr("Run once in a terminal: falcon-proxy setup"))
    if not now["link"]:
        return fail(tr("No proxy link saved. Run: falcon-proxy set"))
    done = systemctl("restart" if now["active"] else "start", SERVICE)
    if done.returncode != 0:
        return fail(done.stderr.strip() or tr("The proxy service did not start."))
    return 0


def online():
    done = subprocess.run(["curl", "-s", "-o", "/dev/null", "--max-time", "4", "-w", "%{http_code}", CHECK_URL],
                          capture_output=True, text=True, check=False)
    return done.stdout.strip() == "204"


def turn_on():
    now = status()
    # Asked before the network changes at all, so a bad link interrupts nothing and names its reason.
    if now["ready"] and now["link"] and not now["active"]:
        asked = subprocess.run([str(DAEMON), "check", str(LINK)], capture_output=True, text=True, check=False)
        if asked.returncode != 0:
            return fail(tr(asked.stderr.strip() or "The proxy does not answer."))
    code = start()
    if code != 0:
        return code
    time.sleep(0.5)
    if any(online() for _ in range(3)):
        return 0
    systemctl("stop", SERVICE)
    return fail(tr("The proxy does not answer. The connection is direct again."))


def turn_off():
    done = systemctl("stop", SERVICE)
    return 0 if done.returncode == 0 else fail(done.stderr.strip())


def save_link(text):
    link = text.strip()
    check_link(link)
    write_private(LINK, link + "\n")
    if is_active():
        systemctl("restart", SERVICE)
    print(tr("Saved."))
    return 0


def sudo(*cmd):
    return subprocess.run(["sudo", *cmd], check=False).returncode == 0


def setup():
    user = getpass.getuser()
    with tempfile.TemporaryDirectory() as tmp:
        unit = Path(tmp) / "unit"
        rule = Path(tmp) / "rule"
        unit.write_text(UNIT_TEXT.format(user=user, daemon=DAEMON, link=LINK))
        rule.write_text(RULE_TEXT.format(service=SERVICE, user=user))
        target = Path(tmp) / "build"
        built = subprocess.run(["cargo", "build", "--release", "--offline", "--manifest-path", str(SOURCE / "Cargo.toml"), "--target-dir", str(target)], check=False)
        done = (built.returncode == 0
                and sudo("install", "-D", "-m", "755", str(target / "release/falcon-proxyd"), str(DAEMON))
                and sudo("install", "-m", "644", str(unit), str(UNIT))
                and sudo("install", "-m", "644", str(rule), RULE)
                and sudo("systemctl", "daemon-reload"))
    if done:
        print(tr("Done. The proxy can now be turned on in the control center."))
        return 0
    return fail(tr("Setup did not finish."))


def undo():
    sudo("systemctl", "stop", SERVICE)
    sudo("rm", "-f", str(UNIT), RULE, str(DAEMON))
    sudo("systemctl", "daemon-reload")
    print(tr("Removed."))
    return 0


def main(args):
    command = args[0] if args else ""
    if command == "set" and len(args) <= 2:
        return save_link(args[1] if len(args) == 2 else sys.stdin.read())
    if command == "on":
        return turn_on()
    if command == "start":
        return start()
    if command == "off":
        return turn_off()
    if command == "status":
        print(json.dumps(status()))
        return 0
    if command == "setup":
        return undo() if args[1:] == ["--undo"] else setup()
    print(__doc__.strip(), file=sys.stderr)
    return 2


try:
    sys.exit(main(sys.argv[1:]))
except ValueError as err:
    sys.exit(fail(str(err)))
