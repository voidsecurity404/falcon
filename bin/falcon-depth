#!/usr/bin/env python3
"""Depth: the wallpaper's subject is cut out and drawn over the widgets, so they sit behind it.

  falcon-depth status          prints {"installed": bool} as JSON
  falcon-depth install         makes the Python for it and downloads the model, about 400 MB
  falcon-depth cut IMAGE       prints {"path": cutout.png} or {"none": true}, cached by picture
  falcon-depth remove          deletes the Python, the model and the cut-outs

The model is BiRefNet General Lite (MIT, github.com/ZhengPeng7/BiRefNet), the ONNX export rembg
publishes, pinned by SHA-256. It runs on the CPU with onnxruntime in its own venv, at a low
priority on half the cores, about 25 s per picture, once: cut-outs are kept in
~/.cache/falcon/depth by the picture's path, size and time.
"""
import hashlib
import json
import os
import shutil
import subprocess
import sys
import urllib.request
from pathlib import Path

HOME = Path(os.environ.get("XDG_DATA_HOME") or Path.home() / ".local/share") / "falcon" / "depth"
VENV = HOME / "venv"
MODEL = HOME / "birefnet-general-lite.onnx"
MODEL_URL = "https://github.com/danielgatis/rembg/releases/download/v0.0.0/BiRefNet-general-bb_swin_v1_tiny-epoch_232.onnx"
MODEL_SHA = "5600024376f572a557870a5eb0afb1e5961636bef4e1e22132025467d0f03333"
PACKAGES = ["onnxruntime==1.31.1", "numpy==2.5.4", "pillow==13.0.0"]
CACHE = Path(os.environ.get("XDG_CACHE_HOME") or Path.home() / ".cache") / "falcon" / "depth"
# A subject smaller than this share of the picture is noise, a larger one is not a subject.
LEAST, MOST = 0.004, 0.6
KEEP = 60


def say(obj):
    print(json.dumps(obj), flush=True)


def installed():
    # Written last by install, so an interrupted one does not count.
    return (HOME / "ready").exists() and MODEL.exists()


def install():
    HOME.mkdir(parents=True, exist_ok=True)
    (HOME / "ready").unlink(missing_ok=True)
    if not (VENV / "bin" / "python").exists():
        say({"step": "python"})
        subprocess.run([sys.executable, "-m", "venv", str(VENV)], check=True)
    say({"step": "packages"})
    subprocess.run([str(VENV / "bin" / "python"), "-m", "pip", "install", "--quiet", "--disable-pip-version-check", *PACKAGES], check=True)
    if not MODEL.exists():
        say({"step": "model"})
        part = MODEL.with_suffix(".part")
        digest = hashlib.sha256()
        request = urllib.request.Request(MODEL_URL, headers={"User-Agent": "falcon-depth"})
        with urllib.request.urlopen(request, timeout=60) as answer, open(part, "wb") as out:
            total = int(answer.headers.get("Content-Length") or 0)
            done = 0
            while True:
                chunk = answer.read(1 << 20)
                if not chunk:
                    break
                out.write(chunk)
                digest.update(chunk)
                done += len(chunk)
                if total:
                    say({"step": "model", "progress": round(done / total, 3)})
        if digest.hexdigest() != MODEL_SHA:
            part.unlink(missing_ok=True)
            say({"error": "checksum"})
            return 1
        part.replace(MODEL)
    (HOME / "ready").write_text("")
    say({"installed": True})
    return 0


def key_of(image):
    stat = image.stat()
    return hashlib.sha1(f"{image.resolve()}\n{stat.st_size}\n{int(stat.st_mtime)}".encode()).hexdigest()


# Runs inside the venv: the model, then a soft alpha edge.
CUT = r'''
import json, os, sys
import numpy as np
from PIL import Image, ImageFilter
import onnxruntime as ort
model, source, target, least, most, threads = sys.argv[1:7]
options = ort.SessionOptions()
options.intra_op_num_threads = int(threads)
session = ort.InferenceSession(model, options, providers=["CPUExecutionProvider"])
picture = Image.open(source).convert("RGB")
name = session.get_inputs()[0].name
size = 1024
x = np.asarray(picture.resize((size, size), Image.BILINEAR), dtype=np.float32) / 255.0
x = (x - np.array([0.485, 0.456, 0.406], dtype=np.float32)) / np.array([0.229, 0.224, 0.225], dtype=np.float32)
x = x.transpose(2, 0, 1)[None].astype(np.float32)
m = session.run(None, {name: x})[0][0, 0]
m = 1.0 / (1.0 + np.exp(-m))
m = np.clip((m - 0.15) / 0.7, 0.0, 1.0)
share = float((m > 0.5).mean())
if not float(least) <= share <= float(most):
    print(json.dumps({"none": True, "share": round(share, 4)}))
    sys.exit(0)
# Kept at most 2560 wide: more than the screen with its parallax, and small as WebP.
if picture.size[0] > 2560:
    picture = picture.resize((2560, round(picture.size[1] * 2560 / picture.size[0])), Image.LANCZOS)
mask = Image.fromarray((m * 255).astype(np.uint8)).resize(picture.size, Image.BILINEAR)
# A pixel of softness, so the edge does not look cut with scissors.
mask = mask.filter(ImageFilter.GaussianBlur(max(1.0, picture.size[0] / 1920)))
picture.putalpha(mask)
tmp = target + ".tmp.webp"
picture.save(tmp, "WEBP", quality=90, alpha_quality=100, method=4)
os.replace(tmp, target)
print(json.dumps({"path": target, "share": round(share, 4)}))
'''


def cut(image_path):
    image = Path(image_path)
    if not installed():
        say({"error": "missing"})
        return 1
    if not image.is_file():
        say({"error": "file"})
        return 1
    CACHE.mkdir(parents=True, exist_ok=True)
    key = key_of(image)
    target = CACHE / f"{key}.webp"
    none = CACHE / f"{key}.none"
    if target.exists():
        os.utime(target)
        say({"path": str(target)})
        return 0
    if none.exists():
        say({"none": True})
        return 0
    threads = str(max(1, (os.cpu_count() or 2) // 2))
    run = subprocess.run(["nice", "-n", "15", str(VENV / "bin" / "python"), "-c", CUT, str(MODEL), str(image), str(target), str(LEAST), str(MOST), threads],
                         capture_output=True, text=True)
    if run.returncode != 0:
        print(run.stderr[-2000:], file=sys.stderr)
        say({"error": "failed"})
        return 1
    answer = json.loads(run.stdout.strip().splitlines()[-1])
    if answer.get("none"):
        none.write_text("")
    prune()
    say({"path": answer["path"]} if "path" in answer else {"none": True})
    return 0


def prune():
    files = sorted(CACHE.glob("*.webp"), key=lambda p: p.stat().st_mtime, reverse=True)
    for old in files[KEEP:]:
        old.unlink(missing_ok=True)


def remove():
    shutil.rmtree(HOME, ignore_errors=True)
    shutil.rmtree(CACHE, ignore_errors=True)
    say({"removed": True})
    return 0


def main():
    args = sys.argv[1:]
    command = args[0] if args else "status"
    if command == "status":
        say({"installed": installed()})
        return 0
    if command == "install":
        try:
            return install()
        except (OSError, subprocess.CalledProcessError) as error:
            print(error, file=sys.stderr)
            say({"error": "install"})
            return 1
    if command == "cut" and len(args) == 2:
        return cut(args[1])
    if command == "remove":
        return remove()
    print(__doc__.strip(), file=sys.stderr)
    return 2


if __name__ == "__main__":
    sys.exit(main())
