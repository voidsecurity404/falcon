#!/usr/bin/env bash
# App menu and search: niri-desk-rofi [drun|search|clipboard|window]. Pressing the key again closes it.
set -euo pipefail

mode="${1:-drun}"
if pkill -x rofi; then
    exit 0
fi
if ! command -v rofi >/dev/null; then
    case "$mode" in
        clipboard) exec qs -c niri-desk ipc call desk clipboard ;;
        *) exec qs -c niri-desk ipc call desk launcher ;;
    esac
fi

bin="$HOME/.local/bin"
tr() { "$bin/niri-desk-tr" "$1"; }
# Rofi shows a script mode under its own name, so the translated name is the mode name.
search="$(tr Search)"
clipboard="$(tr Clipboard)"
theme="${XDG_CONFIG_HOME:-$HOME/.config}/rofi/niri-desk.rasi"
if [[ "$mode" == clipboard ]]; then
    # Clipboard text needs a plain list, not tiles.
    exec rofi -show "$clipboard" -no-show-icons \
        -modes "$clipboard:$bin/niri-desk-rofi-search --clipboard" \
        -theme "$theme" \
        -theme-str "mainbox { children: [ inputbar, listview ]; } listview { columns: 1; lines: 8; fixed-height: false; dynamic: true; } element { orientation: horizontal; padding: 9px 12px; } element-text { horizontal-align: 0; } entry { placeholder: \"$clipboard\"; }"
fi
[[ "$mode" == search ]] && mode="$search"
exec rofi -show "$mode" \
    -modes "drun,$search:$bin/niri-desk-rofi-search,window" \
    -theme "$theme" \
    -display-drun "$(tr Apps)" \
    -display-window "$(tr Window)" \
    -theme-str "entry { placeholder: \"$search\"; }"
