#!/usr/bin/env bash
# Adds a name to /etc/hosts for a lab domain: niri-desk-hosts box.htb [IP]
# Without an IP the current target is used. The terminal asks for the password.
set -euo pipefail

name="${1:-}"
config="${XDG_CONFIG_HOME:-$HOME/.config}/niri-desk"
ip="${2:-$(jq -r '.lab.target // empty' "$config/settings.json" 2>/dev/null || true)}"
if ! [[ "$name" =~ ^[A-Za-z0-9]([A-Za-z0-9.-]*[A-Za-z0-9])?$ ]]; then
    echo "Invalid name: $name" >&2
    exit 2
fi
if ! [[ "$ip" =~ ^[0-9]{1,3}(\.[0-9]{1,3}){3}$ || "$ip" =~ ^[0-9A-Fa-f:]+:[0-9A-Fa-f:]*$ ]]; then
    echo "Invalid IP address: $ip" >&2
    exit 2
fi
if grep -Eq "^[^#]*[[:space:]]${name//./\\.}([[:space:]]|\$)" /etc/hosts; then
    echo "$name is already in /etc/hosts"
    exit 0
fi
printf '%s\t%s\n' "$ip" "$name" | sudo tee -a /etc/hosts >/dev/null
echo "Added: $ip $name"
