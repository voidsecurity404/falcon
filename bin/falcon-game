#!/usr/bin/env python3
"""Game mode, everything outside the shell. services/GameMode.qml decides what runs and calls this.

  falcon-game on [--keys-off] | off
                              niri's part: animations, window shadows and the hot corner go off.
                              With --keys-off niri also loads a copy of its config without any
                              key bind but the game mode shortcut, so every key reaches the game
  falcon-game status          prints on or off (exit 1 when off)
  falcon-game close [--dry-run] [--keep "a,b"]
                              asks every window that is not a game or a game launcher to close, then
                              ends the processes that stayed behind without a window (tray apps).
                              Nothing is killed by force: an app asking to save keeps its window.
                              Their places are saved first (falcon-session save --to).
  falcon-game reopen [--forget]
                              brings the closed windows back where they were, or drops that list
  falcon-game black on | off  the wallpaper: the live one's player ends and the screen behind the
                              windows is black; off brings the wallpaper back
  falcon-game services stop | start
                              background helpers that are not part of the session itself

Prints one JSON line for `close`: {"closed": [...], "kept": [...], "ended": [...]}.
"""

import json
import os
import re
import signal
import subprocess
import sys
import time

HOME = os.path.expanduser("~")
CONFIG = os.environ.get("XDG_CONFIG_HOME", HOME + "/.config")
STATE = os.environ.get("XDG_STATE_HOME", HOME + "/.local/state") + "/falcon"
KDL = CONFIG + "/niri/generated/game.kdl"
BLACK = STATE + "/game-black"
QUIET = STATE + "/game-services"
WINDOWS = STATE + "/game-windows.json"
# Holds the path of niri's usual config while the key-free copy is loaded.
KEYS = STATE + "/game-keys"
NIRI = CONFIG + "/niri"
BIN = HOME + "/.local/bin/"

# Blur stays on: without it the panels turn see-through and unreadable. A fullscreen game is drawn
# alone anyway. The hot corner goes, since a pointer thrown into it would open the overview mid-game.
KDL_TEXT = """// game
animations {
    off
}
layout {
    shadow {
        off
    }
}
gestures {
    hot-corners {
        off
    }
}
"""

# Games and what starts them, matched anywhere in a window's app id or a process name, without
# regard to case. A window of a process started by one of these stays too (a game under Steam).
KEEP = [
    r"^steam", r"steamwebhelper", r"steam_app_", r"lutris", r"heroic", r"gamescope", r"bottles",
    r"prismlauncher", r"minecraft", r"horizon", r"^wine", r"proton", r"retroarch", r"mangohud",
    r"^itch", r"legendary", r"\.exe$", r"dolphin-emu", r"pcsx2", r"rpcs3", r"ryujinx", r"yuzu",
]
# The session itself: never asked to close and never ended.
SESSION = [
    r"^org\.quickshell$", r"^qs$", r"^niri", r"xwayland", r"^falcon-", r"^systemd", r"^dbus",
    r"pipewire", r"wireplumber", r"^awww", r"^xdg-", r"^gvfs", r"^hypr",
]
CLOSE_WAIT = 5.0


def niri(*args):
    return subprocess.run(["niri", "msg", *args], capture_output=True, text=True, timeout=5).stdout


def niri_json(what):
    try:
        return json.loads(niri("-j", what))
    except (ValueError, subprocess.SubprocessError, OSError):
        return None


def reload_niri():
    try:
        niri("action", "load-config-file")
    except (subprocess.SubprocessError, OSError):
        pass


def niri_process():
    """(binary, config path) of the running niri: the fork is started with its own -c."""
    sock = os.path.basename(os.environ.get("NIRI_SOCKET", ""))
    found = re.search(r"\.(\d+)\.sock$", sock)
    binary, config = "niri", NIRI + "/config.kdl"
    if found:
        pid = found.group(1)
        try:
            binary = os.readlink(f"/proc/{pid}/exe")
            with open(f"/proc/{pid}/cmdline", "rb") as f:
                words = [w.decode() for w in f.read().split(b"\0") if w]
            for flag in ("-c", "--config"):
                if flag in words[:-1]:
                    config = words[words.index(flag) + 1]
        except (OSError, ValueError):
            pass
    return binary, config


def without_binds(text):
    """A config text with its top level `binds { }` blocks cut out, comments and strings respected."""
    out, i, depth, n = [], 0, 0, len(text)
    while i < n:
        c = text[i]
        if text.startswith("//", i):
            j = text.find("\n", i)
            j = n if j < 0 else j
            out.append(text[i:j])
            i = j
        elif text.startswith("/*", i):
            j = text.find("*/", i)
            j = n if j < 0 else j + 2
            out.append(text[i:j])
            i = j
        elif c == '"':
            j = i + 1
            while j < n and text[j] != '"':
                j += 2 if text[j] == "\\" else 1
            out.append(text[i:j + 1])
            i = j + 1
        elif depth == 0 and re.match(r"binds\s*\{", text[i:]) and (i == 0 or not (text[i - 1].isalnum() or text[i - 1] in "-_")):
            j = text.index("{", i) + 1
            level = 1
            while j < n and level:
                if text.startswith("//", j):
                    k = text.find("\n", j)
                    j = n if k < 0 else k
                    continue
                if text[j] == '"':
                    j += 1
                    while j < n and text[j] != '"':
                        j += 2 if text[j] == "\\" else 1
                elif text[j] == "{":
                    level += 1
                elif text[j] == "}":
                    level -= 1
                j += 1
            i = j
        else:
            depth += c == "{"
            depth -= c == "}"
            out.append(c)
            i += 1
    return "".join(out)


def keys_off(on):
    """Loads a copy of niri's config that has no key binds, or goes back to the usual one.

    niri cannot take a bind away in a later include, so the copy leaves the bind files out: each
    config file niri reads (config.kdl, and the fork's falcon-config.kdl around it) gets a twin in
    the same folder whose includes of bind files are dropped, and files that hold other things too
    (user.kdl, the fork's falcon.kdl) are included as copies with their `binds` blocks cut. The
    only bind in it is the game mode shortcut, taken from generated/binds.kdl."""
    binary, config = niri_process()
    if not on:
        try:
            with open(KEYS) as f:
                usual = f.read().strip()
            os.unlink(KEYS)
        except OSError:
            return False
        try:
            niri("action", "load-config-file", "--path", usual or config)
        except (subprocess.SubprocessError, OSError):
            pass
        return True
    drop = ("cfg/binds.kdl", "generated/binds.kdl")
    # sticky.kdl keeps its window rules; its copy is as old as this call, so a window made sticky
    # later simply slides along with its workspace.
    cut = {"cfg/user.kdl": "generated/game-user.kdl", "generated/falcon.kdl": "generated/game-falcon.kdl",
           "generated/sticky.kdl": "generated/game-sticky.kdl"}
    twins = {}

    def twin(path):
        if path in twins:
            return twins[path]
        folder = os.path.dirname(path)
        target = os.path.join(folder, "game-" + os.path.basename(path))
        twins[path] = target
        lines = []
        with open(path) as f:
            for line in f.read().split("\n"):
                found = re.match(r'\s*include\s+(?:optional=\w+\s+)?"([^"]+)"', line)
                name = found.group(1) if found else ""
                if name in drop:
                    continue
                if name in cut:
                    try:
                        with open(os.path.join(folder, name)) as f2:
                            write_atomic(os.path.join(folder, cut[name]), without_binds(f2.read()))
                        line = line.replace(f'"{name}"', f'"{cut[name]}"')
                    except OSError:
                        continue
                elif name and os.path.dirname(name) == "" and os.path.exists(os.path.join(folder, name)):
                    # Another top level file of the same kind (the fork's file includes config.kdl).
                    line = line.replace(f'"{name}"', f'"{os.path.basename(twin(os.path.join(folder, name)))}"')
                lines.append(line)
        write_atomic(target, "// Generated by falcon-game: this config without key binds.\n" + "\n".join(lines))
        return target

    try:
        target = twin(config)
        escape = ""
        with open(NIRI + "/generated/binds.kdl") as f:
            for line in f:
                if '"gameMode"' in line:
                    escape = line.rstrip()
        with open(target, "a") as f:
            f.write("\nbinds {\n" + (escape or '    Mod+G repeat=false { spawn "qs" "-c" "falcon" "ipc" "call" "desk" "gameMode"; }') + "\n}\n")
        check = subprocess.run([binary, "validate", "-c", target], capture_output=True, text=True, timeout=10)
        if check.returncode != 0:
            print("falcon-game: the key-free config is not valid, keys stay on:\n" + check.stderr[-600:], file=sys.stderr)
            return False
        os.makedirs(STATE, exist_ok=True)
        write_atomic(KEYS, config)
        niri("action", "load-config-file", "--path", target)
        return True
    except (OSError, ValueError, subprocess.SubprocessError) as error:
        print(f"falcon-game: keys stay on: {error!r}", file=sys.stderr)
        return False


def write_atomic(path, text):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    tmp = f"{path}.{os.getpid()}.tmp"
    with open(tmp, "w") as f:
        f.write(text)
    os.replace(tmp, path)


def is_on():
    try:
        with open(KDL) as f:
            return f.readline().startswith("// game")
    except OSError:
        return False


def matches(patterns, text):
    return any(re.search(p, text or "", re.IGNORECASE) for p in patterns)


def process(pid):
    """(name, parent pid) of a process, or ("", 0) when it is gone."""
    try:
        with open(f"/proc/{pid}/stat") as f:
            data = f.read()
        name = data[data.index("(") + 1:data.rindex(")")]
        return name, int(data[data.rindex(")") + 2:].split()[1])
    except (OSError, ValueError, IndexError):
        return "", 0


def family(pid):
    """Names of a process and of everything it was started by."""
    names = []
    seen = set()
    while pid > 1 and pid not in seen:
        seen.add(pid)
        name, parent = process(pid)
        if not name:
            break
        names.append(name)
        pid = parent
    return names


def keep_patterns(extra):
    words = [w.strip() for w in re.split(r"[,\s]+", extra or "") if w.strip()]
    return KEEP + [re.escape(w) for w in words]


def close(dry, extra):
    keep = keep_patterns(extra)
    windows = niri_json("windows") or []
    output = (niri_json("focused-output") or {}).get("logical") or {}
    full = (output.get("width", 0), output.get("height", 0))
    closing, kept = [], []
    for w in windows:
        app = w.get("app_id") or ""
        names = family(w.get("pid") or 0)
        size = tuple((w.get("layout") or {}).get("tile_size") or (0, 0))
        # A game already running fills the screen and has the focus.
        playing = bool(w.get("is_focused")) and full[0] > 0 and size[0] >= full[0] and size[1] >= full[1]
        if matches(SESSION, app) or matches(keep, app) or any(matches(keep, n) for n in names) or playing:
            kept.append(w)
        else:
            closing.append(w)
    report = {
        "closed": [w.get("app_id") or "" for w in closing],
        "kept": [w.get("app_id") or "" for w in kept],
        "ended": [],
    }
    if dry:
        print(json.dumps(report))
        return
    # Where every window is now, with the closing ones marked, so `reopen` can bring them back.
    if closing:
        quiet(BIN + "falcon-session", "save", "--to", WINDOWS, "--closing", ",".join(str(w["id"]) for w in closing))
    for w in closing:
        try:
            niri("action", "close-window", "--id", str(w["id"]))
        except (subprocess.SubprocessError, OSError, KeyError):
            pass
    # Their processes: one that stays without any window (it went to the tray) is asked to end.
    # One that still has a window is asking something, and is left alone.
    pids = {w.get("pid") for w in closing if w.get("pid")}
    deadline = time.monotonic() + CLOSE_WAIT
    left = {}
    while time.monotonic() < deadline:
        time.sleep(0.25)
        left = {}
        for w in niri_json("windows") or []:
            left.setdefault(w.get("pid"), []).append(w)
        if not any(process(pid)[0] for pid in pids):
            break
    me = set()
    pid = os.getpid()
    while pid > 1:
        me.add(pid)
        pid = process(pid)[1]
    for pid in pids:
        name = process(pid)[0]
        if not name or pid in left or pid in me:
            continue
        if matches(SESSION, name) or any(matches(keep, n) for n in family(pid)):
            continue
        try:
            os.kill(pid, signal.SIGTERM)
            report["ended"].append(name)
        except OSError:
            pass
    print(json.dumps(report))


def quiet(*command, wait=10):
    try:
        subprocess.run(command, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=wait)
    except (subprocess.SubprocessError, OSError):
        pass


def black(on):
    if on:
        os.makedirs(STATE, exist_ok=True)
        with open(BLACK, "w"):
            pass
        quiet("pkill", "-x", "mpvpaper")
        quiet("awww", "clear", "000000")
    elif os.path.exists(BLACK):
        os.unlink(BLACK)
        # Starts the daemon if it is gone, fades the picture in and plays a live one again.
        subprocess.Popen([BIN + "falcon-wallpaper", "--restore"], stdout=subprocess.DEVNULL,
                         stderr=subprocess.DEVNULL, start_new_session=True)


def services(stop):
    # The phone link: the shell ends its own helper, the daemon is bus activated and comes back
    # with it. The Telegram bot's service and its tunnel wait until the game is over, and are
    # started again only if this stopped them.
    if stop:
        os.makedirs(STATE, exist_ok=True)
        quiet("pkill", "-x", "kdeconnectd")
        if subprocess.run(["systemctl", "--user", "is-active", "--quiet", "falcon-remote.service"]).returncode == 0:
            with open(QUIET, "w"):
                pass
            quiet("systemctl", "--user", "stop", "falcon-remote.service")
    elif os.path.exists(QUIET):
        os.unlink(QUIET)
        quiet("systemctl", "--user", "start", "falcon-remote.service")


def main():
    args = sys.argv[1:]
    command = args[0] if args else "status"
    if command == "on":
        write_atomic(KDL, KDL_TEXT)
        # Loading the key-free copy reads game.kdl as well; without it a plain reload does.
        if not ("--keys-off" in args and keys_off(True)):
            keys_off(False)
            reload_niri()
    elif command == "off":
        changed = os.path.exists(KDL) and os.path.getsize(KDL) > 0
        if changed:
            write_atomic(KDL, "")
        if not keys_off(False) and changed:
            reload_niri()
    elif command == "status":
        print("on" if is_on() else "off")
        sys.exit(0 if is_on() else 1)
    elif command == "close":
        extra = args[args.index("--keep") + 1] if "--keep" in args and len(args) > args.index("--keep") + 1 else ""
        close("--dry-run" in args, extra)
    elif command == "reopen":
        # What `close` closed comes back to its place; --forget only drops the list.
        if "--forget" in args:
            try:
                os.unlink(WINDOWS)
            except OSError:
                pass
        elif os.path.exists(WINDOWS):
            quiet(BIN + "falcon-session", "restore", "--from", WINDOWS, wait=90)
    elif command == "black" and len(args) > 1 and args[1] in ("on", "off"):
        black(args[1] == "on")
    elif command == "services" and len(args) > 1 and args[1] in ("stop", "start"):
        services(args[1] == "stop")
    else:
        print(__doc__.strip().split("\n\n")[1], file=sys.stderr)
        sys.exit(2)


if __name__ == "__main__":
    main()
