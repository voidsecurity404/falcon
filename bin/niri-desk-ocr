#!/usr/bin/env bash
# Ekrandan soha tanlab, undagi matnni clipboard'ga oladi.
set -euo pipefail

_t() { "$HOME/.local/bin/niri-desk-tr" "$1"; }
tell() { qs -c niri-desk ipc call desk toast "$@" >/dev/null 2>&1 || true; }

region="$(slurp)" || exit 0
langs="$(tesseract --list-langs 2>/dev/null | tail -n +2 | grep -v '^osd$' | paste -sd+ -)" || langs=""
text="$(grim -g "$region" - | tesseract - - -l "${langs:-eng}" 2>/dev/null | sed -e '/^[[:space:]]*$/d')" || text=""

if [[ -z "$text" ]]; then
    tell "$(_t "No text found")" "$(_t "Try selecting another area")"
    exit 0
fi
printf '%s' "$text" | wl-copy
tell "$(_t "Text copied")" "$(head -n 1 <<<"$text")"
