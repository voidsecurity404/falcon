#!/usr/bin/env bash
# Ekranni yozishni yoqadi yoki o'chiradi. Avval soha tanlanadi, Esc bekor qiladi.
set -euo pipefail

pidfile="${XDG_RUNTIME_DIR:-/tmp}/niri-desk-record.pid"
videos="$(xdg-user-dir VIDEOS 2>/dev/null || echo "$HOME/Videos")"
_t() { "$HOME/.local/bin/niri-desk-tr" "$1"; }
tell() { qs -c niri-desk ipc call desk "$@" >/dev/null 2>&1 || true; }

if [[ -f "$pidfile" ]] && kill -0 "$(cat "$pidfile")" 2>/dev/null; then
    kill -INT "$(cat "$pidfile")"
    rm -f "$pidfile"
    tell recording false
    tell toast "$(_t "Video saved")" "$videos"
    exit 0
fi

region="$(slurp)" || exit 0
mkdir -p "$videos"
file="$videos/$(date +%Y-%m-%d_%H-%M-%S).mp4"
wf-recorder -g "$region" -f "$file" >/dev/null 2>&1 &
echo $! >"$pidfile"
tell recording true
