#!/usr/bin/env bash
# Puts text into the focused window. Without wtype, or when typing fails, it goes to the clipboard.
#   niri-desk-type TEXT
#   niri-desk-type -      reads the text from stdin
set -uo pipefail

if [[ "${1:-}" == "-" ]]; then
    text="$(cat)"
else
    text="${1:-}"
fi
[[ -n "$text" ]] || exit 0
# The panel that asked needs a moment to give the keyboard back to the window.
sleep "${NIRI_DESK_TYPE_DELAY:-0.28}"
if command -v wtype >/dev/null && printf '%s' "$text" | wtype - 2>/dev/null; then
    exit 0
fi
printf '%s' "$text" | wl-copy
qs -c niri-desk ipc call desk toast "$("$HOME/.local/bin/niri-desk-tr" "Copied")" "$("$HOME/.local/bin/niri-desk-tr" "Could not type it, paste with Ctrl+V")" >/dev/null 2>&1
exit 0
