#!/usr/bin/env bash
# Fon rasmi yoki jonli fonni o'rnatadi va ranglarni shundan oladi.
#   falcon-wallpaper FAYL       rasm yoki videoni fon qilish
#   falcon-wallpaper --restore  oxirgi fonni qaytarish (sessiya boshida)
#   falcon-wallpaper --colors RASM  faqat ranglarni yozish, rasm qo'ymasdan
#   falcon-wallpaper --thumbs           tanlagich uchun yetishmagan kichik rasmlarni yasash
#   falcon-wallpaper --reshow           put the current wallpaper on a display that just appeared
# FALCON_QUIET=1 leaves out the toast, for changes the user did not start.
set -euo pipefail

state="${XDG_STATE_HOME:-$HOME/.local/state}/falcon"
link="$state/wallpaper"
live_link="$state/wallpaper-live"
posters="$state/live-posters"
dir="$HOME/Pictures/Wallpapers"
mkdir -p "$state" "$posters"

colors() {
    "$HOME/.local/bin/falcon-apply" --colors "$1"
}

# awww-daemon is started by niri at login, but if it ever exits nothing brings it back, and
# every later change would fail without a word. So a missing daemon is started here.
wait_daemon() {
    awww query >/dev/null 2>&1 && return 0
    pgrep -x awww-daemon >/dev/null || setsid -f awww-daemon >>"$state/awww-daemon.log" 2>&1 </dev/null 9>&-
    for _ in $(seq 1 50); do
        if awww query >/dev/null 2>&1; then
            # Its new layer covers the shell's wallpaper copy and the widgets.
            qs -c falcon ipc call desk widgetsRestack >/dev/null 2>&1 || true
            return 0
        fi
        sleep 0.1
    done
    echo "awww-daemon did not respond" >&2
    toast "Wallpaper could not be set" "awww-daemon"
    return 1
}

# One change at a time, and only the newest waits: picking several wallpapers quickly must not
# leave two players running, or a video started late playing over the picture chosen after it.
take_turn() {
    local ticket="$state/.wallpaper-ticket"
    echo "$$" >"$ticket"
    exec 9>"$state/.wallpaper-lock"
    flock 9
    superseded && exit 0
    return 0
}

# A newer change is waiting for its turn.
superseded() {
    [[ "$(cat "$state/.wallpaper-ticket" 2>/dev/null)" != "$$" ]]
}

# Prints the wallpaper section of the settings as: type duration
transition() {
    python3 - <<'PY' 2>/dev/null || echo "grow 1"
import json, os
base = os.path.join(os.environ.get("XDG_CONFIG_HOME", os.path.expanduser("~/.config")), "falcon")
out = {"transition": "grow", "duration": 1}
for name in ("defaults.json", "settings.json"):
    try:
        out.update(json.load(open(os.path.join(base, name))).get("wallpaper", {}))
    except (OSError, ValueError):
        pass
# awww draws only its own kinds; the shell's parallax copy plays the others over it.
kind = out["transition"]
if kind not in ("grow", "fade", "wipe", "wave", "none"):
    kind = "fade"
print(kind, out["duration"])
PY
}

show() {
    wait_daemon
    read -r kind seconds < <(transition)
    awww img "$1" --transition-type "$kind" --transition-pos 0.5,1.0 --transition-duration "$seconds" --transition-fps 60
    # The shell draws its own sliding copy (parallax) and plays the same effect on it.
    qs -c falcon ipc call desk wallpaperShown "$1" "${2:-false}" >/dev/null 2>&1 || true
}

first_image() {
    find "$dir" -maxdepth 1 -type f \( -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.png' -o -iname '*.webp' \) | sort | head -n 1
}

is_video() {
    case "${1,,}" in
        *.mp4 | *.webm | *.mkv | *.mov) return 0 ;;
    esac
    return 1
}

# Videoning birinchi kadri: u rang manbai, qulf ekrani foni va tanlagichdagi rasm.
poster() {
    local name out
    name="$(basename "$1")"
    out="$posters/${name%.*}.jpg"
    [[ -s "$out" ]] || ffmpeg -v error -y -i "$1" -frames:v 1 -q:v 3 "$out" </dev/null >&2
    printf '%s\n' "$out"
}

stop_live() {
    pkill -x mpvpaper 2>/dev/null || true
}

# Ovozsiz, aylanib, ekranni to'ldirib o'ynaydi; ko'rinmaganda to'xtaydi.
# mpvpaper reads ~/.config/mpv, so uosc and the OSD are turned off here: otherwise the
# player's timeline and messages are drawn along the bottom of the wallpaper.
play() {
    setsid -f mpvpaper -p -o "no-audio loop panscan=1.0 hwdec=auto load-scripts=no osc=no osd-level=0 osd-bar=no" '*' "$1" >/dev/null 2>&1 9>&-
    # Video keyin ochilgani uchun vidjetlarni yopadi: ularni yana ustiga chiqaramiz.
    for _ in $(seq 1 50); do
        niri msg -j layers 2>/dev/null | grep -q '"mpvpaper"' && break
        sleep 0.1
    done
    # At login the player can be up before the shell answers, so it is asked again for a while.
    for _ in $(seq 1 40); do
        qs -c falcon ipc call desk widgetsRestack >/dev/null 2>&1 && break
        pgrep -x qs >/dev/null || break
        sleep 0.25
    done
}

# Vidjetlar yangi rasmning tinch joylariga ko'chadi.
arrange() {
    qs -c falcon ipc call desk widgetsArrange "$1" >/dev/null 2>&1 || true
}

toast() {
    [[ -n "${FALCON_QUIET:-}" ]] && return 0
    qs -c falcon ipc call desk toast "$("$HOME/.local/bin/falcon-tr" "$1")" "$2" >/dev/null 2>&1 || true
}

set_live() {
    local video="$1" image
    if ! command -v mpvpaper >/dev/null; then
        toast "Live wallpapers need mpvpaper" "sudo pacman -S mpvpaper"
        echo "mpvpaper is not installed" >&2
        exit 1
    fi
    image="$(poster "$video")"
    # Kadr ochilmasa joriy fon va ranglar o'zgarishsiz qoladi.
    stop_live
    show "$image" true
    colors "$image"
    ln -sfn "$image" "$link"
    ln -sfn "$video" "$live_link"
    # Avval kadrga o'tish tugasin, video xuddi shu kadrdan boshlanadi.
    sleep "$seconds"
    superseded && return 0
    play "$video"
    # The player's layer covers the widgets until they are opened above it again, so they move
    # to their new places only after that, in one piece.
    arrange "$image"
}

case "${1:-}" in
    --thumbs)
        # Kartaga moslab kesilgan kichik nusxalar: tanlagich ularni oldindan xotirada saqlaydi.
        mkdir -p "$state/thumbs"
        find "$dir" "$dir/Live" -maxdepth 1 -type f 2>/dev/null | while read -r file; do
            if is_video "$file"; then
                source="$(poster "$file")" || continue
            else
                case "${file,,}" in
                    *.jpg | *.jpeg | *.png | *.webp) source="$file" ;;
                    *) continue ;;
                esac
            fi
            out="$state/thumbs/$(basename "$file").jpg"
            [[ -s "$out" && "$out" -nt "$file" ]] && continue
            nice -n 10 ffmpeg -v error -y -i "$source" -vf "scale=530:620:force_original_aspect_ratio=increase,crop=530:620" -frames:v 1 -update 1 -q:v 3 "$out" </dev/null >&2 || rm -f "$out"
        done
        ;;
    --restore)
        take_turn
        video="$(readlink -f "$live_link" 2>/dev/null || true)"
        if [[ -f "$video" ]] && command -v mpvpaper >/dev/null; then
            image="$(poster "$video")"
            ln -sfn "$image" "$link"
            show "$image" true
            [[ -f "$state/colors.json" ]] || colors "$image"
            sleep "$seconds"
            play "$video"
            exit 0
        fi
        image="$(readlink -f "$link" 2>/dev/null || true)"
        [[ -f "$image" ]] || image="$(first_image)"
        [[ -n "$image" ]] || exit 0
        ln -sfn "$image" "$link"
        show "$image"
        [[ -f "$state/colors.json" ]] || colors "$image"
        ;;
    --reshow)
        take_turn
        image="$(readlink -f "$link" 2>/dev/null || true)"
        [[ -f "$image" ]] || exit 0
        wait_daemon
        awww img "$image" --transition-type none
        video="$(readlink -f "$live_link" 2>/dev/null || true)"
        if [[ -f "$video" ]] && command -v mpvpaper >/dev/null; then
            stop_live
            play "$video"
        fi
        ;;
    --colors)
        take_turn
        image="$(readlink -f "$2")"
        ln -sfn "$image" "$link"
        colors "$image"
        ;;
    "" | -h | --help)
        sed -n '2,8p' "$0" | cut -c3-
        ;;
    *)
        image="$(readlink -f "$1")"
        [[ -f "$image" ]] || { echo "File not found: $1" >&2; exit 1; }
        take_turn
        # The wallpaper already on: colors, widgets and everything else stay as they are.
        # A live one is set again only if its player has died.
        if is_video "$image"; then
            [[ "$(readlink -f "$live_link" 2>/dev/null || true)" == "$image" ]] && pgrep -x mpvpaper >/dev/null && exit 0
        else
            [[ ! -e "$live_link" && "$(readlink -f "$link" 2>/dev/null || true)" == "$image" ]] && exit 0
        fi
        if is_video "$image"; then
            set_live "$image"
        else
            # Rasm ochilmasa joriy fon va ranglar o'zgarishsiz qoladi.
            show "$image"
            arrange "$image"
            stop_live
            rm -f "$live_link"
            colors "$image"
            ln -sfn "$image" "$link"
        fi
        toast "Colors updated" "$(basename "${image%.*}")"
        ;;
esac
