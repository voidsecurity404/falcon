#!/usr/bin/env python3
"""Saves settings to a single file or restores them.

  falcon-backup export [FAYL]
  falcon-backup import FAYL
"""
import json
import os
import subprocess
import sys
import tarfile
import time
from pathlib import Path

HOME = Path.home()
CONFIG = Path(os.environ.get("XDG_CONFIG_HOME", HOME / ".config"))
ITEMS = ["falcon/settings.json", "falcon/widgets.json", "falcon/widget-layouts.json", "falcon/note.txt", "falcon/todo.json", "niri/cfg/user.kdl"]


def export(target):
    path = Path(target) if target else HOME / f"falcon-settings-{time.strftime('%Y%m%d-%H%M%S')}.tar.gz"
    with tarfile.open(path, "w:gz") as tar:
        for item in ITEMS:
            source = CONFIG / item
            if source.is_file():
                tar.add(source, arcname=item)
    print(path)
    return 0


def do_import(source):
    with tarfile.open(source, "r:gz") as tar:
        members = tar.getmembers()
        names = [m.name for m in members]
        foreign = [n for n in names if n not in ITEMS]
        if foreign or any(not m.isfile() for m in members):
            print(f"Invalid archive, foreign paths: {foreign[:3]}", file=sys.stderr)
            return 1
        for member in members:
            data = tar.extractfile(member).read()
            if member.name.endswith(".json"):
                json.loads(data or b"{}")
            dest = CONFIG / member.name
            dest.parent.mkdir(parents=True, exist_ok=True)
            tmp = dest.with_name(dest.name + ".tmp")
            tmp.write_bytes(data)
            os.replace(tmp, dest)
    subprocess.run([str(HOME / ".local/bin/falcon-apply")], check=False)
    print("Settings restored")
    return 0


args = sys.argv[1:]
try:
    if args[:1] == ["export"]:
        sys.exit(export(args[1] if len(args) > 1 else None))
    if args[:1] == ["import"] and len(args) == 2:
        sys.exit(do_import(args[1]))
except (OSError, ValueError, tarfile.TarError) as err:
    print(f"Failed: {err}", file=sys.stderr)
    sys.exit(1)
print(__doc__.strip(), file=sys.stderr)
sys.exit(2)
