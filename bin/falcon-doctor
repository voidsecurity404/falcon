#!/usr/bin/env python3
"""Checks the desktop and says what to do about each problem. It changes nothing.

Exit code 1 means something needs attention.
"""
import json
import os
import shutil
import subprocess
import sys
from pathlib import Path

sys.dont_write_bytecode = True
from falcon_tr import tr

HOME = Path.home()
CONFIG = Path(os.environ.get("XDG_CONFIG_HOME", HOME / ".config"))
STATE = Path(os.environ.get("XDG_STATE_HOME", HOME / ".local/state")) / "falcon"
COMMANDS = ["niri", "qs", "awww", "matugen", "hyprlock", "hypridle", "kitty", "cliphist", "wl-copy", "grim", "wf-recorder",
            "tesseract", "playerctl", "brightnessctl", "wlsunset", "fd", "mpvpaper", "ffmpeg", "qt6ct", "satty", "checkupdates", "pw-dump"]
PROCESSES = ["qs", "awww-daemon", "hypridle"]
problems = 0


def report(good, text, fix=""):
    global problems
    print(("  ok   " if good else "  FAIL ") + text)
    if not good:
        problems += 1
        if fix:
            print("         " + fix)


def quiet(*cmd):
    return subprocess.run(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, check=False).returncode == 0


print(tr("Programs"))
missing = [c for c in COMMANDS if not shutil.which(c)]
report(not missing, tr("Installed: {count} of {total}", count=len(COMMANDS) - len(missing), total=len(COMMANDS)),
       tr("Missing: {names}. Look them up in packages.txt.", names=", ".join(missing)))

print(tr("Running now"))
for name in PROCESSES:
    report(quiet("pgrep", "-x", name), name, tr("Not running. Log out and in, or start it by hand."))
report(quiet("pgrep", "-f", "wl-paste --watch"), tr("Clipboard history"), tr("New copies are not being saved."))

print(tr("Configuration"))
report(quiet("niri", "validate", "-c", str(CONFIG / "niri/config.kdl")), tr("niri config"), tr("Run: niri validate"))
report(quiet(str(HOME / ".local/bin/falcon-apply"), "--check"), tr("Settings"), tr("Run: falcon-apply --check"))
try:
    json.loads((STATE / "colors.json").read_text())
    report(True, tr("Wallpaper colors"))
except (OSError, ValueError):
    report(False, tr("Wallpaper colors"), tr("Choose a wallpaper again with Mod+W."))
report((STATE / "wallpaper").exists(), tr("Current wallpaper"), tr("Choose a wallpaper again with Mod+W."))
report(os.environ.get("QT_QPA_PLATFORMTHEME") == "qt6ct", tr("Qt theme in this session"), tr("Log out and in to apply it."))

try:
    charge = json.loads(subprocess.run([str(HOME / ".local/bin/falcon-charge"), "status"], capture_output=True, text=True, check=False).stdout)
    if charge["supported"]:
        report(charge["writable"], tr("Battery charge limit"), tr("Run once in a terminal: falcon-charge setup"))
except (OSError, ValueError, KeyError):
    pass

try:
    proxy = json.loads(subprocess.run([str(HOME / ".local/bin/falcon-proxy"), "status"], capture_output=True, text=True, check=False).stdout)
    if proxy["link"]:
        report(proxy["ready"], tr("Proxy"), tr("Run once in a terminal: falcon-proxy setup"))
except (OSError, ValueError, KeyError):
    pass

models = subprocess.run([str(HOME / ".local/bin/falcon-ocr-models"), "status"], capture_output=True, text=True, check=False).stdout.strip()
have, _, total = models.partition("/")
report(have == total and bool(total), tr("Reading models of the translator: {models}", models=models), tr("Run: falcon-ocr-models"))

parts = subprocess.run([str(HOME / ".local/bin/falcon-translate-models"), "status"], capture_output=True, text=True, check=False).stdout.strip()
have, _, total = parts.partition("/")
report(have == total and bool(total), tr("Offline translator: {parts}", parts=parts), tr("Run: falcon-translate-models"))

print(tr("Result: {count} problem(s)", count=problems))
sys.exit(1 if problems else 0)
