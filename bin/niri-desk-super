#!/usr/bin/env python3
"""Opens the app menu when Super is tapped alone. niri can only bind a key on press, so this watches
the keys itself. It only reads events: it never grabs a device, sends input or stores what it sees.
Needs read access to /dev/input, given by the input group."""
import fcntl
import glob
import os
import selectors
import subprocess
import sys

from evdev import InputDevice, ecodes as e

META = {e.KEY_LEFTMETA, e.KEY_RIGHTMETA}
WHEELS = {e.REL_WHEEL, e.REL_HWHEEL, e.REL_WHEEL_HI_RES, e.REL_HWHEEL_HI_RES}
# Holding Super this long means something else was intended.
LONGEST_TAP = 1.0


class Tap:
    """Super pressed and released, with nothing else pressed or scrolled in between."""

    def __init__(self):
        self.pressed_at = None

    def event(self, kind, code, value, when, others_down=False):
        if kind == e.EV_KEY and code in META:
            if value == 1:
                self.pressed_at = None if others_down else when
            elif value == 0:
                tapped = self.pressed_at is not None and when - self.pressed_at <= LONGEST_TAP
                self.pressed_at = None
                return tapped
        elif kind == e.EV_KEY and value == 1:
            self.pressed_at = None
        elif kind == e.EV_REL and code in WHEELS:
            self.pressed_at = None
        return False


def usable(device):
    caps = device.capabilities()
    return e.EV_KEY in caps or any(code in WHEELS for code in caps.get(e.EV_REL, []))


def keyboard_keys_down(devices):
    """Asks the devices, so a key whose release was missed during sleep cannot block taps."""
    down = set()
    for device in devices:
        try:
            down.update(code for code in device.active_keys() if code < e.BTN_MISC)
        except OSError:
            pass
    return bool(down - META)


def locked():
    return subprocess.run(["pgrep", "-u", str(os.getuid()), "-x", "hyprlock"], stdout=subprocess.DEVNULL).returncode == 0


def main():
    # A second copy would close the menu that the first one has just opened.
    lock = open(os.path.join(os.environ.get("XDG_RUNTIME_DIR", "/tmp"), "niri-desk-super.lock"), "w")
    try:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        return 0

    selector = selectors.DefaultSelector()
    devices = {}
    tap = Tap()
    refused = False

    def scan():
        nonlocal refused
        for path in glob.glob("/dev/input/event*"):
            if path in devices:
                continue
            try:
                device = InputDevice(path)
            except PermissionError:
                refused = True
                continue
            except OSError:
                continue
            if usable(device):
                devices[path] = device
                selector.register(device, selectors.EVENT_READ, path)
            else:
                device.close()

    def forget(path):
        device = devices.pop(path)
        selector.unregister(device)
        device.close()

    scan()
    if not devices and refused:
        print("niri-desk-super: no access to /dev/input, join the input group", file=sys.stderr)
        return 1

    while True:
        ready = selector.select(timeout=3)
        if not ready:
            scan()  # picks up keyboards and mice plugged in later
        for key, _ in ready:
            try:
                events = list(key.fileobj.read())
            except OSError:
                forget(key.data)
                continue
            for ev in events:
                others = ev.type == e.EV_KEY and ev.code in META and ev.value == 1 and keyboard_keys_down(devices.values())
                if tap.event(ev.type, ev.code, ev.value, ev.timestamp(), others) and not locked():
                    subprocess.Popen(["qs", "-c", "niri-desk", "ipc", "call", "desk", "menu"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


if __name__ == "__main__":
    sys.exit(main())
