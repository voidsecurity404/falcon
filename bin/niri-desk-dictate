#!/usr/bin/env bash
# Dictation on this computer: nothing leaves it.
#   niri-desk-dictate          starts listening, or stops and types what was said
#   niri-desk-dictate cancel   stops without typing
#   niri-desk-dictate setup    downloads the speech model
#   niri-desk-dictate status   prints the state as JSON
#   niri-desk-dictate file WAV prints the text of a recording
set -uo pipefail

run="${XDG_RUNTIME_DIR:-/tmp}/niri-desk-dictate"
models="${XDG_DATA_HOME:-$HOME/.local/share}/niri-desk/whisper"
config="${XDG_CONFIG_HOME:-$HOME/.config}/niri-desk"
maxSeconds=300

tr_() { "$HOME/.local/bin/niri-desk-tr" "$1"; }
desk() { qs -c niri-desk ipc call desk "$@" >/dev/null 2>&1; }
setting() {
    python3 - "$1" "$2" "$config" <<'PY'
import json, sys
key, value, folder = sys.argv[1:]
for name in ("defaults.json", "settings.json"):
    try:
        value = json.load(open(f"{folder}/{name}")).get("dictation", {}).get(key, value)
    except (OSError, ValueError):
        pass
print(value)
PY
}
model_name() {
    local name
    name="$(setting model base)"
    case "$name" in tiny | base | small | medium) echo "$name" ;; *) echo base ;; esac
}
model_path() { echo "$models/ggml-$(model_name).bin"; }
recording() { [[ -f "$run/pid" ]] && kill -0 "$(cat "$run/pid")" 2>/dev/null; }

transcribe() {
    local language threads
    language="$(setting language auto)"
    [[ "$language" =~ ^[a-z]{2,4}$ ]] || language=auto
    threads="$(($(nproc) / 2))"
    ((threads > 0)) || threads=1
    # A crash can print to stdout, and that must never be typed into a window.
    local raw
    raw="$(whisper-cli --model "$(model_path)" --file "$1" --language "$language" --threads "$threads" --no-timestamps --no-prints 2>/dev/null)" || return 1
    # Whisper marks silence and sounds in brackets, and those are not speech.
    printf '%s\n' "$raw" | sed -E 's/\[[^]]*\]//g; s/\([^)]*(музыка|music|silence|тишина)[^)]*\)//Ig; s/^[[:space:]]+//; s/[[:space:]]+$//' | sed '/^$/d' | paste -sd ' '
}

start() {
    if ! command -v whisper-cli >/dev/null || ! command -v pw-record >/dev/null; then
        desk toast "$(tr_ "Dictation is not installed")" "niri-desk-extras setup"
        return 0
    fi
    if [[ ! -s "$(model_path)" ]]; then
        kitty --title "niri-desk dictation setup" env "PATH=$HOME/.local/bin:$PATH" sh -c 'niri-desk-dictate setup; printf "\n%s " "$(niri-desk-tr "Press Enter to close.")"; read _' >/dev/null 2>&1 &
        disown
        return 0
    fi
    mkdir -p -m 700 "$run"
    rm -f "$run/voice.wav"
    pw-record --rate 16000 --channels 1 --format s16 "$run/voice.wav" >/dev/null 2>&1 &
    local pid=$!
    echo "$pid" >"$run/pid"
    disown
    desk dictating true
    # A forgotten recording must not run for ever.
    (sleep "$maxSeconds"; [[ "$(cat "$run/pid" 2>/dev/null)" == "$pid" ]] && "$0") >/dev/null 2>&1 &
    disown
}

stop() {
    local pid text
    pid="$(cat "$run/pid")"
    rm -f "$run/pid"
    # pw-record finishes the file on TERM. A job started with & ignores INT.
    kill -TERM "$pid" 2>/dev/null
    for _ in {1..60}; do
        kill -0 "$pid" 2>/dev/null || break
        sleep 0.05
    done
    kill -KILL "$pid" 2>/dev/null
    desk dictating false
    if [[ "${1:-}" == cancel ]]; then
        rm -f "$run/voice.wav"
        return 0
    fi
    desk transcribing true
    if ! text="$(transcribe "$run/voice.wav")"; then
        rm -f "$run/voice.wav"
        desk transcribing false
        desk toast "$(tr_ "Dictation failed")" "whisper-cli"
        return 0
    fi
    rm -f "$run/voice.wav"
    desk transcribing false
    if [[ -z "$text" ]]; then
        desk toast "$(tr_ "No speech was heard")" ""
        return 0
    fi
    printf '%s' "$text" | NIRI_DESK_TYPE_DELAY=0.05 "$HOME/.local/bin/niri-desk-type" -
}

case "${1:-toggle}" in
toggle)
    # A second press while it works must not start a new recording.
    exec 9>"${XDG_RUNTIME_DIR:-/tmp}/niri-desk-dictate.lock"
    flock -n 9 || exit 0
    if recording; then stop; else rm -f "$run/pid"; flock -u 9; exec 9>&-; start; fi
    ;;
cancel)
    recording && stop cancel
    ;;
setup)
    name="$(model_name)"
    mkdir -p "$models"
    target="$models/ggml-$name.bin"
    echo "$(tr_ "Downloading the speech model"): $name"
    curl --fail --location --progress-bar --continue-at - --retry 3 --output "$target.part" "https://huggingface.co/ggerganov/whisper.cpp/resolve/main/ggml-$name.bin" || exit 1
    mv "$target.part" "$target"
    echo "$(tr_ "Ready")"
    ;;
status)
    has=false
    [[ -s "$(model_path)" ]] && has=true
    command -v whisper-cli >/dev/null && installed=true || installed=false
    recording && rec=true || rec=false
    printf '{"installed":%s,"model":%s,"recording":%s,"name":"%s"}\n' "$installed" "$has" "$rec" "$(model_name)"
    ;;
file)
    transcribe "$2"
    ;;
*)
    sed -n '2,7p' "$0" | cut -c3- >&2
    exit 2
    ;;
esac
