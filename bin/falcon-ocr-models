#!/usr/bin/env python3
"""Downloads the text readers of the picture translator and checks them. It needs no root and is safe
to run again.

The main reader is PaddleOCR (PP-OCRv6, through RapidOCR and onnxruntime) in its own Python, about
400 MB with its packages, far surer than Tesseract on screen text and on Chinese, Japanese, Korean
and Arabic. Tesseract's models, one per script, about 200 MB, find out the script of a picture and
read the scripts PaddleOCR does not know.

  falcon-ocr-models           downloads what is missing
  falcon-ocr-models status    says how many are there
"""
import fcntl
import hashlib
import os
import shutil
import subprocess
import sys
import urllib.request
from pathlib import Path

# tessdata_fast of the Tesseract project, Apache-2.0. One commit, so the checksums below stay right.
COMMIT = "87416418657359cb625c412a48b6e1d6d41c29bd"
BASE = f"https://raw.githubusercontent.com/tesseract-ocr/tessdata_fast/{COMMIT}/script/"
FOLDER = Path(os.environ.get("XDG_DATA_HOME", Path.home() / ".local/share")) / "falcon/tessdata"
MODELS = {
    "Arabic": "47c262ac4e843c024df87ffa1363b77a821a843c069c71ef7650f4d2ecfea1e8",
    "Armenian": "e94e3cfcb79dc6bc24b819ce01340b690f2aabe4c5ac295545ae1bca5d7472f4",
    "Bengali": "d04c2064bd0ffcd18488c4048d40d88ab056185f3462c2337b52f9e6c51158e5",
    "Cyrillic": "a80325ebb1c7aa2dca5002ec05b15052a51dcb2e9e65373c264a3df7ac284358",
    "Devanagari": "3bbb87c1de2a6a2ef0a97dc041e6eea2723a1c22d638f5e38157a5cd441c12b7",
    "Georgian": "8da5cc7e2af2c8da04d126ab1f2604904305e548bc3fc20d3c0bae6d519ca013",
    "Greek": "52e201e4a22336d89ee202b579aca04f15ffd6e5e6af1fe164498f2c7de898e6",
    "Hangul": "cae2d12b8cdac6b62643b65915bec347e80970adc55228ca42ac1ec8909b198a",
    "HanS": "d03c250faaa48015bfde2213f3d7d5bda82bcee93422fceac5906a32073d9152",
    "HanT": "29588327f0d830b5c112209045d826b9be014138266b20f2b08843aac2730fbb",
    "Hebrew": "4f4f3405404a61e21e5c16316ed5c3052ddb3572a75e0b3dc3fe118b12dea76e",
    "Japanese": "c176cdca0c17e9be97bda854ac91baea90b92e2813b45749ad05e409477ba8b2",
    "Latin": "6dbdaf8ecc6c40f025c2648bf3b3f3fbffe073e1fd2df2047fde2e2b2f020d53",
    "Tamil": "6857e222c6977986915bd073f669c2cde33039dedde26603ed6be87b0a8d62bb",
    "Thai": "d9e34be94556ddb65fd7e04892ff606e1a5b696d0eb422b5a7efc6859943702d",
}

OCR = FOLDER.parent / "ocr"
PACKAGES = ["rapidocr==3.10.0", "onnxruntime==1.31.1", "opencv-python-headless==5.0.0.93", "python-bidi==0.6.12"]
PADDLE_BASE = "https://www.modelscope.cn/models/RapidAI/RapidOCR/resolve/v3.10.0/onnx/"
# File name here: (path under PADDLE_BASE, SHA-256). Apache-2.0, from RapidOCR's own list.
PADDLE = {
    "det.onnx": ("PP-OCRv6/det/PP-OCRv6_det_small.onnx", "090f04abcd9d9a7498bc4ebf677e4cb9bdce1fe4197ddb7e529f1ef44e1ff94f"),
    # Latin languages, Chinese and Japanese in one.
    "rec-multi.onnx": ("PP-OCRv6/rec/PP-OCRv6_rec_small.onnx", "6f327246b50388f3c176ae304bd95767ea6dc0c9ae92153ef8cbe210b3c14884"),
    "rec-cyrillic.onnx": ("PP-OCRv5/rec/cyrillic_PP-OCRv5_rec_mobile.onnx", "90f761b4bfcce0c8c561c0cb5c887b0971d3ec01c32164bdf7374a35b0982711"),
    "rec-korean.onnx": ("PP-OCRv5/rec/korean_PP-OCRv5_rec_mobile.onnx", "cd6e2ea50f6943ca7271eb8c56a877a5a90720b7047fe9c41a2e541a25773c9b"),
    "rec-arabic.onnx": ("PP-OCRv5/rec/arabic_PP-OCRv5_rec_mobile.onnx", "c1192e632d0baa9146ae5b756a0e635e3dc63c1733737ebfd1629e87144e9295"),
    "rec-devanagari.onnx": ("PP-OCRv5/rec/devanagari_PP-OCRv5_rec_mobile.onnx", "d6f0a906580e3fa6b324a318718f1f31f268b6ea8ef985f91c2012a37f52c91e"),
    "rec-el.onnx": ("PP-OCRv5/rec/el_PP-OCRv5_rec_mobile.onnx", "b4368bccd557123c702b7549fee6cd1e94b581337d1c9b65310f109131542b7f"),
    "rec-th.onnx": ("PP-OCRv5/rec/th_PP-OCRv5_rec_mobile.onnx", "de541dd83161c241ff426f7ecfd602a0ba77d686cf3ab9a6c255ea82fd08006e"),
    "rec-ta.onnx": ("PP-OCRv5/rec/ta_PP-OCRv5_rec_mobile.onnx", "a42448808b7dea87597336f12438935f40353f1949e8360acd9e06b4da21bfe1"),
}


def paddle_engine_ready():
    python = OCR / "venv/bin/python"
    return python.exists() and subprocess.run([str(python), "-c", "import rapidocr, onnxruntime, bidi"], capture_output=True).returncode == 0


def paddle_present():
    return [name for name in PADDLE if (OCR / "models" / name).exists()]


def fetch_paddle(name):
    path, wanted = PADDLE[name]
    target = OCR / "models" / name
    partial = target.with_suffix(".part")
    request = urllib.request.Request(PADDLE_BASE + path, headers={"User-Agent": "Mozilla/5.0"})
    with urllib.request.urlopen(request, timeout=120) as answer, open(partial, "wb") as out:
        while piece := answer.read(1 << 20):
            out.write(piece)
    if digest(partial) != wanted:
        partial.unlink()
        raise OSError(f"{name}: checksum does not match")
    partial.replace(target)


def digest(path):
    hashed = hashlib.sha256()
    with open(path, "rb") as handle:
        for piece in iter(lambda: handle.read(1 << 20), b""):
            hashed.update(piece)
    return hashed.hexdigest()


def present():
    return [name for name in MODELS if (FOLDER / f"{name}.traineddata").exists()]


def fetch(name):
    target = FOLDER / f"{name}.traineddata"
    partial = target.with_suffix(".part")
    with urllib.request.urlopen(BASE + target.name, timeout=60) as answer, open(partial, "wb") as out:
        while piece := answer.read(1 << 20):
            out.write(piece)
    if digest(partial) != MODELS[name]:
        partial.unlink()
        raise OSError(f"{name}: checksum does not match")
    partial.replace(target)


def main(argv):
    if argv[1:] == ["status"]:
        done = len(present()) + len(paddle_present()) + paddle_engine_ready()
        print(f"{done}/{len(MODELS) + len(PADDLE) + 1}")
        return 0
    FOLDER.mkdir(parents=True, exist_ok=True)
    with open(FOLDER / ".lock", "w") as lock:
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except OSError:
            return 0
        failed = 0
        for name in MODELS:
            if name in present():
                continue
            print(name, flush=True)
            try:
                fetch(name)
            except OSError as error:
                print(error, file=sys.stderr)
                failed += 1
        (OCR / "models").mkdir(parents=True, exist_ok=True)
        if not paddle_engine_ready():
            print("engine", flush=True)
            try:
                shutil.rmtree(OCR / "venv", ignore_errors=True)
                subprocess.run([sys.executable, "-m", "venv", str(OCR / "venv")], check=True)
                subprocess.run([str(OCR / "venv/bin/pip"), "install", "--quiet", "--disable-pip-version-check", *PACKAGES], check=True)
            except (OSError, subprocess.CalledProcessError) as error:
                print(f"engine: {error}", file=sys.stderr)
                failed += 1
        for name in PADDLE:
            if name in paddle_present():
                continue
            print(name, flush=True)
            try:
                fetch_paddle(name)
            except OSError as error:
                print(error, file=sys.stderr)
                failed += 1
    return 1 if failed else 0


sys.exit(main(sys.argv))
