#!/usr/bin/env python3
"""Finds a tidy place for the desktop widgets on a wallpaper, away from what the picture shows.

niri-desk-widgets-place IMAGE WIDTH HEIGHT TOP BOTTOM WIDGETS

WIDGETS is JSON: [{"id", "w", "h", "x", "y", "bare"}], sizes and current places in screen pixels,
bare when the widget has no glass plate. Prints {"id": {"x", "y"}}.
TOP and BOTTOM are the strips of the screen kept free for the panel.
"""
import json
import random
import subprocess
import sys

import numpy as np

CELL = 8  # one cell of the busy map, in screen pixels
SIDE = 16  # WidgetHost keeps this much free at the left and right
MARGIN = 32  # distance from the free area's edge
GAP = 16
TRIES = 6000
UNTIDY = 0.35  # how much a jagged layout costs next to covering the picture
MIN_MOVE = 160  # the mean distance widgets must travel, so every new wallpaper gives a new layout


def blur(a, radius):
    """Three box blurs are close to a gaussian."""
    size = 2 * radius + 1
    for axis in (0, 1):
        for _ in range(3):
            pad = [(0, 0)] * a.ndim
            pad[axis] = (radius + 1, radius)
            total = np.cumsum(np.pad(a, pad, mode="edge"), axis=axis)
            a = (np.take(total, range(size, total.shape[axis]), axis) - np.take(total, range(total.shape[axis] - size), axis)) / size
    return a


def picture(path, width, height):
    """The image as it fills the screen (cropped, like awww and mpvpaper), one pixel per cell."""
    w, h = width // CELL, height // CELL
    scale = f"scale={w}:{h}:force_original_aspect_ratio=increase:flags=area,crop={w}:{h}"
    raw = subprocess.run(
        ["ffmpeg", "-v", "error", "-i", path, "-vf", scale, "-frames:v", "1", "-f", "rawvideo", "-pix_fmt", "rgb24", "-"],
        stdin=subprocess.DEVNULL, capture_output=True, check=True,
    ).stdout
    return np.frombuffer(raw, np.uint8).reshape(h, w, 3).astype(np.float64) / 255


def busy_map(rgb):
    """0 where a widget can sit calmly, 1 where the picture has something to look at."""
    light = rgb.mean(axis=2)
    opponent = np.stack([light, (rgb[..., 0] - rgb[..., 1]) * 1.2, ((rgb[..., 0] + rgb[..., 1]) / 2 - rgb[..., 2]) * 1.2], axis=2)
    # Fine detail: edges and texture. Objects: what differs from its surroundings.
    fine = np.hypot(np.gradient(light, axis=0), np.gradient(light, axis=1))
    fine = blur(fine, 2)
    objects = sum(np.abs(blur(opponent, small) - blur(opponent, large)).sum(axis=2) for small, large in ((1, 6), (3, 14), (6, 30)))
    # What is rare in the whole picture, such as a lit tower on a dark sky.
    rare = np.abs(blur(opponent, 2) - np.median(opponent, axis=(0, 1))).sum(axis=2)

    def unit(a):
        # The power lifts faint subjects, such as a pale mountain beside loud red leaves.
        return np.clip(a / max(np.percentile(a, 98), 1e-6), 0, 1) ** 0.6

    # Pictures are usually composed around the middle, even where it looks calm.
    h, w = light.shape
    across = (np.arange(w) - (w - 1) / 2) / (w / 2)
    down = (np.arange(h) - (h - 1) / 2) / (h / 2)
    middle = np.exp(-(across[None, :] ** 2 / 0.35 + down[:, None] ** 2 / 0.5))
    return blur(unit(fine) * 0.4 + unit(objects) * 0.4 + unit(rare) * 0.1 + middle * 0.25, 1)


class Scene:
    def __init__(self, busy, light, width, top, bottom):
        self.left, self.right = SIDE + MARGIN, width - SIDE - MARGIN
        self.top, self.bottom = top + MARGIN, bottom - MARGIN
        self.table = np.pad(busy.cumsum(0).cumsum(1), ((1, 0), (1, 0)))
        self.light = np.pad(light.cumsum(0).cumsum(1), ((1, 0), (1, 0)))
        self.hot = np.pad((busy > np.percentile(busy, 85)).astype(np.float64).cumsum(0).cumsum(1), ((1, 0), (1, 0)))

    def mean(self, table, x, y, w, h):
        rows, cols = table.shape
        x0, x1 = np.clip([int(x / CELL), int((x + w) / CELL)], 0, cols - 1)
        y0, y1 = np.clip([int(y / CELL), int((y + h) / CELL)], 0, rows - 1)
        if x1 <= x0 or y1 <= y0:
            return 1.0
        total = table[y1, x1] - table[y0, x1] - table[y1, x0] + table[y0, x0]
        return total / ((x1 - x0) * (y1 - y0))

    def cost(self, placed):
        """Lower is better. A widget over the subject counts for more than its area."""
        each = []
        area = 0
        total = 0
        for w, x, y in placed:
            size = w["w"] * w["h"]
            value = self.mean(self.table, x, y, w["w"], w["h"]) + self.mean(self.hot, x, y, w["w"], w["h"]) * 1.2
            # A widget without a plate is white text: it needs a calm, dark enough background.
            if w.get("bare"):
                value = value * 1.25 + max(0, self.mean(self.light, x, y, w["w"], w["h"]) - 0.45) * 3
            each.append(value)
            area += size
            total += value * size
        return total / area + max(each) * 0.35 + (1 - alignment(placed)) * UNTIDY


def alignment(placed):
    """The share of widget edges that line up with an edge of another widget."""
    edges = [(w, (x, x + w["w"]), (y, y + w["h"])) for w, x, y in placed]
    if len(edges) < 2:
        return 1
    hits = 0
    for me, xs, ys in edges:
        others = [e for e in edges if e[0] is not me]
        hits += sum(any(abs(v - o) <= 1 for e in others for o in e[1]) for v in xs)
        hits += sum(any(abs(v - o) <= 1 for e in others for o in e[2]) for v in ys)
    return hits / (4 * len(edges))


def stack(group, axis_size, axis_start, cross, along, align_end):
    """Places a group in one line. `along` is 'y' for a column, 'x' for a row."""
    key = "h" if along == "y" else "w"
    length = sum(w[key] for w in group) + GAP * (len(group) - 1)
    if length > axis_size:
        return None
    start = {0: axis_start, 1: axis_start + (axis_size - length) / 2, 2: axis_start + axis_size - length}[align_end]
    out = []
    for w in group:
        out.append((w, start, cross(w)))
        start += w[key] + GAP
    return out


def column(scene, group, side, align):
    def cross(w):
        return scene.left if side == 0 else scene.right - w["w"]

    placed = stack(group, scene.bottom - scene.top, scene.top, cross, "y", align)
    return placed and [(w, x, y) for w, y, x in placed]


def row(scene, group, side, align):
    def cross(w):
        return scene.top if side == 0 else scene.bottom - w["h"]

    return stack(group, scene.right - scene.left, scene.left, cross, "x", align)


def cluster(scene, group, side, align):
    """Two columns side by side, in one part of the screen."""
    cut = random.randint(1, len(group) - 1)
    first, second = group[:cut], group[cut:]
    outer = max(w["w"] for w in first)
    a = column(scene, first, side, align)
    b = column(scene, second, side, align)
    if not a or not b:
        return None
    shift = (outer + GAP) * (1 if side == 0 else -1)
    return a + [(w, x + shift, y) for w, x, y in b]


def candidate(scene, widgets):
    """One random tidy composition: a column, a row, a cluster, or a pair of them on opposite sides."""
    group = widgets[:]
    random.shuffle(group)
    kind = random.choice(("column", "row", "cluster", "columns", "rows", "corner"))
    side = random.randint(0, 1)
    if kind == "column":
        return column(scene, group, side, 1)
    if kind == "row":
        return row(scene, group, side, 1)
    if len(group) < 2:
        return None
    if kind == "cluster":
        return cluster(scene, group, side, random.randint(0, 2))
    cut = random.randint(1, len(group) - 1)
    one, two = group[:cut], group[cut:]
    if kind == "columns":
        # Facing columns, level with each other or on a diagonal.
        align = random.randint(0, 2)
        other = random.choice((align, 2 - align))
        a, b = column(scene, one, 0, align), column(scene, two, 1, other)
    elif kind == "rows":
        a, b = row(scene, one, 0, random.choice((0, 1, 2))), row(scene, two, 1, random.choice((0, 1, 2)))
    else:
        # A column on one side and a row along the far edge, meeting in a corner.
        a = column(scene, one, side, 0)
        if not a:
            return None
        used = max(w["w"] for w in one) + GAP
        b = row(scene, two, 1, 2 if side == 0 else 0)
        if not b:
            return None
        if side == 0 and min(x for _, x, _ in b) < scene.left + used:
            return None
        if side == 1 and max(x + w["w"] for w, x, _ in b) > scene.right - used:
            return None
        if bottom_of(a) > min(y for _, _, y in b) - GAP:
            return None
    return a and b and a + b


def bottom_of(placed):
    return max(y + w["h"] for w, _, y in placed)


def fits(scene, placed):
    for w, x, y in placed:
        if x < scene.left - 1 or x + w["w"] > scene.right + 1 or y < scene.top - 1 or y + w["h"] > scene.bottom + 1:
            return False
    for i, (a, ax, ay) in enumerate(placed):
        for b, bx, by in placed[i + 1:]:
            if ax < bx + b["w"] and bx < ax + a["w"] and ay < by + b["h"] and by < ay + a["h"]:
                return False
    return True


def moved(placed):
    return sum(np.hypot(x - w["x"], y - w["y"]) for w, x, y in placed) / len(placed)


def place(path, width, height, top, bottom, widgets):
    rgb = picture(path, width, height)
    scene = Scene(busy_map(rgb), rgb.mean(axis=2), width, top, height - bottom)
    random.seed(path)
    best = None
    best_cost = float("inf")
    fallback = None
    fallback_cost = float("inf")
    for _ in range(TRIES):
        placed = candidate(scene, widgets)
        if not placed or not fits(scene, placed):
            continue
        placed = [(w, round(x), round(y)) for w, x, y in placed]
        cost = scene.cost(placed)
        if cost < fallback_cost:
            fallback, fallback_cost = placed, cost
        if cost < best_cost and moved(placed) >= MIN_MOVE:
            best, best_cost = placed, cost
    chosen = best or fallback
    if not chosen:
        return {}
    return {w["id"]: {"x": x, "y": y} for w, x, y in chosen}


def main():
    path, width, height, top, bottom = sys.argv[1], *map(int, sys.argv[2:6])
    widgets = json.loads(sys.argv[6])
    json.dump(place(path, width, height, top, bottom, widgets) if widgets else {}, sys.stdout)


if __name__ == "__main__":
    main()
