#!/usr/bin/env bash
# Translates text from a selected screen area. The text is sent to an online translation service.
set -euo pipefail

_t() { "$HOME/.local/bin/niri-desk-tr" "$1"; }
tell() { qs -c niri-desk ipc call desk toast "$@" >/dev/null 2>&1 || true; }
config="${XDG_CONFIG_HOME:-$HOME/.config}/niri-desk"
to="$(jq -r '.translate.to // empty' "$config/settings.json" 2>/dev/null || true)"
to="${to:-$("$HOME/.local/bin/niri-desk-tr" --lang)}"

region="$(slurp)" || exit 0
langs="$(tesseract --list-langs 2>/dev/null | tail -n +2 | grep -v '^osd$' | paste -sd+ -)" || langs=""
# OCR xato qilsa ham jim to'xtamaymiz: bo'sh matn haqida xabar chiqadi.
text="$(grim -g "$region" - | tesseract - - -l "${langs:-eng}" 2>/dev/null | sed -e '/^[[:space:]]*$/d')" || text=""
if [[ -z "$text" ]]; then
    tell "$(_t "No text found")" "$(_t "Try selecting another area")"
    exit 0
fi
if ! result="$(timeout 15 trans -b -no-autocorrect ":$to" -- "$text" 2>/dev/null)" || [[ -z "$result" ]]; then
    printf '%s' "$text" | wl-copy >/dev/null 2>&1
    tell "$(_t "Translation failed")" "$(_t "Check the internet. The original text was copied")"
    exit 0
fi
printf '%s' "$result" | wl-copy >/dev/null 2>&1
file="$(mktemp /tmp/niri-desk-translate.XXXXXX)"
printf '%s\n\n%s\n%s\n' "$result" "$(_t "--- Original text ---")" "$text" >"$file"
# shellcheck disable=SC2016
exec kitty --title "niri-desk translate" sh -c 'cat "$1"; rm -f "$1"; printf "\n%s" "$2"; read _' sh "$file" "$(_t "Copied. Press Enter to close")"
