#!/usr/bin/env bash
# Shows this screen on an Android tablet over USB, where a touch works as the pointer.
# niri cannot make a virtual display, so this is the same picture and not a second desktop.
# Only this computer can reach the server: the tablet comes through adb's own tunnel.
#   niri-desk-sidecar              starts or stops
#   niri-desk-sidecar start|stop
#   niri-desk-sidecar status       prints the state as JSON
set -uo pipefail

port=5900
pidfile="${XDG_RUNTIME_DIR:-/tmp}/niri-desk-sidecar.pid"
tr_() { "$HOME/.local/bin/niri-desk-tr" "$1"; }
desk() { qs -c niri-desk ipc call desk "$@" >/dev/null 2>&1; }
running() { [[ -f "$pidfile" ]] && kill -0 "$(cat "$pidfile")" 2>/dev/null; }
tablet() { adb devices 2>/dev/null | awk 'NR>1 && $2=="device"{print $1; exit}'; }
focused() { niri msg --json focused-output 2>/dev/null | python3 -c 'import json,sys; print(json.load(sys.stdin)["name"])' 2>/dev/null; }

start() {
    local serial output
    running && return 0
    if ! command -v wayvnc >/dev/null; then
        desk toast "$(tr_ "Tablet screen is not installed")" "niri-desk-extras setup"
        return 1
    fi
    if [[ "${NIRI_DESK_SIDECAR_NO_ADB:-}" == 1 ]]; then
        serial=test
    else
        serial="$(tablet)"
    fi
    if [[ -z "$serial" ]]; then
        desk toast "$(tr_ "No tablet found")" "$(tr_ "Connect it by USB and allow USB debugging")"
        return 1
    fi
    output="$(focused)"
    setsid wayvnc ${output:+--output="$output"} 127.0.0.1 "$port" >/dev/null 2>&1 &
    echo $! >"$pidfile"
    sleep 0.6
    if ! running; then
        rm -f "$pidfile"
        desk toast "$(tr_ "Tablet screen did not start")" ""
        return 1
    fi
    [[ "$serial" == test ]] || adb -s "$serial" reverse "tcp:$port" "tcp:$port" >/dev/null
    desk toast "$(tr_ "Tablet screen is on")" "$(tr_ "In a VNC app on the tablet, connect to 127.0.0.1:5900")"
}

stop() {
    running && kill "$(cat "$pidfile")" 2>/dev/null
    rm -f "$pidfile"
    command -v adb >/dev/null && adb reverse --remove "tcp:$port" >/dev/null 2>&1
    return 0
}

case "${1:-toggle}" in
toggle) if running; then stop; else start; fi ;;
start) start ;;
stop) stop ;;
status)
    running && on=true || on=false
    command -v wayvnc >/dev/null && installed=true || installed=false
    printf '{"on":%s,"installed":%s}\n' "$on" "$installed"
    ;;
*) sed -n '5,7p' "$0" | cut -c3- >&2; exit 2 ;;
esac
