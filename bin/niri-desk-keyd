#!/usr/bin/env bash
# Moves the Super tap from niri-desk-super to keyd, so this user can leave the input group. Asks for sudo.
#   niri-desk-keyd        turn on
#   niri-desk-keyd --off  go back to niri-desk-super
# keyd sees only the keyboard: holding Super under 0.2 s and clicking the mouse counts as a tap.
set -euo pipefail

repo="${NIRI_DESK_REPO:-$HOME/Downloads/niri-desk}"
if [[ "${1:-}" == "--off" ]]; then
    sudo systemctl disable --now keyd.service
    sudo rm -f /etc/keyd/default.conf
    "$HOME/.local/bin/niri-desk-set" --reset binds.apps
    sudo gpasswd -a "$USER" input
    echo "Log out and in: niri-desk-super starts with the session again."
    exit 0
fi
[[ -f "$repo/config/keyd/default.conf" ]] || { echo "Repo not found: $repo. Set NIRI_DESK_REPO." >&2; exit 1; }
pacman -Q keyd >/dev/null 2>&1 || sudo pacman -S --needed --noconfirm keyd
sudo install -D -m 644 "$repo/config/keyd/default.conf" /etc/keyd/default.conf
sudo systemctl enable --now keyd.service
sudo keyd reload
"$HOME/.local/bin/niri-desk-set" binds.apps '"XF86Tools"'
pkill -f "$HOME/.local/bin/niri-desk-super" || true
sudo gpasswd -d "$USER" input
echo "Done. The input group leaves this session at the next login."
