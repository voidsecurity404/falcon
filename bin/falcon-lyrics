#!/usr/bin/env python3
"""Finds the lyrics of a song on LRCLIB (lrclib.net, free, no account).

    falcon-lyrics ARTIST TITLE [SECONDS]

Prints one JSON line:
    {"synced": [[seconds, "line"], ...], "source": "..."}   lines timed to the song
    {"plain": ["line", ...]}                                 lyrics without times
    {"instrumental": true}
    {"error": "none"}      LRCLIB does not know the song
    {"error": "offline"}   no answer from LRCLIB

Answers are kept in ~/.cache/falcon/lyrics, misses for six hours only.
"""

import hashlib
import json
import os
import re
import sys
import time
import urllib.error
import urllib.parse
import urllib.request

API = "https://lrclib.net/api/"
AGENT = "falcon-lyrics (https://github.com/voidsecurity404/falcon)"
CACHE = os.path.join(os.environ.get("XDG_CACHE_HOME") or os.path.expanduser("~/.cache"), "falcon", "lyrics")
MISS_SECONDS = 6 * 3600
# A found song may differ from the one playing by this many seconds.
DURATION_SLACK = 8

# Words players add to titles that LRCLIB does not have.
NOISE = re.compile(
    r"\s*[\(\[【][^\)\]】]*(official|video|audio|lyric|visuali[sz]er|clip|mv|hd|4k|remaster|live|explicit|текст|клип)[^\)\]】]*[\)\]】]",
    re.IGNORECASE,
)
FEATURING = re.compile(r"\s+(feat\.?|ft\.?|featuring)\s+.*$", re.IGNORECASE)


def clean_artist(artist):
    artist = re.sub(r"\s*-\s*topic$", "", artist.strip(), flags=re.IGNORECASE)
    artist = re.sub(r"vevo$", "", artist, flags=re.IGNORECASE).strip()
    return FEATURING.sub("", artist).strip()


def clean_title(title):
    title = NOISE.sub("", title)
    title = FEATURING.sub("", title)
    return re.sub(r"\s+", " ", title).strip(" -|")


def split_names(artist, title):
    """Browsers and YouTube often give "Artist - Song" as the title."""
    artist = clean_artist(artist)
    title = clean_title(title)
    if " - " in title:
        left, right = title.split(" - ", 1)
        if not artist or artist.lower() in left.lower() or left.lower() in artist.lower():
            return clean_artist(left), clean_title(right)
    return artist, title


def ask(path, params):
    url = API + path + "?" + urllib.parse.urlencode(params)
    request = urllib.request.Request(url, headers={"User-Agent": AGENT})
    try:
        with urllib.request.urlopen(request, timeout=8) as answer:
            return json.load(answer)
    except urllib.error.HTTPError as error:
        if error.code == 404:
            return None
        raise


def parse_synced(text):
    lines = []
    for raw in text.splitlines():
        stamps = re.findall(r"\[(\d+):(\d+(?:\.\d+)?)\]", raw)
        words = re.sub(r"\[[^\]]*\]", "", raw).strip()
        for minutes, seconds in stamps:
            lines.append([round(int(minutes) * 60 + float(seconds), 2), words])
    lines.sort(key=lambda line: line[0])
    return lines


def answer_of(record):
    if record.get("instrumental"):
        return {"instrumental": True}
    synced = parse_synced(record.get("syncedLyrics") or "")
    if any(text for _, text in synced):
        return {"synced": synced, "source": record.get("artistName", "") + " - " + record.get("trackName", "")}
    plain = (record.get("plainLyrics") or "").strip()
    if plain:
        return {"plain": plain.splitlines()}
    return None


def best_of(records, duration):
    def fits(record):
        return duration <= 0 or abs((record.get("duration") or 0) - duration) <= DURATION_SLACK

    for wanted in (lambda r: fits(r) and r.get("syncedLyrics"), lambda r: fits(r) and (r.get("plainLyrics") or r.get("instrumental"))):
        for record in records or []:
            if wanted(record):
                return record
    return None


def find(artist, title, duration):
    if not title:
        return None
    if artist:
        params = {"artist_name": artist, "track_name": title}
        if duration > 0:
            params["duration"] = round(duration)
        record = ask("get", params)
        found = answer_of(record) if record else None
        if found and "synced" in found:
            return found
        record = best_of(ask("search", {"artist_name": artist, "track_name": title}), duration)
        if record:
            return answer_of(record) or found
        if found:
            return found
    record = best_of(ask("search", {"q": (artist + " " + title).strip()}), duration)
    return answer_of(record) if record else None


def main():
    if len(sys.argv) < 3:
        print(__doc__.strip(), file=sys.stderr)
        return 2
    duration = 0.0
    if len(sys.argv) > 3:
        try:
            duration = float(sys.argv[3])
        except ValueError:
            pass
    artist, title = split_names(sys.argv[1], sys.argv[2])

    key = hashlib.sha1(f"{artist.lower()}\n{title.lower()}\n{round(duration / 4)}".encode()).hexdigest()
    path = os.path.join(CACHE, key + ".json")
    try:
        with open(path) as file:
            kept = json.load(file)
        if kept.get("error") != "none" or time.time() - os.path.getmtime(path) < MISS_SECONDS:
            print(json.dumps(kept, ensure_ascii=False))
            return 0
    except (OSError, ValueError):
        pass

    try:
        found = find(artist, title, duration) or {"error": "none"}
    except (OSError, ValueError):
        print(json.dumps({"error": "offline"}))
        return 0
    os.makedirs(CACHE, exist_ok=True)
    temporary = path + ".tmp"
    with open(temporary, "w") as file:
        json.dump(found, file, ensure_ascii=False)
    os.replace(temporary, path)
    print(json.dumps(found, ensure_ascii=False))
    return 0


if __name__ == "__main__":
    sys.exit(main())
