#!/usr/bin/env python3
"""Hand control: the webcam watches one hand and a virtual mouse follows it.

  falcon-handmouse setup     installs the Python packages and the hand model, about 550 MB, no root
  falcon-handmouse status    prints JSON: ready, cameras, uinput
  falcon-handmouse trace [SECONDS]
                             watches the hand without touching the pointer and prints what it sees:
                             pinch distances, poses and each gesture, to tune the settings
  falcon-handmouse run       the engine, started by the shell. Reads settings and commands as JSON lines
                             on stdin, prints its state as JSON lines, and ends when stdin closes.

The pointer goes through /dev/uinput, the only way on Wayland. The engine itself runs in its own Python
in ~/.local/share/falcon/handmouse/venv, since MediaPipe and OpenCV are not Arch packages.
"""
import fcntl
import hashlib
import json
import math
import os
import queue
import shutil
import signal
import subprocess
import sys
import threading
import time
import urllib.request
from pathlib import Path

import numpy as np

HOME = Path.home()
FOLDER = Path(os.environ.get("XDG_DATA_HOME", HOME / ".local/share")) / "falcon/handmouse"
VENV = FOLDER / "venv"
MODEL = FOLDER / "hand_landmarker.task"
READY = FOLDER / "ready"
STATE = Path(os.environ.get("XDG_STATE_HOME", HOME / ".local/state")) / "falcon"
CALIBRATION = STATE / "handmouse-calibration.json"
RUNTIME = Path(os.environ.get("XDG_RUNTIME_DIR", "/tmp")) / "falcon-handmouse"

PACKAGES = ["mediapipe==1.2.2", "opencv-contrib-python==5.0.0.93", "numpy==2.5.4", "evdev==2.0.0"]
MODEL_URL = "https://storage.googleapis.com/mediapipe-models/hand_landmarker/hand_landmarker/float16/1/hand_landmarker.task"
MODEL_SHA256 = "fbc2a30080c3c557093b5ddfc334698132eb341044ccee322ccf8bcf3607cde1"
# Bump when PACKAGES or the model change, so an older setup is done again.
SETUP_VERSION = "1"


def say(**message):
    print(json.dumps(message, ensure_ascii=False), flush=True)


def digest(path):
    hashed = hashlib.sha256()
    with open(path, "rb") as handle:
        for piece in iter(lambda: handle.read(1 << 20), b""):
            hashed.update(piece)
    return hashed.hexdigest()


def cameras():
    """Capture devices, as /dev/videoN. A webcam often has a second node for metadata only."""
    found = []
    for node in sorted(Path("/sys/class/video4linux").glob("video*"), key=lambda p: int(p.name[5:] or 0)):
        try:
            if (node / "index").read_text().strip() != "0":
                continue
            name = (node / "name").read_text().strip()
        except OSError:
            continue
        found.append({"device": "/dev/" + node.name, "name": name})
    return found


def is_ready():
    try:
        return READY.read_text().strip() == SETUP_VERSION and (VENV / "bin/python").exists() and MODEL.exists()
    except OSError:
        return False


def status():
    calibrated = ""
    try:
        calibrated = json.loads(CALIBRATION.read_text()).get("date", "")
    except (OSError, ValueError):
        pass
    print(json.dumps({
        "ready": is_ready(),
        "cameras": cameras(),
        "uinput": os.access("/dev/uinput", os.W_OK),
        "calibrated": calibrated,
    }))


def setup():
    FOLDER.mkdir(parents=True, exist_ok=True)
    lock = open(FOLDER / ".lock", "w")
    try:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        say(error="busy")
        return 1
    try:
        READY.unlink(missing_ok=True)
        python = VENV / "bin/python"
        if not python.exists():
            say(step="python")
            subprocess.run([sys.executable, "-m", "venv", "--clear", str(VENV)], check=True, stdout=subprocess.DEVNULL)
        say(step="packages")
        subprocess.run([str(python), "-m", "pip", "install", "--quiet", "--disable-pip-version-check", *PACKAGES],
                       check=True, stdout=subprocess.DEVNULL, stderr=subprocess.PIPE)
        if not MODEL.exists() or digest(MODEL) != MODEL_SHA256:
            say(step="model")
            partial = MODEL.with_name(MODEL.name + ".part")
            request = urllib.request.Request(MODEL_URL, headers={"User-Agent": "falcon-handmouse"})
            with urllib.request.urlopen(request, timeout=120) as answer, open(partial, "wb") as out:
                shutil.copyfileobj(answer, out, 1 << 20)
            if digest(partial) != MODEL_SHA256:
                partial.unlink()
                raise OSError("hand model checksum does not match")
            partial.replace(MODEL)
        say(step="check")
        subprocess.run([str(python), "-c", "import mediapipe, cv2, evdev, numpy"], check=True,
                       stdout=subprocess.DEVNULL, stderr=subprocess.PIPE)
        READY.write_text(SETUP_VERSION + "\n")
        say(done=True)
        return 0
    except subprocess.CalledProcessError as error:
        detail = (error.stderr or b"").decode(errors="replace").strip().splitlines()
        say(error=detail[-1] if detail else str(error))
        return 1
    except OSError as error:
        say(error=str(error))
        return 1


# ---------------------------------------------------------------- engine, runs in the venv

WRIST, THUMB_IP, THUMB_TIP = 0, 3, 4
INDEX_MCP, INDEX_PIP, INDEX_TIP = 5, 6, 8
MIDDLE_MCP, MIDDLE_PIP, MIDDLE_TIP = 9, 10, 12
RING_MCP, RING_PIP, RING_TIP = 13, 14, 16
PINKY_MCP, PINKY_PIP, PINKY_TIP = 17, 18, 20
BONES = [(0, 1), (1, 2), (2, 3), (3, 4), (0, 5), (5, 6), (6, 7), (7, 8), (5, 9), (9, 10), (10, 11), (11, 12),
         (9, 13), (13, 14), (14, 15), (15, 16), (13, 17), (17, 18), (18, 19), (19, 20), (0, 17)]

# Where the calibration targets stand, as parts of the screen. The overlay draws them at the same places.
TARGETS = [(0.1, 0.1), (0.9, 0.1), (0.9, 0.9), (0.1, 0.9)]


def number(config, key, default, low, high):
    try:
        value = float(config.get(key, default))
    except (TypeError, ValueError):
        return default
    return default if math.isnan(value) else min(high, max(low, value))


def choice(config, key, options):
    value = config.get(key)
    return value if value in options else options[0]


class Config:
    """The handmouse section of the settings, range-checked. Unknown or broken values fall back."""

    def __init__(self, raw):
        raw = raw if isinstance(raw, dict) else {}
        camera = raw.get("camera")
        self.camera = camera if isinstance(camera, str) and camera.startswith("/dev/video") else ""
        self.mode = choice(raw, "mode", ["absolute", "relative"])
        self.hand = choice(raw, "hand", ["any", "right", "left"])
        self.mirror = bool(raw.get("mirror", True))
        self.anchor = choice(raw, "anchor", ["index_mcp", "index_tip", "palm_center"])
        self.steady_fps = bool(raw.get("steadyFps", False))
        zone = raw.get("zone") if isinstance(raw.get("zone"), dict) else {}
        x0, x1 = number(zone, "left", 0.2, 0, 0.45), number(zone, "right", 0.8, 0.55, 1)
        y0, y1 = number(zone, "top", 0.15, 0, 0.45), number(zone, "bottom", 0.75, 0.55, 1)
        self.zone = (x0, y0, x1, y1)
        self.use_calibration = bool(raw.get("useCalibration", True))
        self.speed = number(raw, "speed", 1.5, 0.3, 5)
        self.min_cutoff = number(raw, "minCutoff", 0.8, 0.05, 5)
        self.beta = number(raw, "beta", 0.02, 0, 0.2)
        self.deadzone_px = number(raw, "deadzone", 2, 0, 20)
        g = raw.get("gestures") if isinstance(raw.get("gestures"), dict) else {}
        self.pinch_press = number(g, "pinchPress", 0.25, 0.1, 0.6)
        self.pinch_release = max(self.pinch_press + 0.06, number(g, "pinchRelease", 0.38, 0.15, 0.8))
        self.drag_ms = number(g, "dragMs", 400, 150, 1500)
        self.freeze_ms = number(g, "freezeMs", 120, 0, 500)
        self.scroll_gain = number(g, "scrollSpeed", 40, 2, 200)
        self.palm_toggle = bool(g.get("palmToggle", False))
        self.toggle_ms = number(g, "toggleHoldMs", 600, 300, 3000)
        self.lost_ms = number(g, "lostMs", 400, 100, 3000)


# ---------------------------------------------------------------- pure parts, tested without a camera

def features(p, w, anchor_kind):
    """p: 21 points in the picture, 0 to 1. w: the same 21 in metres around the hand, from MediaPipe's
    world landmarks. Shapes are judged in w, so they do not change when the hand turns or moves away,
    and two fingertips that only overlap in the picture do not count as touching."""
    scale = float(np.linalg.norm(w[WRIST] - w[MIDDLE_MCP])) + 1e-6

    def d(a, b):
        return float(np.linalg.norm(w[a] - w[b])) / scale

    def out(tip, pip):
        return d(tip, WRIST) > d(pip, WRIST) * 1.1

    def curled(tip, pip):
        return d(tip, WRIST) < d(pip, WRIST)

    def stretched(tip, pip):
        return d(tip, WRIST) > d(pip, WRIST) * 1.2

    thumb_out = d(THUMB_TIP, INDEX_MCP) > 0.6 and d(THUMB_TIP, PINKY_MCP) > d(THUMB_IP, PINKY_MCP)
    fingers = (thumb_out, out(INDEX_TIP, INDEX_PIP), out(MIDDLE_TIP, MIDDLE_PIP), out(RING_TIP, RING_PIP), out(PINKY_TIP, PINKY_PIP))
    fist = all(curled(t, j) for t, j in ((INDEX_TIP, INDEX_PIP), (MIDDLE_TIP, MIDDLE_PIP), (RING_TIP, RING_PIP), (PINKY_TIP, PINKY_PIP)))
    # Spread: the tips of index and pinky stand well apart, which a relaxed open hand does not do.
    if all(fingers) and d(INDEX_TIP, PINKY_TIP) > 1.0:
        pose = "palm"
    elif fist:
        pose = "fist"
    # On photos a straight finger measures 1.3 or more, a curled one under 0.85. Half bent fingers of a
    # relaxed hand fall between, and must not start scrolling.
    elif stretched(INDEX_TIP, INDEX_PIP) and stretched(MIDDLE_TIP, MIDDLE_PIP) and curled(RING_TIP, RING_PIP) and curled(PINKY_TIP, PINKY_PIP):
        pose = "two"
    else:
        pose = "other"
    if anchor_kind == "index_tip":
        anchor = p[INDEX_TIP]
    elif anchor_kind == "palm_center":
        anchor = p[[WRIST, INDEX_MCP, MIDDLE_MCP, RING_MCP, PINKY_MCP]].mean(axis=0)
    else:
        anchor = p[INDEX_MCP]
    return {
        "anchor": np.asarray(anchor, dtype=np.float64),
        "palm": p[[WRIST, INDEX_MCP, PINKY_MCP]].mean(axis=0).astype(np.float64),
        "pinch_index": d(THUMB_TIP, INDEX_TIP),
        "pinch_middle": d(THUMB_TIP, MIDDLE_TIP),
        # A finger folded into the palm can sit near the thumb tip in a fist: that is no pinch.
        "index_ok": d(INDEX_TIP, WRIST) > d(INDEX_PIP, WRIST) * 0.85,
        "middle_ok": d(MIDDLE_TIP, WRIST) > d(MIDDLE_PIP, WRIST) * 0.85,
        "index_up": fingers[1],
        "pose": pose,
    }


# ------------------------------------------------ smoothing

class OneEuro:
    """Smooths hard while the hand is slow, so the pointer stays still, and little while it is fast."""

    def __init__(self, min_cutoff, beta, d_cutoff=2.0):
        self.min_cutoff, self.beta, self.d_cutoff = min_cutoff, beta, d_cutoff
        self.reset()

    def reset(self):
        self.t = None
        self.x = None
        self.dx = None

    def __call__(self, x, t):
        if self.t is None:
            self.t, self.x, self.dx = t, x.copy(), np.zeros_like(x)
            return self.x.copy()
        dt = t - self.t
        if dt <= 0:
            return self.x.copy()
        a_d = 1.0 / (1.0 + (1.0 / (2 * math.pi * self.d_cutoff)) / dt)
        self.dx = self.dx + a_d * ((x - self.x) / dt - self.dx)
        cutoff = self.min_cutoff + self.beta * np.abs(self.dx)
        a = 1.0 / (1.0 + (1.0 / (2 * np.pi * cutoff)) / dt)
        self.x = self.x + a * (x - self.x)
        self.t = t
        return self.x.copy()


def rope(held, target, radius):
    """A dead zone with no step: the held place is pulled along once the target is further than the radius,
    so small shaking does nothing and a slow move stays even instead of going in jumps."""
    gap = target - held
    distance = float(np.linalg.norm(gap))
    return held if distance <= radius else held + gap * (1 - radius / distance)


class Ballistics:
    """The mouse-like mode: a place on the screen counted from moves of the hand. It has no edges, since
    the real pointer stops at the edge of the screen by itself. A slow hand gets a smaller gain for
    precision and a fast one a larger gain, so the arm need not travel far."""

    SLOW, FAST = 150.0, 1500.0
    LOW, HIGH = 0.7, 1.3
    # The hand was out of sight for this long: where it comes back says nothing about a move.
    GAP = 0.2

    def __init__(self, start):
        self.place = np.asarray(start, dtype=np.float64)
        self.last = None
        self.last_t = 0.0

    def forget(self):
        self.last = None

    def step(self, px, t, speed):
        if self.last is not None and 0 < t - self.last_t <= self.GAP:
            move = px - self.last
            pace = float(np.linalg.norm(move)) / (t - self.last_t)
            share = min(1.0, max(0.0, (pace - self.SLOW) / (self.FAST - self.SLOW)))
            self.place = self.place + move * (self.LOW + (self.HIGH - self.LOW) * share) * speed
        self.last, self.last_t = px.copy(), t
        return self.place.copy()


# ------------------------------------------------ gestures

class Gestures:
    """The one place that decides when the pointer moves and which button goes down. No I/O here:
    it takes the time and the hand, and returns commands and events."""

    # How far back a pinch may look for where the hand aimed, and how far that may be from the hand now.
    AIM_BACK, AIM_REACH = 0.3, 0.09
    # After a click the pointer waits this long for a second one, unless the hand moves this far.
    DOUBLE_WAIT, DOUBLE_MOVE = 0.45, 0.012
    # Hand moves smaller than this part of the picture height do not scroll.
    SCROLL_SLOP = 0.004

    def __init__(self, cfg, glide=True):
        self.cfg = cfg
        self.glide = glide
        self.active = True
        self.reset()

    def reset(self):
        self.state = "track"
        self.since = 0.0
        self.hold_at = None
        self.hold_until = 0.0
        self.offset = None
        self.offset_t = 0.0
        self.pressed_from = None
        self.loose_from = None
        self.loose_after = 0.0
        self.recent = []
        self.pinched = False
        self.middle = False
        self.flips = {"pinched": 0, "middle": 0}
        self.need_open = False
        self.right_block = 0.0
        self.scroll_y = None
        self.scroll_held = None
        self.scroll_rest = 0.0
        self.down = set()
        self.pose = "other"
        self.candidate = "other"
        self.candidate_count = 0
        self.palm_since = None
        self.palm_at = None
        self.palm_done = False
        self.last_seen = None
        self.lost = False

    def release_all(self):
        out = [("release", b) for b in sorted(self.down)]
        self.down.clear()
        return out

    def debounce(self, name, closed, opened):
        """A pinch closes or opens only after two frames in a row agree, so one noisy frame does nothing."""
        now = getattr(self, name)
        if (not now and closed) or (now and opened):
            self.flips[name] += 1
            if self.flips[name] >= 2:
                setattr(self, name, not now)
                self.flips[name] = 0
        else:
            self.flips[name] = 0

    def confirm_pose(self, pose):
        """A pose counts once it is seen in three frames in a row."""
        if pose == self.candidate:
            self.candidate_count += 1
        else:
            self.candidate, self.candidate_count = pose, 1
        if self.candidate_count >= 3:
            self.pose = self.candidate
        return self.pose

    def aim(self, t, point, gap_key):
        """Where the hand pointed before the fingers began to close, because closing them pulls the hand
        along. Unless the hand was really travelling, then only a moment ago."""
        place, last_gap = point, None
        moment = point
        for when, where, gaps in reversed(self.recent):
            if t - when >= 0.08 and moment is point:
                moment = where
            if t - when > self.AIM_BACK:
                break
            gap = gaps[gap_key] if gap_key else None
            if t - when >= 0.08 and last_gap is not None and gap is not None and gap < last_gap - 0.02:
                break
            place, last_gap = where, gap
        if gap_key is None or math.dist(place, point) > self.AIM_REACH:
            return moment
        return place

    def palm_hold(self, t, feats, pose):
        """An open palm, spread and still for a while, turns the control on or off. True once per hold."""
        if not self.cfg.palm_toggle or pose != "palm":
            self.palm_since = None
            self.palm_done = False
            return False
        if self.palm_since is None or np.linalg.norm(feats["palm"] - self.palm_at) > 0.04:
            self.palm_since, self.palm_at = t, feats["palm"]
            return False
        if not self.palm_done and (t - self.palm_since) * 1000 >= self.cfg.toggle_ms:
            self.palm_done = True
            return True
        return False

    def step(self, t, feats, point):
        """Commands: ("move", x, y), ("press", b), ("release", b), ("scroll", n), where n counts 1/120 notch.
        Events: lost, back, on, off, pause, resume, click, drag, glide."""
        c = self.cfg
        out, events = [], []
        if feats is None:
            if self.last_seen is not None and (t - self.last_seen) * 1000 > c.lost_ms and not self.lost:
                out += self.release_all()
                active = self.active
                self.reset()
                self.active = active
                self.lost = True
                events.append("lost")
            return out, events
        if self.lost:
            events.append("back")
            self.lost = False
        self.last_seen = t
        self.debounce("pinched", feats["pinch_index"] < c.pinch_press and feats.get("index_ok", True), feats["pinch_index"] > c.pinch_release)
        self.debounce("middle", feats["pinch_middle"] < c.pinch_press and feats.get("middle_ok", True), feats["pinch_middle"] > c.pinch_release)
        if self.need_open and not self.pinched and not self.middle:
            self.need_open = False
        pose = self.confirm_pose(feats["pose"])
        # Where the pointer was a moment ago: a pinch moves the hand a little before it counts.
        gaps = {"pinch_index": feats["pinch_index"], "pinch_middle": feats["pinch_middle"]}
        self.recent = [r for r in self.recent if t - r[0] < 0.35] + [(t, point, gaps)]

        if not self.active:
            if self.palm_hold(t, feats, pose):
                self.active = True
                events.append("on")
            return out, events

        def hold_here(gap_key=None):
            # A pointer still waiting for a second click stays where the first one landed.
            if self.hold_at is None:
                self.hold_at = tuple(self.aim(t, point, gap_key))
                self.offset = None
            self.loose_from = None

        def move():
            if self.hold_at is not None and t < self.hold_until:
                # Only time is left of the wait for a second click: a hand setting off ends it.
                if self.loose_from is None or t < self.loose_after or math.dist(point, self.loose_from) <= self.DOUBLE_MOVE:
                    out.append(("move", *self.hold_at))
                    return
            target = point
            if self.hold_at is not None:
                events.append("glide")
                if self.glide:
                    self.offset, self.offset_t = np.subtract(self.hold_at, point), t
                self.hold_at = None
            if self.offset is not None:
                # Slide from where the pointer was held to where the hand is, instead of jumping.
                self.offset = self.offset * math.exp(-(t - self.offset_t) / 0.12)
                self.offset_t = t
                if np.abs(self.offset).max() < 0.0005:
                    self.offset = None
                else:
                    target = tuple(np.clip(np.add(point, self.offset), 0, 1))
            out.append(("move", float(target[0]), float(target[1])))

        def back_to_track():
            self.state = "track"
            self.hold_until = min(self.hold_until, t)

        s = self.state
        if s == "track":
            if self.palm_hold(t, feats, pose):
                self.active = False
                events.append("off")
                return out, events
            # When the thumb is near both fingers, the closer one is meant.
            left = self.pinched and (not self.middle or feats["pinch_index"] <= feats["pinch_middle"])
            # A pinch comes first: a pinch with the other fingers curled must not read as a fist.
            if left and not self.need_open:
                # The button goes down the moment the fingers touch, as on a real mouse.
                hold_here("pinch_index")
                out += [("move", *self.hold_at), ("press", "left")]
                self.down.add("left")
                self.pressed_from = point
                self.state, self.since, self.hold_until = "pinch", t, math.inf
            # A relaxed, curled hand brings the thumb near the middle finger too. A real right click
            # keeps the index finger straight.
            elif self.middle and not left and feats.get("index_up", True) and not self.need_open and t >= self.right_block:
                hold_here("pinch_middle")
                self.state, self.since, self.hold_until = "rightWait", t, math.inf
            elif pose == "fist" and not self.pinched:
                hold_here()
                self.state, self.need_open = "pause", True
                events.append("pause")
            elif pose == "two" and not self.pinched:
                hold_here()
                self.state, self.need_open = "scroll", True
                self.scroll_y = self.scroll_held = feats["palm"][1]
                self.scroll_rest = 0.0
            else:
                move()
        elif s == "pinch":
            moved = math.dist(point, self.pressed_from) > 0.02
            if not self.pinched:
                # Any pinch let go before a drag began is a click, in the place where it began.
                out += [("move", *self.hold_at)] + self.release_all()
                events.append("click")
                self.state = "track"
                self.hold_until = t + max(c.freeze_ms / 1000, self.DOUBLE_WAIT)
                self.loose_from, self.loose_after = point, t + c.freeze_ms / 1000
            elif (t - self.since) * 1000 >= c.drag_ms or (moved and t - self.since >= 0.1):
                # Held long enough, or the hand set off while pinching: the pointer may follow again.
                self.state = "drag"
                self.hold_until = t
                events.append("drag")
        elif s == "drag":
            if not self.pinched:
                out += self.release_all()
                self.state = "track"
                self.hold_at = None
                hold_here()
                self.hold_until = t + c.freeze_ms / 1000
            else:
                move()
        elif s == "rightWait":
            if not self.middle or (self.pinched and feats["pinch_index"] < feats["pinch_middle"]):
                back_to_track()
            elif (t - self.since) >= 0.06:
                out += [("move", *self.hold_at), ("press", "right"), ("release", "right")]
                events.append("click")
                self.state, self.need_open = "right", True
        elif s == "right":
            if not self.middle:
                self.state = "track"
                self.right_block = t + 0.4
                self.hold_until = t + c.freeze_ms / 1000
        elif s == "scroll":
            if pose != "two":
                back_to_track()
            else:
                # Half of the shaking goes here, and what is left stays under the slop.
                y = (self.scroll_y + feats["palm"][1]) / 2
                self.scroll_y = y
                # Only frames that show the pose themselves count, so leaving it scrolls nothing.
                if feats["pose"] == "two":
                    held = float(rope(np.array([self.scroll_held]), np.array([y]), self.SCROLL_SLOP)[0])
                    self.scroll_rest += (self.scroll_held - held) * c.scroll_gain * 120
                    self.scroll_held = held
                else:
                    self.scroll_held = y
                whole = int(self.scroll_rest)
                if whole:
                    out.append(("scroll", whole))
                    self.scroll_rest -= whole
        elif s == "pause":
            if pose != "fist":
                back_to_track()
                events.append("resume")
        return out, events


class Smoother:
    """The camera gives 15 to 30 pictures a second, the screen shows 60 or more. This moves the pointer
    at RATE between two pictures, so it glides instead of stepping, and spreads scrolling the same way.
    Every write goes through `send`, under one lock, so a click always lands after the pointer reached
    its place and never between two steps of a glide."""

    RATE = 144

    def __init__(self, apply, clock=time.monotonic):
        self.apply, self.clock = apply, clock
        self.lock = threading.RLock()
        self.shown = self.start = self.goal = None
        self.t0 = 0.0
        self.duration = 0.03
        self.interval = 1 / 24
        self.last_frame = None
        self.scroll_left = 0.0
        self.scroll_until = 0.0
        self.scroll_rest = 0.0
        self.stopped = threading.Event()
        self.thread = threading.Thread(target=self.loop, daemon=True)

    def begin(self):
        self.thread.start()

    def stop(self):
        self.stopped.set()
        if self.thread.is_alive():
            self.thread.join(timeout=1)

    def send(self, commands):
        with self.lock:
            if commands:
                self.apply(commands)

    def frame(self, stamp):
        """Learns the time between pictures, which is how long a glide takes."""
        if self.last_frame is not None:
            gap = min(0.15, max(0.01, stamp - self.last_frame))
            self.interval = self.interval * 0.8 + gap * 0.2
        self.last_frame = stamp

    def glide(self, x, y):
        with self.lock:
            if self.shown is None:
                self.shown = self.start = self.goal = (x, y)
                self.apply([("move", x, y)])
                return
            # A little shorter than the gap, so the pointer arrives before the next picture.
            self.start, self.goal = self.shown, (x, y)
            self.t0, self.duration = self.clock(), self.interval * 0.8

    def snap(self, x, y):
        """Puts the pointer there at once, for a press or a release."""
        with self.lock:
            self.shown = self.start = self.goal = (x, y)
            self.apply([("move", x, y)])

    def jump(self, x, y):
        """Takes the place as the current one without moving, for the relative mode."""
        with self.lock:
            self.shown = self.start = self.goal = (x, y)

    def scroll(self, amount):
        with self.lock:
            self.scroll_left += amount
            self.scroll_until = self.clock() + self.interval * 0.8

    def tick(self):
        with self.lock:
            now = self.clock()
            out = []
            if self.goal is not None and self.shown != self.goal:
                progress = 1.0 if self.duration <= 0 else min(1.0, (now - self.t0) / self.duration)
                if progress >= 1.0:
                    self.shown = self.goal
                else:
                    self.shown = (self.start[0] + (self.goal[0] - self.start[0]) * progress,
                                  self.start[1] + (self.goal[1] - self.start[1]) * progress)
                out.append(("move", *self.shown))
            if self.scroll_left:
                left = self.scroll_until - now
                part = self.scroll_left if left <= 1 / self.RATE else self.scroll_left / (left * self.RATE)
                self.scroll_left -= part
                if abs(self.scroll_left) < 1e-6:
                    self.scroll_left = 0.0
                self.scroll_rest += part
                # The last piece is rounded, so float error never eats a unit of scrolling.
                whole = round(self.scroll_rest) if not self.scroll_left else int(self.scroll_rest)
                if whole:
                    self.scroll_rest -= whole
                    out.append(("scroll", whole))
            if out:
                self.apply(out)
            return out

    def loop(self):
        while not self.stopped.is_set():
            self.tick()
            self.stopped.wait(1 / self.RATE)

    def deliver(self, commands, relative=False, fresh=False):
        """Takes what Gestures returned. Buttons go out at once after the pointer reaches their place,
        moves glide. `fresh` with the relative mode starts counting from here instead of moving."""
        moves = [c for c in commands if c[0] == "move"]
        scrolls = [c for c in commands if c[0] == "scroll"]
        buttons = [c for c in commands if c[0] in ("press", "release")]
        with self.lock:
            if fresh and relative and moves and not buttons:
                self.jump(moves[-1][1], moves[-1][2])
                return
            if buttons:
                if moves:
                    self.snap(moves[0][1], moves[0][2])
                self.apply(buttons)
            elif moves:
                self.glide(moves[-1][1], moves[-1][2])
            for c in scrolls:
                self.scroll(c[1])


def run():
    if not is_ready():
        say(error="setup")
        return 1
    python = str(VENV / "bin/python")
    os.execv(python, [python, "-I", os.path.abspath(__file__), "engine"])


def engine():
    import cv2
    from evdev import AbsInfo, UInput, ecodes as e

    os.environ.setdefault("GLOG_minloglevel", "2")
    import mediapipe as mp
    from mediapipe.tasks.python import BaseOptions, vision

    stop = threading.Event()
    inbox = queue.Queue()

    def on_signal(*_):
        stop.set()

    signal.signal(signal.SIGTERM, on_signal)
    signal.signal(signal.SIGINT, on_signal)
    signal.signal(signal.SIGHUP, signal.SIG_IGN)

    def read_stdin():
        for line in sys.stdin:
            try:
                inbox.put(json.loads(line))
            except ValueError:
                pass
        stop.set()

    threading.Thread(target=read_stdin, daemon=True).start()

    # ------------------------------------------------ geometry

    def screen_size():
        """Logical size of all outputs together, which an absolute pointer covers in niri."""
        try:
            outputs = json.loads(subprocess.run(["niri", "msg", "--json", "outputs"], capture_output=True, text=True, timeout=3).stdout)
            boxes = [o["logical"] for o in outputs.values() if o.get("logical")]
            left = min(b["x"] for b in boxes)
            top = min(b["y"] for b in boxes)
            right = max(b["x"] + b["width"] for b in boxes)
            bottom = max(b["y"] + b["height"] for b in boxes)
            return float(right - left), float(bottom - top)
        except (OSError, ValueError, KeyError, subprocess.SubprocessError):
            return 1920.0, 1080.0

    def homography(source, target):
        rows = []
        for (x, y), (u, v) in zip(source, target):
            rows.append([x, y, 1, 0, 0, 0, -u * x, -u * y, u])
            rows.append([0, 0, 0, x, y, 1, -v * x, -v * y, v])
        a = np.array(rows, dtype=np.float64)
        solution = np.linalg.solve(a[:, :8], a[:, 8])
        return np.append(solution, 1.0).reshape(3, 3)

    def load_calibration(cfg):
        """A calibration made with another mirror or anchor setting would point elsewhere, so it is not used."""
        try:
            data = json.loads(CALIBRATION.read_text())
            if data.get("mirror") != cfg.mirror or data.get("anchor") != cfg.anchor:
                return None
            matrix = np.array(data["matrix"], dtype=np.float64).reshape(3, 3)
            return matrix if np.all(np.isfinite(matrix)) else None
        except (OSError, ValueError, KeyError, TypeError):
            return None

    # ------------------------------------------------ the virtual mouse

    ABS_MAX = 32767
    # In the mouse-like mode, the part of the picture's width a hand crosses for one screen width at speed 1.
    RELATIVE_SPAN = 0.6
    BUTTONS = {"left": e.BTN_LEFT, "right": e.BTN_RIGHT, "middle": e.BTN_MIDDLE}

    class Pointer:
        def __init__(self, mode, size):
            self.mode, self.size = mode, size
            caps = {e.EV_KEY: list(BUTTONS.values()), e.EV_REL: [e.REL_WHEEL, e.REL_WHEEL_HI_RES]}
            if mode == "absolute":
                caps[e.EV_ABS] = [(e.ABS_X, AbsInfo(0, 0, ABS_MAX, 0, 0, 0)), (e.ABS_Y, AbsInfo(0, 0, ABS_MAX, 0, 0, 0))]
            else:
                caps[e.EV_REL] = [e.REL_X, e.REL_Y, e.REL_WHEEL, e.REL_WHEEL_HI_RES]
            self.ui = UInput(caps, name="Falcon hand control", vendor=0x1209, product=0x4D48, version=1)
            self.down = set()
            self.pressed_at = {}
            self.last = None
            self.rest = np.zeros(2)
            self.wheel = 0

        def forget_place(self):
            self.last = None

        def apply(self, commands):
            wrote = False
            for command in commands:
                kind = command[0]
                if kind == "move":
                    x, y = command[1], command[2]
                    if self.mode == "absolute":
                        self.ui.write(e.EV_ABS, e.ABS_X, round(x * ABS_MAX))
                        self.ui.write(e.EV_ABS, e.ABS_Y, round(y * ABS_MAX))
                        wrote = True
                    else:
                        here = np.array([x, y])
                        if self.last is not None:
                            self.rest += (here - self.last) * np.array(self.size)
                            whole = np.trunc(self.rest)
                            if whole.any():
                                self.ui.write(e.EV_REL, e.REL_X, int(whole[0]))
                                self.ui.write(e.EV_REL, e.REL_Y, int(whole[1]))
                                self.rest -= whole
                                wrote = True
                        self.last = here
                elif kind == "press" and command[1] not in self.down:
                    if wrote:
                        self.ui.syn()
                    self.ui.write(e.EV_KEY, BUTTONS[command[1]], 1)
                    self.down.add(command[1])
                    self.pressed_at[command[1]] = time.monotonic()
                    wrote = True
                elif kind == "release" and command[1] in self.down:
                    # libinput takes a release right after a press for a bouncing switch, and apps can
                    # miss it too, so a click keeps the button down for a moment.
                    held = time.monotonic() - self.pressed_at.get(command[1], 0)
                    if held < 0.03:
                        time.sleep(0.03 - held)
                    self.ui.write(e.EV_KEY, BUTTONS[command[1]], 0)
                    self.down.discard(command[1])
                    wrote = True
                elif kind == "scroll":
                    self.ui.write(e.EV_REL, e.REL_WHEEL_HI_RES, command[1])
                    self.wheel += command[1]
                    notches = int(self.wheel / 120)
                    if notches:
                        self.ui.write(e.EV_REL, e.REL_WHEEL, notches)
                        self.wheel -= notches * 120
                    wrote = True
                if kind in ("press", "release"):
                    self.ui.syn()
                    wrote = False
            if wrote:
                self.ui.syn()

        def release_all(self):
            self.apply([("release", b) for b in list(self.down)])

        def close(self):
            try:
                self.release_all()
            finally:
                self.ui.close()

    # ------------------------------------------------ camera

    class Camera:
        """Its own thread keeps only the newest frame, so delay never piles up."""

        def __init__(self, device):
            self.device = device
            self.frame = None
            self.stamp = 0.0
            self.serial = 0
            self.lock = threading.Condition()
            self.failed = False
            self.thread = threading.Thread(target=self.loop, daemon=True)
            self.thread.start()

        def open(self):
            cap = cv2.VideoCapture(self.device, cv2.CAP_V4L2)
            if not cap.isOpened():
                return None
            cap.set(cv2.CAP_PROP_FOURCC, cv2.VideoWriter_fourcc(*"MJPG"))
            cap.set(cv2.CAP_PROP_FRAME_WIDTH, 640)
            cap.set(cv2.CAP_PROP_FRAME_HEIGHT, 480)
            cap.set(cv2.CAP_PROP_FPS, 30)
            cap.set(cv2.CAP_PROP_BUFFERSIZE, 1)
            return cap

        def loop(self):
            wait = 1.0
            while not stop.is_set():
                cap = self.open()
                if cap is None:
                    self.failed = True
                    stop.wait(wait)
                    wait = min(10.0, wait * 2)
                    continue
                misses = 0
                while not stop.is_set():
                    ok, frame = cap.read()
                    if not ok:
                        misses += 1
                        if misses > 15:
                            break
                        time.sleep(0.05)
                        continue
                    misses = 0
                    self.failed = False
                    wait = 1.0
                    with self.lock:
                        self.frame, self.stamp = frame, time.monotonic()
                        self.serial += 1
                        self.lock.notify_all()
                cap.release()
                if not stop.is_set():
                    self.failed = True
                    stop.wait(wait)

        def wait_newer(self, serial, timeout):
            with self.lock:
                self.lock.wait_for(lambda: self.serial != serial or stop.is_set(), timeout)
                return self.serial, self.stamp, self.frame

    def dynamic_fps(device, value=None):
        """Reads, or sets, the camera's habit of lowering the frame rate in dim light."""
        try:
            if value is None:
                out = subprocess.run(["v4l2-ctl", "-d", device, "-C", "exposure_dynamic_framerate"], capture_output=True, text=True, timeout=3).stdout
                return out.split(":")[1].strip() if ":" in out else None
            subprocess.run(["v4l2-ctl", "-d", device, "-c", f"exposure_dynamic_framerate={value}"], capture_output=True, timeout=3)
        except (OSError, subprocess.SubprocessError):
            return None
        return None

    # ------------------------------------------------ start

    first = None
    deadline = time.monotonic() + 10
    while first is None and not stop.is_set() and time.monotonic() < deadline:
        try:
            message = inbox.get(timeout=0.5)
        except queue.Empty:
            continue
        if "config" in message:
            first = message["config"]
    if first is None:
        return 0
    cfg = Config(first)
    device = cfg.camera or next((c["device"] for c in cameras()), "")
    if not device:
        say(error="camera")
        return 1
    if not os.access("/dev/uinput", os.W_OK) and not os.environ.get("FALCON_HANDMOUSE_DRY"):
        say(error="uinput")
        return 1

    class DryPointer:
        """FALCON_HANDMOUSE_DRY=1: prints buttons and scrolling instead of moving the real pointer, for tests."""

        def __init__(self, *_):
            pass

        def forget_place(self):
            pass

        def apply(self, commands):
            for command in commands:
                if command[0] != "move":
                    say(dry=list(command))

        def close(self):
            pass

    size = screen_size()
    screen_px = np.array(size)
    try:
        pointer = (DryPointer if os.environ.get("FALCON_HANDMOUSE_DRY") else Pointer)(cfg.mode, size)
    except OSError as error:
        say(error="uinput", detail=str(error))
        return 1
    smoother = Smoother(pointer.apply)
    smoother.begin()
    old_fps = None
    if cfg.steady_fps:
        old_fps = dynamic_fps(device)
        dynamic_fps(device, 0)
    camera = Camera(device)

    def landmarker(hand, gpu):
        """The GPU runs the hand model in about 12 ms at a third less CPU than the processor alone, with
        the same points within a pixel. When it cannot start, the processor does the work."""
        if gpu:
            try:
                return landmarker_on(hand, BaseOptions.Delegate.GPU), True
            except (RuntimeError, ValueError, OSError):
                pass
        return landmarker_on(hand, BaseOptions.Delegate.CPU), False

    def landmarker_on(hand, delegate):
        options = vision.HandLandmarkerOptions(
            base_options=BaseOptions(model_asset_path=str(MODEL), delegate=delegate),
            running_mode=vision.RunningMode.VIDEO,
            num_hands=1 if hand == "any" else 2,
            min_hand_detection_confidence=0.6,
            # Lower than finding a hand: once found, it is kept through blur and quick moves.
            min_hand_presence_confidence=0.5,
            min_tracking_confidence=0.5,
        )
        return vision.HandLandmarker.create_from_options(options)

    tracker, on_gpu = landmarker(cfg.hand, not os.environ.get("FALCON_HANDMOUSE_CPU"))
    tracker_hand = cfg.hand
    gestures = Gestures(cfg, glide=cfg.mode == "absolute")
    smooth = OneEuro(cfg.min_cutoff, cfg.beta)
    calibration = load_calibration(cfg)
    preview = False
    calibrating = None
    still_px = None
    ballistics = Ballistics(screen_px / 2)
    last_ts = -1
    serial = 0
    seen_at = 0.0
    frames = 0
    skipped = 0
    delays = []
    reported = {}
    report_at = 0.0
    cpu_mark = (time.monotonic(), sum(os.times()[:2]))
    cpu = 0.0
    fps = 0.0
    shown_failed = False
    flip = 0
    RUNTIME.mkdir(parents=True, exist_ok=True)

    def to_screen(anchor, frame):
        """In pixels of the screen. The mouse-like mode uses the whole picture with one scale for both
        directions. The other mode maps the work area or the calibration onto the screen."""
        x, y = float(anchor[0]), float(anchor[1])
        if cfg.mirror:
            x = 1 - x
        if cfg.mode == "relative":
            scale = screen_px[0] / RELATIVE_SPAN
            return np.array([x * scale, y * scale * frame.shape[0] / frame.shape[1]])
        if cfg.use_calibration and calibration is not None:
            u, v, w = calibration @ np.array([x, y, 1.0])
            x, y = (u / w, v / w) if abs(w) > 1e-9 else (0.5, 0.5)
        else:
            x0, y0, x1, y1 = cfg.zone
            x, y = (x - x0) / (x1 - x0), (y - y0) / (y1 - y0)
        return np.array([min(1.0, max(0.0, x)), min(1.0, max(0.0, y))]) * screen_px

    def detect(stamp, frame):
        nonlocal tracker, on_gpu, last_ts
        try:
            return detect_on(stamp, frame)
        except (RuntimeError, ValueError):
            if not on_gpu:
                raise
            # The GPU failed while running: go on with the processor.
            tracker.close()
            (tracker, on_gpu), last_ts = landmarker(cfg.hand, False), -1
            return None

    def detect_on(stamp, frame):
        nonlocal last_ts
        ts = int(stamp * 1000)
        if ts <= last_ts:
            ts = last_ts + 1
        last_ts = ts
        rgb = cv2.cvtColor(brighter(frame), cv2.COLOR_BGR2RGB)
        result = tracker.detect_for_video(mp.Image(image_format=mp.ImageFormat.SRGB, data=rgb), ts)
        worlds = result.hand_world_landmarks or []
        for index, marks in enumerate(result.hand_landmarks or []):
            # MediaPipe names the hand as if the picture were mirrored, and ours is not.
            label = result.handedness[index][0].category_name.lower()
            side = "left" if label == "right" else "right"
            if cfg.hand in ("any", side) and index < len(worlds):
                picture = np.array([[m.x, m.y] for m in marks], dtype=np.float64)
                world = np.array([[m.x, m.y, m.z] for m in worlds[index]], dtype=np.float64)
                return picture, world
        return None

    gamma_tables = {}

    def brighter(frame):
        """A dim picture is lifted to a middle brightness, so the hand is still found in a dark room."""
        mean = float(frame[::16, ::16].mean())
        if mean >= 95 or mean < 3:
            return frame
        key = int(mean)
        table = gamma_tables.get(key)
        if table is None:
            power = math.log(110 / 255) / math.log(max(key, 3) / 255)
            table = np.array([((i / 255) ** power) * 255 for i in range(256)], dtype=np.uint8)
            gamma_tables[key] = table
        return cv2.LUT(frame, table)

    def write_preview(frame, points):
        nonlocal flip
        small = brighter(cv2.resize(frame, (320, 240), interpolation=cv2.INTER_AREA))
        if cfg.mirror:
            small = cv2.flip(small, 1)
        flip ^= 1
        path = RUNTIME / f"preview-{flip}.jpg"
        ok, data = cv2.imencode(".jpg", small, [cv2.IMWRITE_JPEG_QUALITY, 70])
        if ok:
            part = path.with_suffix(".part")
            part.write_bytes(data.tobytes())
            part.replace(path)
        shown = None
        if points is not None:
            shown = [[round(1 - x if cfg.mirror else x, 4), round(y, 4)] for x, y in points[0]]
        say(preview={"image": str(path), "points": shown})

    def report(force=False):
        nonlocal report_at
        now = time.monotonic()
        state = {
            "active": gestures.active,
            "hand": now - seen_at < cfg.lost_ms / 1000,
            "gesture": gestures.state,
            "camera": not camera.failed,
        }
        if not force and state == reported and now - report_at < 2:
            return
        reported.clear()
        reported.update(state)
        report_at = now
        ordered = sorted(delays)
        say(state=dict(state, gpu=on_gpu, fps=round(fps, 1), cpu=round(cpu), latency=round(ordered[len(ordered) // 2], 1) if ordered else 0,
                       latency95=round(ordered[int(len(ordered) * 0.95)], 1) if ordered else 0))

    tracing = bool(os.environ.get("FALCON_HANDMOUSE_TRACE"))
    say(started=True, device=device, screen=list(size))
    try:
        while not stop.is_set():
            while True:
                try:
                    message = inbox.get_nowait()
                except queue.Empty:
                    break
                if "config" in message:
                    cfg = Config(message["config"])
                    gestures.cfg = cfg
                    calibration = load_calibration(cfg)
                    smooth.min_cutoff, smooth.beta = cfg.min_cutoff, cfg.beta
                    if cfg.hand != tracker_hand:
                        tracker.close()
                        (tracker, on_gpu), tracker_hand, last_ts = landmarker(cfg.hand, on_gpu), cfg.hand, -1
                    report(True)
                command = message.get("cmd")
                if command == "preview":
                    preview = bool(message.get("on"))
                elif command == "toggle":
                    smoother.send(gestures.release_all())
                    gestures.reset()
                    gestures.active = not gestures.active
                    say(event="on" if gestures.active else "off")
                elif command == "calibrate":
                    smoother.send(gestures.release_all())
                    calibrating = {"step": 0, "since": None, "at": None, "samples": [], "points": []}
                elif command == "cancelCalibration":
                    calibrating = None
                    gestures.reset()
                    say(calibrate={"cancelled": True})
                elif command == "reloadCalibration":
                    calibration = load_calibration(cfg)
            fresh, stamp, frame = camera.wait_newer(serial, 0.5)
            if fresh == serial or frame is None or stop.is_set():
                if camera.failed and not shown_failed:
                    shown_failed = True
                    say(error="cameraLost")
                    report(True)
                continue
            serial = fresh
            if shown_failed:
                shown_failed = False
                say(event="cameraBack")
            # Without a hand, or with the control off, a third of the frames is enough to notice one.
            now = time.monotonic()
            calm = (now - seen_at > 1.0 or not gestures.active) and calibrating is None and not preview
            if calm and skipped < 2:
                skipped += 1
                continue
            skipped = 0
            points = detect(stamp, frame)
            frames += 1
            if points is not None:
                seen_at = time.monotonic()
            if preview and frames % 2 == 0:
                write_preview(frame, points)

            if calibrating is not None:
                step = calibrating["step"]
                hold = 0.0
                if points is not None:
                    raw = features(points[0], points[1], cfg.anchor)["anchor"].copy()
                    if cfg.mirror:
                        raw[0] = 1 - raw[0]
                    if calibrating["at"] is None or np.linalg.norm(raw - calibrating["at"]) > 0.015:
                        calibrating.update(since=stamp, at=raw, samples=[])
                    calibrating["samples"].append(raw)
                    hold = min(1.0, stamp - calibrating["since"])
                    if hold >= 1.0:
                        calibrating["points"].append(np.mean(calibrating["samples"], axis=0).tolist())
                        calibrating.update(step=step + 1, since=None, at=None, samples=[])
                        hold = 0.0
                else:
                    calibrating.update(since=None, at=None, samples=[])
                if calibrating["step"] >= len(TARGETS):
                    try:
                        matrix = homography(calibrating["points"], TARGETS)
                        if not np.all(np.isfinite(matrix)):
                            raise np.linalg.LinAlgError
                        STATE.mkdir(parents=True, exist_ok=True)
                        CALIBRATION.write_text(json.dumps({
                            "date": time.strftime("%Y-%m-%d %H:%M"),
                            "points": calibrating["points"],
                            "targets": TARGETS,
                            "matrix": matrix.tolist(),
                            "mirror": cfg.mirror,
                            "anchor": cfg.anchor,
                        }))
                        calibration = matrix
                        say(calibrate={"done": True, "date": time.strftime("%Y-%m-%d %H:%M")})
                    except np.linalg.LinAlgError:
                        say(calibrate={"failed": True})
                    calibrating = None
                    gestures.reset()
                    smooth.reset()
                else:
                    say(calibrate={"step": calibrating["step"], "hold": round(hold, 2), "hand": points is not None})
                continue

            feats = features(points[0], points[1], cfg.anchor) if points is not None else None
            point = None
            if feats is not None:
                if gestures.lost or gestures.last_seen is None:
                    smooth.reset()
                    still_px = None
                    ballistics.forget()
                # Smoothing works in screen pixels, so its speed term means the same on any zone.
                px = smooth(to_screen(feats["anchor"], frame), stamp)
                still_px = px if still_px is None else rope(still_px, px, cfg.deadzone_px)
                place = ballistics.step(still_px, stamp, cfg.speed) if cfg.mode == "relative" else still_px
                point = (float(place[0] / screen_px[0]), float(place[1] / screen_px[1]))
            commands, events = gestures.step(stamp, feats, point)
            if tracing:
                say(trace={
                    "t": round(stamp, 3),
                    "hand": feats is not None,
                    "pinch": round(feats["pinch_index"], 3) if feats else None,
                    "middle": round(feats["pinch_middle"], 3) if feats else None,
                    "pose": feats["pose"] if feats else None,
                    "state": gestures.state,
                    "events": events,
                    "buttons": [list(c) for c in commands if c[0] != "move"],
                })
            fresh = "glide" in events or "back" in events or "resume" in events
            smoother.frame(stamp)
            # One lock around both, so no step of a glide falls between forgetting the place and the jump.
            with smoother.lock:
                if fresh and cfg.mode == "relative":
                    # The pointer was held while the hand moved: start counting from here.
                    pointer.forget_place()
                if commands:
                    smoother.deliver(commands, relative=cfg.mode == "relative", fresh=fresh)
            if commands:
                delays.append((time.monotonic() - stamp) * 1000)
            for event in events:
                if event in ("on", "off"):
                    say(event=event)
            now = time.monotonic()
            if now - cpu_mark[0] >= 2:
                used = sum(os.times()[:2])
                cpu = (used - cpu_mark[1]) / (now - cpu_mark[0]) * 100
                fps = frames / (now - cpu_mark[0])
                frames = 0
                delays = delays[-120:]
                cpu_mark = (now, used)
            report()
    finally:
        try:
            smoother.stop()
            pointer.close()
        finally:
            stop.set()
            camera.thread.join(timeout=2)
            tracker.close()
            if old_fps is not None:
                dynamic_fps(device, old_fps)
            for leftover in RUNTIME.glob("preview-*"):
                leftover.unlink(missing_ok=True)
    return 0


def current_settings():
    """The handmouse section as the shell sees it: defaults, then the user's own values."""
    folder = HOME / ".config/falcon"

    def load(name):
        try:
            return json.loads((folder / name).read_text()).get("handmouse", {})
        except (OSError, ValueError):
            return {}

    def merge(base, over):
        out = dict(base)
        for key, value in over.items():
            out[key] = merge(out[key], value) if isinstance(value, dict) and isinstance(out.get(key), dict) else value
        return out

    return merge(load("defaults.json"), load("settings.json"))


def trace(seconds):
    if not is_ready():
        print("Not set up yet: falcon-handmouse setup")
        return 1
    raw = current_settings()
    cfg = Config(raw)
    env = dict(os.environ, FALCON_HANDMOUSE_DRY="1", FALCON_HANDMOUSE_TRACE="1", GLOG_minloglevel="3")
    child = subprocess.Popen([sys.executable, os.path.abspath(__file__), "run"], stdin=subprocess.PIPE, stdout=subprocess.PIPE,
                             stderr=subprocess.DEVNULL, text=True, env=env)
    child.stdin.write(json.dumps({"config": raw}) + "\n")
    child.stdin.flush()
    print(f"Watching for {seconds} s. The pointer is not touched. Pinch closes below {cfg.pinch_press:.2f}, opens above {cfg.pinch_release:.2f}.")
    start = None
    frames = seen = 0
    low = {"pinch": [], "middle": []}
    poses = {}
    last_pose = None
    try:
        for line in child.stdout:
            message = json.loads(line)
            if "error" in message:
                print("error:", message["error"])
                break
            if "started" in message:
                start = time.monotonic()
                print("Camera on. Show your hand.")
            item = message.get("trace")
            if not item:
                if start is not None and time.monotonic() - start > seconds:
                    break
                continue
            frames += 1
            if item["hand"]:
                seen += 1
                poses[item["pose"]] = poses.get(item["pose"], 0) + 1
                low["pinch"].append(item["pinch"])
                low["middle"].append(item["middle"])
            stamp = time.monotonic() - start
            if item["hand"] and item["pose"] != last_pose:
                print(f"{stamp:5.1f}s  pose {item['pose']:6}  thumb-index {item['pinch']:.2f}  thumb-middle {item['middle']:.2f}")
                last_pose = item["pose"]
            for event in item["events"]:
                if event in ("click", "drag", "lost", "back", "pause", "resume", "on", "off"):
                    print(f"{stamp:5.1f}s  {event:6}  thumb-index {item['pinch'] if item['pinch'] is not None else '-'}")
            for button in item["buttons"]:
                if button[0] != "scroll":
                    print(f"{stamp:5.1f}s    {button[0]} {button[1]}")
            if stamp > seconds:
                break
    except KeyboardInterrupt:
        pass
    finally:
        child.stdin.close()
        child.wait(timeout=5)
    print(f"\nFrames {frames}, with a hand {seen}. Poses: " + ", ".join(f"{k} {v}" for k, v in sorted(poses.items(), key=lambda kv: -kv[1])))
    for name, values in low.items():
        if values:
            values = sorted(values)
            print(f"thumb-{'index' if name == 'pinch' else 'middle'}: smallest {values[0]:.2f}, 10% {values[len(values) // 10]:.2f}, middle {values[len(values) // 2]:.2f}")
    return 0


def main():
    command = sys.argv[1] if len(sys.argv) > 1 else ""
    if command == "setup":
        return setup()
    if command == "status":
        status()
        return 0
    if command == "run":
        return run()
    if command == "engine":
        return engine()
    if command == "trace":
        return trace(float(sys.argv[2]) if len(sys.argv) > 2 else 30)
    print(__doc__.strip())
    return 2


if __name__ == "__main__":
    sys.exit(main())
