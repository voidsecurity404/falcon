#!/usr/bin/env bash
# Shell nazoratchisi: qs o'lsa qayta ishga tushiradi. Tez-tez yiqilsa to'xtab, xabar beradi.
set -u

exec 9>"${XDG_RUNTIME_DIR:-/tmp}/falcon-shell.lock"
flock -n 9 || exit 0

fails=0
while niri msg version >/dev/null 2>&1; do
    started=$SECONDS
    # Panel GPU'da qoladi: dasturiy render faqat VM'dagi oynalar uchun.
    env -u LIBGL_ALWAYS_SOFTWARE qs -c falcon 9>&-
    # A shell that died in the middle of a sticky switch may have left its sticky windows
    # transparent. The next shell writes the file again from its own state.
    sticky="$HOME/.config/niri/generated/sticky.kdl"
    if [[ -s "$sticky" ]]; then
        : >"$sticky"
        niri msg action load-config-file >/dev/null 2>&1 9>&-
    fi
    if ((SECONDS - started < 10)); then
        fails=$((fails + 1))
    else
        fails=0
    fi
    if ((fails >= 5)); then
        notify-send -u critical "falcon" "$("$HOME/.local/bin/falcon-tr" "The panel keeps crashing: qs -c falcon log")" 9>&-
        # The shell was the polkit agent: hand password prompts back to hyprpolkitagent.
        systemctl --user start hyprpolkitagent.service 9>&-
        exit 1
    fi
    sleep 1
done
