#!/usr/bin/env bash
# Screen recording with the options chosen on the control center's record page (`record` in
# toggles.json): sound (none, system, both), area (region, screen), delay in seconds, format (mp4, gif).
# Usage: falcon-record              stops a recording or a countdown, or starts one
#        falcon-record "X,Y WxH"    starts recording that area
#        falcon-record --screen     starts recording the focused display
#        falcon-record --stop       only stops
set -euo pipefail

state="${XDG_RUNTIME_DIR:-/tmp}/falcon-record"
videos="$(xdg-user-dir VIDEOS 2>/dev/null || echo "$HOME/Videos")"
toggles="${XDG_STATE_HOME:-$HOME/.local/state}/falcon/toggles.json"
_t() { "$HOME/.local/bin/falcon-tr" "$1"; }
desk() { qs -c falcon ipc call desk "$@" >/dev/null 2>&1 || true; }
option() { jq -r ".record.$1 // \"$2\"" "$toggles" 2>/dev/null || echo "$2"; }

unload_mix() {
    [[ -f "$state/modules" ]] || return 0
    while read -r id; do
        [[ -n "$id" ]] && pactl unload-module "$id" 2>/dev/null || true
    done < <(tac "$state/modules")
    rm -f "$state/modules"
}

stop() {
    local pid kind file format
    pid="$(cat "$state/pid" 2>/dev/null || true)"
    kind="$(cat "$state/kind" 2>/dev/null || true)"
    [[ -n "$pid" ]] && kill -0 "$pid" 2>/dev/null || return 1
    if [[ "$kind" == countdown ]]; then
        kill -TERM "$pid" 2>/dev/null || true
        rm -f "$state/pid" "$state/kind"
        desk recordingCountdown 0
        desk toast "$(_t "Recording cancelled")" ""
        return 0
    fi
    file="$(cat "$state/file")"
    format="$(cat "$state/format" 2>/dev/null || echo mp4)"
    rm -f "$state/pid" "$state/kind"
    kill -INT "$pid" 2>/dev/null || true
    desk recording false
    # wf-recorder finishes writing the file after the signal.
    for _ in $(seq 100); do
        kill -0 "$pid" 2>/dev/null || break
        sleep 0.1
    done
    unload_mix
    if [[ ! -s "$file" ]]; then
        desk toast "$(_t "Recording failed")" ""
        return 0
    fi
    if [[ "$format" == gif ]]; then
        desk toast "$(_t "Making a GIF…")" ""
        local gif="${file%.mp4}.gif"
        if ffmpeg -v error -y -i "$file" -vf "fps=15,scale='min(960,iw)':-2:flags=lanczos,split[a][b];[a]palettegen=stats_mode=diff[p];[b][p]paletteuse=dither=bayer:bayer_scale=4" "$gif"; then
            rm -f "$file"
            file="$gif"
        fi
    fi
    desk recordSaved "$file"
    return 0
}

if [[ "${1:-}" == --stop ]]; then
    stop || true
    exit 0
fi
if [[ -z "${1:-}" ]] && stop; then
    exit 0
fi

target="${1:-}"
if [[ -z "$target" ]]; then
    if [[ "$(option area region)" == screen ]]; then
        target=--screen
    else
        exec qs -c falcon ipc call desk region record
    fi
fi

mkdir -p "$state" "$videos"
# A crash could leave the mixing sink loaded.
unload_mix

delay="$(option delay 0)"
[[ "$delay" =~ ^[0-9]+$ ]] || delay=0
if ((delay > 0)); then
    echo $$ >"$state/pid"
    echo countdown >"$state/kind"
    trap 'exit 0' TERM
    desk recordingCountdown "$delay"
    sleep "$delay" &
    wait $! || true
    trap - TERM
fi

format="$(option format mp4)"
[[ "$format" == gif ]] || format=mp4
sound="$(option audio none)"
[[ "$format" == gif ]] && sound=none

args=()
if [[ "$target" == --screen ]]; then
    output="$(niri msg -j focused-output 2>/dev/null | jq -r '.name // empty')"
    [[ -n "$output" ]] && args+=(-o "$output")
else
    args+=(-g "$target")
fi

case "$sound" in
system)
    args+=(--audio-backend=pulse "--audio=$(pactl get-default-sink).monitor")
    ;;
both)
    sink="$(pactl get-default-sink)"
    source="$(pactl get-default-source)"
    {
        pactl load-module module-null-sink sink_name=falcon_record "sink_properties=device.description=Falcon\ recording node.passive=true"
        pactl load-module module-loopback source="$sink.monitor" sink=falcon_record latency_msec=20 source_dont_move=true sink_dont_move=true
        pactl load-module module-loopback source="$source" sink=falcon_record latency_msec=20 source_dont_move=true sink_dont_move=true
    } >"$state/modules"
    args+=(--audio-backend=pulse --audio=falcon_record.monitor)
    ;;
esac

file="$videos/$(date +%Y-%m-%d_%H-%M-%S).mp4"
wf-recorder "${args[@]}" -f "$file" >"$state/log" 2>&1 &
pid=$!
echo "$file" >"$state/file"
echo "$format" >"$state/format"
echo recording >"$state/kind"
echo "$pid" >"$state/pid"
desk recordingCountdown 0
sleep 0.4
if ! kill -0 "$pid" 2>/dev/null; then
    rm -f "$state/pid" "$state/kind" "$file"
    unload_mix
    desk toast "$(_t "Recording failed")" "$(tail -n 1 "$state/log")"
    exit 1
fi
desk recording true
