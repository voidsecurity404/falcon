#!/usr/bin/env bash
# Starts or stops recording. Without an area it stops, or asks the shell to let the user select one.
# Usage: falcon-record ["X,Y WxH"]
set -euo pipefail

pidfile="${XDG_RUNTIME_DIR:-/tmp}/falcon-record.pid"
videos="$(xdg-user-dir VIDEOS 2>/dev/null || echo "$HOME/Videos")"
_t() { "$HOME/.local/bin/falcon-tr" "$1"; }
tell() { qs -c falcon ipc call desk "$@" >/dev/null 2>&1 || true; }

if [[ -f "$pidfile" ]] && kill -0 "$(cat "$pidfile")" 2>/dev/null; then
    kill -INT "$(cat "$pidfile")"
    rm -f "$pidfile"
    tell recording false
    tell toast "$(_t "Video saved")" "$videos"
    exit 0
fi

region="${1:-}"
if [[ -z "$region" ]]; then
    exec qs -c falcon ipc call desk region record
fi
mkdir -p "$videos"
file="$videos/$(date +%Y-%m-%d_%H-%M-%S).mp4"
wf-recorder -g "$region" -f "$file" >/dev/null 2>&1 &
echo $! >"$pidfile"
tell recording true
