#!/usr/bin/env python3
"""Opens a work profile: apps start on their workspaces.

  niri-desk-profile NAME    open a profile
  niri-desk-profile --list  list profiles (JSON)

Profiles: ~/.config/niri-desk/profiles.json
Open apps are not reopened, missing ones are skipped.
"""
import json
import os
import re
import shlex
import shutil
import subprocess
import sys
import time
from pathlib import Path

sys.dont_write_bytecode = True
from niri_desk_tr import tr

CONFIG = Path(os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config")) / "niri-desk"


def niri_json(what):
    return json.loads(subprocess.run(["niri", "msg", "--json", what], capture_output=True, text=True, check=True).stdout)


def action(*args):
    subprocess.run(["niri", "msg", "action", *map(str, args)], capture_output=True, check=False)


def tell(title, sub):
    subprocess.run(["qs", "-c", "niri-desk", "ipc", "call", "desk", "toast", title, sub], capture_output=True, check=False, timeout=5)


def load():
    data = json.loads((CONFIG / "profiles.json").read_text())
    if not isinstance(data, list):
        raise ValueError("profiles.json must be a list")
    return data


def settings_vpn():
    for name in ("settings.json", "defaults.json"):
        try:
            cmd = json.loads((CONFIG / name).read_text() or "{}").get("vpn", {}).get("up", "")
        except (OSError, ValueError):
            continue
        if cmd:
            return cmd
    return ""


def open_window(item):
    argv = shlex.split(item["cmd"])
    if not argv or not shutil.which(argv[0]):
        return "missing"
    match = item.get("match", "")
    if match:
        try:
            pattern = re.compile(match, re.I)
        except re.error:
            return "bad"
        if any(pattern.search(w.get("app_id") or "") for w in niri_json("windows")):
            return "open"
    before = {w["id"] for w in niri_json("windows")}
    action("focus-workspace", item.get("workspace", 1))
    time.sleep(0.15)
    action("spawn", "--", *argv)
    end = time.time() + float(item.get("timeout", 12))
    while time.time() < end:
        if {w["id"] for w in niri_json("windows")} - before:
            time.sleep(0.5)
            return "ok"
        time.sleep(0.15)
    return "late"


def main():
    if sys.argv[1:] == ["--list"]:
        print(json.dumps([{"name": p["name"], "detail": p.get("detail", "")} for p in load()], ensure_ascii=False))
        return 0
    if len(sys.argv) != 2:
        print(__doc__.strip(), file=sys.stderr)
        return 2
    try:
        profiles = load()
    except (OSError, ValueError) as err:
        print(f"Could not read profiles: {err}", file=sys.stderr)
        tell(tr("Could not open the profile"), tr("profiles.json is invalid"))
        return 1
    profile = next((p for p in profiles if p.get("name", "").lower() == sys.argv[1].lower()), None)
    if profile is None:
        print(f"Profile not found: {sys.argv[1]}", file=sys.stderr)
        tell(tr("Profile not found"), sys.argv[1])
        return 1
    if profile.get("vpn"):
        cmd = settings_vpn()
        if cmd:
            subprocess.Popen(["sh", "-c", cmd], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
    items = sorted(profile.get("windows", []), key=lambda i: i.get("workspace", 1))
    missing = []
    for item in items:
        if open_window(item) == "missing":
            missing.append(shlex.split(item["cmd"])[0] if item.get("cmd") else "?")
    if items:
        action("focus-workspace", items[0].get("workspace", 1))
    sub = tr("Not installed: {apps}", apps=", ".join(missing)) if missing else tr("All apps are ready")
    tell(tr("{name} opened", name=profile["name"]), sub)
    return 0


sys.exit(main())
