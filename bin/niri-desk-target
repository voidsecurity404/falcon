#!/usr/bin/env bash
# Pentest nishonini settings.json ga yozadi. Dashboard o'zgarishni darhol ko'radi.
#   niri-desk-target 10.10.11.42
set -euo pipefail

target="${1:-}"
[[ "$target" =~ ^[A-Za-z0-9.:_-]+$ ]] || { echo "Invalid target: $target" >&2; exit 2; }
file="${XDG_CONFIG_HOME:-$HOME/.config}/niri-desk/settings.json"
tmp="$(mktemp "$file.XXXXXX")"
jq --arg t "$target" '.lab.target = $t' "$file" >"$tmp"
mv "$tmp" "$file"
qs -c niri-desk ipc call desk toast "$("$HOME/.local/bin/niri-desk-tr" "Target changed")" "$target" >/dev/null 2>&1 || true
