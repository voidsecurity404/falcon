#!/usr/bin/env python3
"""Copies the wallpaper colors into every Firefox profile. Firefox reads them when it starts.

Only touches chrome/userChrome.css of a profile when this script wrote it, or when it does not exist.
"""
from pathlib import Path

MARK = "/* falcon */\n"
PREF = 'user_pref("toolkit.legacyUserProfileCustomizations.stylesheets", true);\n'
HOME = Path.home()
SOURCE = HOME / ".local/state/falcon/firefox-userChrome.css"
# Opens the previous windows and tabs, so a restored Firefox window has what it had.
RESUME = 'user_pref("browser.startup.page", 3);\n'
# Lines a glass look once added to user.js. Firefox keeps a value it read there, so the
# ones that differ from Firefox's own default are written back as that default.
UNDO = {
    'user_pref("widget.transparent-windows", true);\n': '',
    'user_pref("layout.css.scroll-driven-animations.enabled", true);\n': '',
    'user_pref("browser.tabs.allow_transparent_browser", true);\n': 'user_pref("browser.tabs.allow_transparent_browser", false);\n',
    'user_pref("browser.tabs.allow_transparent_browser", false);\n': 'user_pref("browser.tabs.allow_transparent_browser", false);\n',
    'user_pref("layout.css.prefers-color-scheme.content-override", 0);\n': 'user_pref("layout.css.prefers-color-scheme.content-override", 2);\n',
    'user_pref("gfx.webrender.svg-filter-effects.fetile", true);\n': 'user_pref("gfx.webrender.svg-filter-effects.fetile", false);\n',
}

for root in (HOME / ".config/mozilla/firefox", HOME / ".mozilla/firefox"):
    for prefs in root.glob("*/prefs.js"):
        profile = prefs.parent
        user = profile / "user.js"
        text = user.read_text() if user.exists() else ""
        for line, default in UNDO.items():
            if line in text and line != default:
                text = text.replace(line, default)
        if RESUME not in text:
            text += RESUME
        user.write_text(text)
        # The sheet that restyled websites goes, when this script wrote it.
        content = profile / "chrome/userContent.css"
        if content.exists() and content.read_text().startswith(MARK):
            content.unlink()

if SOURCE.exists():
    css = MARK + SOURCE.read_text()
    for root in (HOME / ".config/mozilla/firefox", HOME / ".mozilla/firefox"):
        for prefs in root.glob("*/prefs.js"):
            profile = prefs.parent
            target = profile / "chrome/userChrome.css"
            if target.exists() and not target.read_text().startswith(MARK):
                continue
            target.parent.mkdir(exist_ok=True)
            target.write_text(css)
            user = profile / "user.js"
            text = user.read_text() if user.exists() else ""
            if PREF not in text:
                user.write_text(text + PREF)
