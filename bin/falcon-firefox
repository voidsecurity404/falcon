#!/usr/bin/env python3
"""Copies the glass look and wallpaper colors into every Firefox profile. Firefox reads them when it starts.

Only touches chrome/userChrome.css of a profile when this script wrote it, or when it does not exist.
"""
from pathlib import Path

MARK = "/* falcon */\n"
PREFS = (
    'user_pref("toolkit.legacyUserProfileCustomizations.stylesheets", true);\n',
    # Lets the window show what is behind it.
    'user_pref("widget.transparent-windows", true);\n',
    # A page with no background of its own gets the usual one, or its dark text would land on the glass.
    'user_pref("browser.tabs.allow_transparent_browser", false);\n',
    # Sites that have a dark look use it.
    'user_pref("layout.css.prefers-color-scheme.content-override", 0);\n',
)
# Lines of user.js from the earlier look, which restyled every site.
STALE = (
    'user_pref("browser.tabs.allow_transparent_browser", true);\n',
    'user_pref("layout.css.scroll-driven-animations.enabled", true);\n',
    'user_pref("gfx.webrender.svg-filter-effects.fetile", true);\n',
)
HOME = Path.home()
SOURCE = HOME / ".local/state/falcon/firefox-userChrome.css"
# Opens the previous windows and tabs, so a restored Firefox window has what it had.
RESUME = 'user_pref("browser.startup.page", 3);\n'

for root in (HOME / ".config/mozilla/firefox", HOME / ".mozilla/firefox"):
    for prefs in root.glob("*/prefs.js"):
        user = prefs.parent / "user.js"
        text = user.read_text() if user.exists() else ""
        if RESUME not in text:
            user.write_text(text + RESUME)

if SOURCE.exists():
    css = MARK + SOURCE.read_text()
    for root in (HOME / ".config/mozilla/firefox", HOME / ".mozilla/firefox"):
        for prefs in root.glob("*/prefs.js"):
            profile = prefs.parent
            target = profile / "chrome/userChrome.css"
            if target.exists() and not target.read_text().startswith(MARK):
                continue
            target.parent.mkdir(exist_ok=True)
            target.write_text(css)
            # Sites are left alone, so the sheet this script used to write for them goes.
            content = profile / "chrome/userContent.css"
            if content.exists() and content.read_text().startswith(MARK):
                content.unlink()
            user = profile / "user.js"
            text = user.read_text() if user.exists() else ""
            for line in STALE:
                text = text.replace(line, "")
            missing = "".join(pref for pref in PREFS if pref not in text)
            user.write_text(text + missing)
