#!/usr/bin/env python3
"""Saves open windows and restores them after a reboot.

  niri-desk-session save     save the state
  niri-desk-session restore  restore (does nothing when windows are open)

Only the app is restored, not its arguments, so a one-off terminal command never runs again.
"""
import json
import os
import shutil
import subprocess
import sys
import time
from pathlib import Path

STATE = Path(os.environ.get("XDG_STATE_HOME", Path.home() / ".local/state")) / "niri-desk"
FILE = STATE / "session.json"
CONFIG = Path(os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config")) / "niri-desk"
SKIP = {"org.quickshell", "niri-desk-scratch", "niri-desk-tool", "com.gabm.satty"}


def niri_json(what):
    return json.loads(subprocess.run(["niri", "msg", "--json", what], capture_output=True, text=True, check=True).stdout)


def action(*args):
    subprocess.run(["niri", "msg", "action", *map(str, args)], capture_output=True, check=False)


def executable(pid):
    try:
        argv = Path(f"/proc/{pid}/cmdline").read_bytes().split(b"\0")[0].decode()
    except (OSError, UnicodeDecodeError):
        return ""
    return os.path.basename(argv)


def save():
    workspaces = {w["id"]: w["idx"] for w in niri_json("workspaces")}
    outputs = niri_json("outputs")
    width = next(iter(outputs.values()), {}).get("logical", {}).get("width", 1920) if isinstance(outputs, dict) else 1920
    items = []
    for w in niri_json("windows"):
        app = w.get("app_id") or ""
        if app in SKIP or w.get("workspace_id") not in workspaces or not w.get("pid"):
            continue
        exe = executable(w["pid"])
        if not exe:
            continue
        pos = (w.get("layout") or {}).get("pos_in_scrolling_layout") or [999, 1]
        items.append({
            "app": app,
            "exe": exe,
            "workspace": workspaces[w["workspace_id"]],
            "column": pos[0],
            "row": pos[1],
            "floating": w.get("is_floating", False),
            "share": round((w.get("layout") or {}).get("tile_size", [0])[0] / width, 3) if width else 0,
        })
    items.sort(key=lambda i: (i["workspace"], i["column"], i["row"]))
    STATE.mkdir(parents=True, exist_ok=True)
    tmp = FILE.with_suffix(".tmp")
    tmp.write_text(json.dumps(items, ensure_ascii=False, indent=1))
    os.replace(tmp, FILE)


def enabled():
    for name in ("settings.json", "defaults.json"):
        try:
            value = json.loads((CONFIG / name).read_text() or "{}").get("session", {}).get("restore")
        except (OSError, ValueError):
            continue
        if value is not None:
            return value
    return True


def restore(force):
    if not force and not enabled():
        return 0
    if niri_json("windows"):
        return 0
    try:
        items = json.loads(FILE.read_text())
    except (OSError, ValueError):
        return 0
    opened = 0
    for item in items:
        exe = item.get("exe", "")
        if not exe or "/" in exe or not shutil.which(exe):
            continue
        before = {w["id"] for w in niri_json("windows")}
        action("focus-workspace", item.get("workspace", 1))
        time.sleep(0.15)
        action("spawn", "--", exe)
        end = time.time() + 10
        new = set()
        while time.time() < end and not new:
            new = {w["id"] for w in niri_json("windows")} - before
            time.sleep(0.15)
        if new:
            opened += 1
            time.sleep(0.5)
            share = item.get("share") or 0
            if 0.1 < share <= 1 and not item.get("floating"):
                action("set-column-width", f"{round(share * 100, 1)}%")
            if item.get("floating"):
                action("move-window-to-floating")
    action("focus-workspace", 1)
    return 0


def main():
    args = sys.argv[1:]
    if args[:1] == ["save"]:
        save()
        return 0
    if args[:1] == ["restore"]:
        return restore("--force" in args)
    print(__doc__.strip(), file=sys.stderr)
    return 2


sys.exit(main())
