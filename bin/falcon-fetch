#!/usr/bin/env python3
"""Terminal greeting: fastfetch, then the logo keeps moving in its place.

The look comes from the `fetch` settings (Settings, Fastfetch page):
  fetch.enabled    show the greeting at all
  fetch.style      one of STYLES: which lines fastfetch prints and how
  fetch.animation  one of ANIMATIONS: how the logo moves
  fetch.seconds    length of one loop of the animation
The logo takes the theme's accent from colors.json, so it follows the wallpaper.

fastfetch draws the logo once. This script writes a config for the chosen
style, prints fastfetch's output itself and finds where the logo landed.

In kitty (not inside tmux) the text logo is replaced by an animated picture
sent through kitty's graphics protocol. kitty plays it by itself, forever, and
the picture belongs to those cells, so it keeps moving while commands run,
while the output scrolls and in the scrollback. No process stays behind.
Frames are cached in ~/.cache/falcon/fetch and kitty reads them from there.
When the frames for the current color are not made yet, a still picture of the
logo stands in and a background process makes them and starts the animation,
so the prompt never waits for them.

  --recolor            run by `falcon-apply --colors`: repaints, in the new accent,
                       the logos still playing in open terminals (each is recorded
                       as img-<id>.json in the runtime folder) and makes the frames
                       the next greeting will want

Elsewhere a small background process redraws that spot as text instead, and
it stops by itself when:
  - `falcon-fetch --stop` runs (fish calls it before every command and on Ctrl+L),
  - the shell that started it exits,
  - the terminal changes size.
It writes each frame as one write between a cursor save and restore, so the
prompt and what the user types stay where they are.

For the Settings page:
  --previews           prints {"logos": {name: png}}, then one {"logo", "animation", "path"}
                       line per animated WebP, for every logo and animation
  --preview-text STYLE prints {"html", "background", "foreground"}: that style's
                       lines as rich text in the terminal's colors
"""
import colorsys
import fcntl
import hashlib
import json
import math
import os
import random
import re
import select
import shutil
import signal
import struct
import subprocess
import sys
import termios
import time
import tty
import zlib

FPS = 24
LOGO_LINES = 14
LOGO_COL = 2                # padding.left 1 in the config
BRAND = os.path.expanduser("~/.config/fastfetch/brand.txt")
LOGO_DIR = os.path.expanduser("~/.config/fastfetch/logos")
LOGO_WIDTH = 22
CONFIG = os.environ.get("XDG_CONFIG_HOME") or os.path.expanduser("~/.config")
STATE = os.environ.get("XDG_STATE_HOME") or os.path.expanduser("~/.local/state")
CACHE = os.path.join(os.environ.get("XDG_CACHE_HOME") or os.path.expanduser("~/.cache"),
                     "falcon", "fetch")
MIRROR = str.maketrans("/\\()[]{}<>", "\\/)(][}{><")
ANSI = re.compile(r"\x1b\[[0-9;]*[A-Za-z]")
FALLBACK_ACCENT = (255, 52, 58)
VERSION = 3

ANIMATIONS = ["spin", "flip", "swing", "bounce", "assemble", "decode", "aurora"]
# "brand" is brand.txt, the others are logos/<name>.txt. Each fits 22 columns and 14 rows.
LOGOS = ["brand", "falcon", "sword", "skull", "moon", "mountain", "flame", "eye", "crystal",
         "bolt", "planet"]
DEFAULTS = {"enabled": True, "style": "classic", "animation": "spin", "seconds": 3.2,
            "logo": "brand"}
LOGO = "brand"              # the logo load_logo() reads, set from the settings


# ---------------------------------------------------------------- settings

def merge(base, over):
    out = dict(base)
    for key, value in over.items():
        if isinstance(value, dict) and isinstance(out.get(key), dict):
            out[key] = merge(out[key], value)
        else:
            out[key] = value
    return out


def settings():
    merged = {}
    for name in ("defaults.json", "settings.json"):
        try:
            with open(os.path.join(CONFIG, "falcon", name)) as f:
                data = json.load(f)
            if isinstance(data, dict):
                merged = merge(merged, data)
        except (OSError, ValueError):
            pass
    fetch = merged.get("fetch") if isinstance(merged.get("fetch"), dict) else {}
    out = dict(DEFAULTS, **fetch)
    if out["style"] not in STYLES:
        out["style"] = DEFAULTS["style"]
    if out["animation"] not in ANIMATIONS:
        out["animation"] = DEFAULTS["animation"]
    if out["logo"] not in LOGOS or not os.path.exists(logo_source(out["logo"])):
        out["logo"] = DEFAULTS["logo"]
    global LOGO
    LOGO = out["logo"]
    try:
        out["seconds"] = min(8.0, max(1.5, float(out["seconds"])))
    except (TypeError, ValueError):
        out["seconds"] = DEFAULTS["seconds"]
    return out


def accent():
    try:
        with open(os.path.join(STATE, "falcon", "colors.json")) as f:
            value = json.load(f)["accent"].lstrip("#")
        return tuple(int(value[i:i + 2], 16) for i in (0, 2, 4))
    except (OSError, ValueError, KeyError, TypeError):
        return FALLBACK_ACCENT


def scaled(color, k):
    return tuple(max(0, min(255, round(v * k))) for v in color)


def mixed(a, b, k):
    return tuple(round(x + (y - x) * k) for x, y in zip(a, b))


def hue_turn(color, turn):
    h, l, s = colorsys.rgb_to_hls(*(v / 255 for v in color))
    r, g, b = colorsys.hls_to_rgb((h + turn) % 1, min(0.75, max(0.5, l)), max(0.6, s))
    return (round(r * 255), round(g * 255), round(b * 255))


WHITE = (255, 255, 255)


# ---------------------------------------------------------------- styles

SHELL = ("n=\"${FALCON_SHELL:-$(ps -o comm= -p $(ps -o ppid= -p $PPID) 2>/dev/null)}\"; "
         "echo \"${n:-$(basename \"$SHELL\")}\"")
MODULES = {
    "os": {"type": "os", "format": "{name}"},
    "host": {"type": "host", "format": "{name}"},
    "kernel": {"type": "kernel", "format": "{release}"},
    "uptime": {"type": "uptime"},
    "packages": {"type": "packages", "format": "{all}"},
    "shell": {"type": "command", "text": SHELL},
    "desktop": {"type": "custom", "format": "Falcon"},
    "wm": {"type": "wm", "format": "{pretty-name}"},
    "terminal": {"type": "terminal", "format": "{pretty-name}"},
    "display": {"type": "display", "format": "{width}x{height} {refresh-rate} Hz"},
    "cpu": {"type": "cpu", "format": "{name}"},
    "gpu": {"type": "gpu", "format": "{name}"},
    "memory": {"type": "memory", "format": "{used} / {total}"},
    "swap": {"type": "swap", "format": "{used} / {total}"},
    "disk": {"type": "disk", "folders": "/", "format": "{size-used} / {size-total}"},
    "battery": {"type": "battery", "format": "{capacity} {status}"},
}
BARS = {
    "memory": "{percentage-bar} {percentage}",
    "swap": "{percentage-bar} {percentage}",
    "disk": "{size-percentage-bar} {size-percentage}",
    "battery": "{capacity-bar} {capacity}",
}
ICONS = {
    "os": "", "kernel": "", "uptime": "\U000f0150", "packages": "\U000f03d6",
    "shell": "", "wm": "", "terminal": "", "display": "\U000f0379",
    "cpu": "\U000f0ee0", "gpu": "\U000f08ae", "memory": "\U000f035b", "disk": "\U000f02ca",
    "battery": "\U000f0079",
}


def mod(name, key=None, **extra):
    out = dict(MODULES[name])
    out["key"] = name if key is None else key
    out.update(extra)
    return out


def head(text):
    return {"type": "custom", "format": "{#1;34}" + text + "{#}"}


def line(text):
    return {"type": "custom", "format": "{#34}" + text + "{#}"}


def style_classic():
    names = ["os", "host", "kernel", "uptime", "packages", "shell", "desktop", "wm", "terminal",
             "display", "cpu", "gpu", "memory", "swap", "disk", "battery"]
    return {}, [mod(n) for n in names]


def style_minimal():
    names = ["os", "kernel", "uptime", "wm", "shell", "memory"]
    return {"key": {"width": 9}}, [mod(n) for n in names]


def style_boxed():
    names = ["os", "kernel", "uptime", "packages", "shell", "wm", "terminal", "cpu", "gpu",
             "memory", "disk", "battery"]
    rows = [line("╭─ falcon ─────────────────────")]
    rows += [mod(n, "│ " + n) for n in names]
    rows.append(line("╰──────────────────────────────"))
    return {"key": {"width": 12}}, rows


def style_tree():
    groups = [("system", ["os", "kernel", "uptime", "packages"]),
              ("desktop", ["wm", "shell", "terminal"]),
              ("hardware", ["cpu", "gpu", "memory", "disk"])]
    rows = []
    for title, names in groups:
        rows.append(head(title))
        for i, n in enumerate(names):
            rows.append(mod(n, ("└─ " if i == len(names) - 1 else "├─ ") + n))
    return {"key": {"width": 13}}, rows


def style_icons():
    names = ["os", "kernel", "uptime", "packages", "shell", "wm", "terminal", "display", "cpu",
             "gpu", "memory", "disk", "battery"]
    return {"key": {"width": 12}}, [mod(n, ICONS[n] + "  " + n) for n in names]


def style_hardware():
    names = ["host", "cpu", "gpu", "display", "memory", "swap", "disk", "battery", "kernel"]
    return {}, [head("hardware"), line("────────")] + [mod(n) for n in names]


def style_bars():
    rows = [mod(n) for n in ["os", "kernel", "uptime", "wm", "packages"]]
    rows.append(line(""))
    rows += [mod(n, format=BARS[n]) for n in ["memory", "swap", "disk", "battery"]]
    extra = {"bar": {"char": {"elapsed": "■", "total": "·"}, "width": 14,
                     "border": {"left": "", "right": ""}},
             "percent": {"type": 11, "color": {"green": "blue", "yellow": "blue", "red": "blue"}}}
    return extra, rows


def style_palette():
    rows = [{"type": "title", "format": "{#1;34}{user-name}{#}@{#1;34}{host-name}{#}"},
            {"type": "separator", "string": "─"}]
    rows += [mod(n) for n in ["os", "kernel", "uptime", "packages", "wm", "shell", "terminal",
                              "memory"]]
    rows += ["break", {"type": "colors", "symbol": "circle"}]
    return {}, rows


def style_arrows():
    names = ["os", "kernel", "uptime", "packages", "shell", "wm", "terminal", "cpu", "memory",
             "disk", "battery"]
    return {"separator": " ➜  ", "key": {"width": 0}}, [mod(n) for n in names]


def style_quiet():
    names = ["os", "kernel", "uptime", "wm", "shell", "terminal", "cpu", "memory", "disk"]
    rows = []
    for n in names:
        value = MODULES[n].get("format", "{1}")
        if n == "uptime":
            value = "{?days}{days}d {?}{hours}h {minutes}m"
        rows.append(mod(n, " ", format="{#34}·{#} " + value))
    return {}, rows


STYLES = {
    "classic": style_classic, "minimal": style_minimal, "boxed": style_boxed,
    "tree": style_tree, "icons": style_icons, "hardware": style_hardware, "bars": style_bars,
    "palette": style_palette, "arrows": style_arrows, "quiet": style_quiet,
}


def config_file(style, logo=True):
    """Writes the fastfetch config of a style to the runtime folder, returns its path."""
    extra, modules = STYLES[style]()
    if not logo:
        # The preview runs under the shell, not a terminal: name the one the greeting runs in.
        modules = [dict(m, type="custom", format=m["format"].replace("{pretty-name}", "kitty"))
                   if isinstance(m, dict) and m.get("type") == "terminal" else m for m in modules]
    display = {"separator": "  ", "key": {"width": 10}, "color": {"keys": "blue"}}
    display = merge(display, extra)
    data = {
        "logo": ({"type": "file-raw", "source": logo_file(), "width": LOGO_WIDTH,
                  "height": LOGO_LINES,
                  "padding": {"left": LOGO_COL - 1, "right": 3}} if logo else {"type": "none"}),
        "display": display,
        "modules": modules,
    }
    folder = runtime_dir()
    path = os.path.join(folder, f"style-{style}{'' if logo else '-bare'}.jsonc")
    text = json.dumps(data, ensure_ascii=False, indent=1)
    try:
        with open(path) as f:
            same = f.read() == text
    except OSError:
        same = False
    if not same:
        with open(path + ".tmp", "w") as f:
            f.write(text)
        os.replace(path + ".tmp", path)
    return path


def runtime_dir():
    base = os.environ.get("XDG_RUNTIME_DIR") or f"/tmp/falcon-{os.getuid()}"
    path = os.path.join(base, "falcon-fetch")
    os.makedirs(path, exist_ok=True)
    return path


def pid_file(shell):
    return os.path.join(runtime_dir(), str(shell))


def stop(shell):
    path = pid_file(shell)
    try:
        with open(path) as f:
            pid = int(f.read().strip())
        os.kill(pid, signal.SIGTERM)
    except (OSError, ValueError):
        pass
    try:
        os.remove(path)
    except OSError:
        pass


def cursor_row(fd):
    """Ask the terminal where the cursor is. Returns the row, or None."""
    old = termios.tcgetattr(fd)
    try:
        tty.setcbreak(fd, termios.TCSANOW)
        os.write(fd, b"\x1b[6n")
        reply = b""
        end = time.monotonic() + 0.3
        while not reply.endswith(b"R"):
            left = end - time.monotonic()
            if left <= 0 or not select.select([fd], [], [], left)[0]:
                return None
            reply += os.read(fd, 32)
        m = re.search(rb"\x1b\[(\d+);(\d+)R", reply)
        return int(m.group(1)) if m else None
    finally:
        termios.tcsetattr(fd, termios.TCSANOW, old)


def term_size(fd):
    rows, cols, _, _ = struct.unpack("HHHH", fcntl.ioctl(fd, termios.TIOCGWINSZ, b"\0" * 8))
    return rows, cols


def logo_source(name):
    return BRAND if name == "brand" else os.path.join(LOGO_DIR, name + ".txt")


def load_logo(name=None):
    """The logo as LOGO_LINES rows of LOGO_WIDTH characters, centered up and down."""
    with open(logo_source(name or LOGO)) as f:
        lines = [ANSI.sub("", l.rstrip("\n")).rstrip() for l in f]
    while lines and not lines[-1]:
        lines.pop()
    lines = [l[:LOGO_WIDTH] for l in lines[:LOGO_LINES]]
    top = (LOGO_LINES - len(lines)) // 2
    lines = [""] * top + lines + [""] * (LOGO_LINES - len(lines) - top)
    return [l.ljust(LOGO_WIDTH) for l in lines], LOGO_WIDTH


def logo_file():
    """The chosen logo padded and colored for fastfetch, in the runtime folder."""
    lines, _ = load_logo()
    text = "".join(f"\x1b[1;34m{l}\x1b[0m\n" for l in lines)
    path = os.path.join(runtime_dir(), f"logo-{LOGO}.txt")
    try:
        with open(path) as f:
            same = f.read() == text
    except OSError:
        same = False
    if not same:
        with open(path + ".tmp", "w") as f:
            f.write(text)
        os.replace(path + ".tmp", path)
    return path


# ---------------------------------------------------------------- shared timing
# Each animation is one loop of `count` frames, t = i / count from 0 to 1.

SCRAMBLE = "01$#@%&*+=<>/\\{}[]?!ABCDEFXYZ"
MIRROR_V = str.maketrans("/\\^v'`,.", "\\/v^,.'`")


def ease_out(p):
    p = min(1.0, max(0.0, p))
    return 1 - (1 - p) ** 3


def ease_in(p):
    p = min(1.0, max(0.0, p))
    return p ** 3


def flip_angle(t):
    """Flip: a full tumble around the horizontal axis, with a short rest facing the viewer."""
    if t < 0.25:
        return 0.0
    p = (t - 0.25) / 0.75
    return 2 * math.pi * (p * p * (3 - 2 * p))


def swing_angle(t):
    """Swing: rocks like a hanging sign, up to about 49 degrees each way."""
    return 0.85 * math.sin(2 * math.pi * t)


def bounce_state(t):
    """Bounce: (height 0..1, squash) for one jump that lands and settles."""
    if t < 0.62:
        p = t / 0.62
        height = 4 * p * (1 - p)
        squash = 0.0
        if p < 0.08:
            squash = -(1 - p / 0.08) * 0.6          # stretched as it leaves the ground
    else:
        p = (t - 0.62) / 0.38
        height = 0.0
        squash = math.exp(-5 * p) * math.cos(3 * math.pi * p)   # lands, wobbles, settles
    return height, squash


def cell_plan(lines, width, salt):
    """The same random choices for every frame of one loop: per drawn cell."""
    rnd = random.Random(salt)
    plan = {}
    for y, row in enumerate(lines):
        for x, c in enumerate(row):
            if c != " ":
                angle = rnd.uniform(0, 2 * math.pi)
                plan[(x, y)] = {
                    "dx": math.cos(angle) * rnd.uniform(4, 11),
                    "dy": math.sin(angle) * rnd.uniform(2, 6),
                    "delay": rnd.uniform(0, 0.22),
                    "reveal": 0.06 + rnd.uniform(0, 0.38),
                    "leave": 0.80 + rnd.uniform(0, 0.15),
                    "seed": rnd.randint(0, 1 << 30),
                }
    return plan


def assemble_place(cell, t):
    """Assemble: (offset in cells, alpha) of one character."""
    p_in = ease_out((t - cell["delay"]) / 0.28)
    if t < 0.62:
        k = 1 - p_in
        return cell["dx"] * k, cell["dy"] * k, p_in
    p_out = ease_in((t - 0.74 - cell["delay"] * 0.4) / 0.2)
    return cell["dx"] * p_out * 1.4, cell["dy"] * p_out * 1.4, 1 - p_out


def decode_char(cell, c, t, i):
    """Decode: (character, kind) of one cell; kind is None, "noise", "flash" or "real"."""
    rnd = random.Random(cell["seed"] + i // 2)
    if t >= cell["leave"]:
        return None, None
    if t >= cell["leave"] - 0.07:
        return rnd.choice(SCRAMBLE), "noise"
    if t >= cell["reveal"]:
        return c, ("flash" if t - cell["reveal"] < 0.05 else "real")
    if t >= cell["reveal"] - 0.22:
        return rnd.choice(SCRAMBLE), "noise"
    return None, None


def aurora_tone(color, u):
    """Aurora: a color that flows between the accent and its neighbours, u in 0..1."""
    k = 0.5 + 0.5 * math.sin(2 * math.pi * u)
    q = 0.5 + 0.5 * math.sin(2 * math.pi * u * 2 + 1.3)
    warm = mixed(hue_turn(color, 0.2), WHITE, 0.25)
    cool = hue_turn(color, -0.2)
    return mixed(mixed(color, warm, k), cool, q * 0.45)


# ---------------------------------------------------------------- text frames
# Each frame is a grid of (character, color or None) for the text fallback.

def text_grid(anim, lines, width, color, i, count, plan):
    t = i / count
    h = len(lines)
    mid = (width - 1) / 2
    vmid = (h - 1) / 2
    empty = [[(" ", None) for _ in range(width)] for _ in range(h)]
    if anim == "spin":
        c = math.cos(2 * math.pi * t)
        squeeze = max(abs(c), 0.06)
        back = c < 0
        tone = scaled(scaled(color, 0.72) if back else color, 0.6 + 0.4 * abs(c))
        out = []
        for row in lines:
            cells = []
            for x in range(width):
                u = (x - mid) / squeeze
                if back:
                    u = -u
                src = round(mid + u)
                ch = row[src] if 0 <= src < width else " "
                ch = ch.translate(MIRROR) if back else ch
                cells.append((ch, tone))
            out.append(cells)
        return out
    if anim == "flip":
        c = math.cos(flip_angle(t))
        squeeze = max(abs(c), 0.08)
        back = c < 0
        tone = scaled(scaled(color, 0.72) if back else color, 0.6 + 0.4 * abs(c))
        out = []
        for y in range(h):
            v = (y - vmid) / squeeze
            if back:
                v = -v
            src = round(vmid + v)
            row = lines[src] if 0 <= src < h else " " * width
            row = row.translate(MIRROR_V) if back else row
            out.append([(ch, tone) for ch in row])
        return out
    if anim == "swing":
        a = swing_angle(t)
        squeeze = math.cos(a)
        out = []
        for row in lines:
            cells = []
            for x in range(width):
                src = round(mid + (x - mid) / squeeze)
                ch = row[src] if 0 <= src < width else " "
                near = 0.5 + 0.5 * math.sin(a) * (x - mid) / mid
                cells.append((ch, scaled(color, 0.7 + 0.3 * near)))
            out.append(cells)
        return out
    if anim == "bounce":
        height, _ = bounce_state(t)
        lift = round(height * 3)
        out = [row for row in lines[lift:]] + [" " * width] * lift
        return [[(ch, color) for ch in row] for row in out]
    if anim == "assemble":
        out = [row[:] for row in empty]
        for (x, y), cell in plan.items():
            dx, dy, alpha = assemble_place(cell, t)
            nx, ny = round(x + dx), round(y + dy)
            if alpha > 0.15 and 0 <= nx < width and 0 <= ny < h:
                out[ny][nx] = (lines[y][x], scaled(color, 0.4 + 0.6 * alpha))
        return out
    if anim == "decode":
        out = [row[:] for row in empty]
        light = mixed(color, WHITE, 0.55)
        for (x, y), cell in plan.items():
            ch, kind = decode_char(cell, lines[y][x], t, i)
            if ch:
                tone = {"noise": scaled(light, 0.75), "flash": WHITE, "real": color}[kind]
                out[y][x] = (ch, tone)
        return out
    if anim == "aurora":
        return [[(ch, aurora_tone(color, x / width * 0.6 + y / h * 0.4 - t) if ch != " " else None)
                 for x, ch in enumerate(row)] for y, row in enumerate(lines)]
    return [[(ch, color) for ch in row] for row in lines]


def text_frames(anim, seconds, color):
    """Every frame of one loop, as ready-to-write rows."""
    lines, width = load_logo()
    plan = cell_plan(lines, width, 7)
    count = max(2, round(FPS * seconds))
    out = []
    for i in range(count):
        rows = []
        for cells in text_grid(anim, lines, width, color, i, count, plan):
            text, last = [], "none"
            for ch, c in cells:
                if c is not None and c != last:
                    text.append("\x1b[1;38;2;%d;%d;%dm" % c)
                    last = c
                text.append(ch)
            rows.append("".join(text) + "\x1b[0m")
        out.append(rows)
    return out


# ---------------------------------------------------------------- picture frames

def kitty_ok():
    return (os.environ.get("TERM") == "xterm-kitty" and os.environ.get("KITTY_WINDOW_ID")
            and not os.environ.get("TMUX"))


def font_file():
    # fc-match takes about 30 ms, so its answer is kept for the session.
    memo = os.path.join(runtime_dir(), "font")
    try:
        with open(memo) as f:
            path = f.read().strip()
        if os.path.exists(path):
            return path
    except OSError:
        pass
    path = ask_font()
    if path:
        try:
            with open(memo, "w") as f:
                f.write(path)
        except OSError:
            pass
    return path


def ask_font():
    try:
        out = subprocess.run(["fc-match", "-f", "%{file}", "Geist Mono:bold"],
                             stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, text=True).stdout
        return out.strip() or None
    except OSError:
        return None


class Art:
    """The logo drawn at one cell size: its whole mask and single glyphs for moving characters.
    The picture has one spare column on each side."""

    def __init__(self, cw, ch, font, name=None):
        import numpy as np
        from PIL import Image, ImageDraw, ImageFont
        self.lines, self.width = load_logo(name)
        self.cw, self.ch = cw, ch
        probe = ImageFont.truetype(font, 100)
        self.face = ImageFont.truetype(font, 100 * cw / probe.getlength("M"))
        try:
            self.face.set_variation_by_axes([700])
        except Exception:
            pass
        ascent, descent = self.face.getmetrics()
        self.lift = (ch - ascent - descent) / 2
        self.w, self.h = (self.width + 2) * cw, len(self.lines) * ch
        mask = Image.new("L", (self.w, self.h), 0)
        draw = ImageDraw.Draw(mask)
        for y, row in enumerate(self.lines):
            for x, c in enumerate(row):
                if c != " ":
                    draw.text(((x + 1) * cw, y * ch + self.lift), c, fill=255, font=self.face)
        self.mask = np.asarray(mask, dtype=np.float32) / 255
        self.shape = self.mask.shape
        self.pad = cw
        self.glyphs = {}
        self.plan = cell_plan(self.lines, self.width, 7)

    def glyph(self, c):
        import numpy as np
        from PIL import Image, ImageDraw
        if c not in self.glyphs:
            img = Image.new("L", (self.cw + 2 * self.pad, self.ch + 2 * self.pad), 0)
            ImageDraw.Draw(img).text((self.pad, self.pad + self.lift), c, fill=255, font=self.face)
            self.glyphs[c] = np.asarray(img, dtype=np.float32) / 255
        return self.glyphs[c]

    def chars(self, items):
        """Draws characters at free places: items of (x px, y px, char, alpha, color)."""
        import numpy as np
        a = np.zeros(self.shape, dtype=np.float32)
        rgb = np.zeros(self.shape + (3,), dtype=np.float32)
        for px, py, c, alpha, color in items:
            g = self.glyph(c)
            x0, y0 = int(round(px)) - self.pad, int(round(py)) - self.pad
            gx0, gy0 = max(0, -x0), max(0, -y0)
            x1, y1 = min(self.w, x0 + g.shape[1]), min(self.h, y0 + g.shape[0])
            if x1 <= max(x0, 0) or y1 <= max(y0, 0):
                continue
            part = g[gy0:gy0 + y1 - max(y0, 0), gx0:gx0 + x1 - max(x0, 0)] * alpha
            sl = (slice(max(y0, 0), y1), slice(max(x0, 0), x1))
            low = a[sl]
            new = part + low * (1 - part)
            safe = np.where(new > 0, new, 1)[..., None]
            rgb[sl] = (np.array(color, dtype=np.float32) * part[..., None]
                       + rgb[sl] * (low * (1 - part))[..., None]) / safe
            a[sl] = new
        return a, rgb


def quad_coeffs(dest, src):
    """PIL perspective coefficients that map the dest corners onto the src corners."""
    import numpy as np
    rows = []
    for (x, y), (u, v) in zip(dest, src):
        rows.append([x, y, 1, 0, 0, 0, -u * x, -u * y])
        rows.append([0, 0, 0, x, y, 1, -v * x, -v * y])
    return np.linalg.solve(np.array(rows, dtype=np.float64),
                           np.array([c for p in src for c in p], dtype=np.float64)).tolist()


def warp(mask, corners):
    """The mask laid onto four corners (top left, top right, bottom right, bottom left)."""
    import numpy as np
    from PIL import Image
    h, w = mask.shape
    img = Image.fromarray((mask * 255).astype("uint8"), "L")
    try:
        coeffs = quad_coeffs(corners, [(0, 0), (w, 0), (w, h), (0, h)])
    except Exception:
        return np.zeros_like(mask)
    out = img.transform((w, h), Image.PERSPECTIVE, coeffs, Image.BICUBIC)
    return np.asarray(out, dtype=np.float32) / 255


def turned(art, yaw=0.0, pitch=0.0, scale=1.0):
    """The logo turned around its middle, seen with perspective. Returns (alpha, facing)."""
    w, h = art.w, art.h
    depth = 1.9 * max(w, h)
    corners = []
    for x, y in ((-w / 2, -h / 2), (w / 2, -h / 2), (w / 2, h / 2), (-w / 2, h / 2)):
        x, y = x * scale, y * scale
        z = 0.0
        # around the vertical axis, then the horizontal one
        x, z = x * math.cos(yaw), x * math.sin(yaw)
        y, z = y * math.cos(pitch) - z * math.sin(pitch), y * math.sin(pitch) + z * math.cos(pitch)
        f = depth / (depth + z)
        corners.append((w / 2 + x * f, h / 2 + y * f))
    return warp(art.mask, corners), math.cos(yaw) * math.cos(pitch)


def shade_across(art, yaw, color):
    """Near side lighter, far side darker, for a turned logo."""
    import numpy as np
    xs = np.linspace(-1, 1, art.w, dtype=np.float32)
    k = 0.72 + 0.28 * np.sin(yaw) * xs
    return np.array(color, dtype=np.float32)[None, None, :] * k[None, :, None] * np.ones(
        (art.h, 1, 1), dtype=np.float32)


def picture_frame(anim, art, color, i, count):
    """One frame as (alpha, rgb) float arrays."""
    import numpy as np
    from PIL import Image
    t = i / count
    mask, cw, ch = art.mask, art.cw, art.ch
    h, w = mask.shape
    if anim == "spin":
        c = math.cos(2 * math.pi * t)
        back = c < 0
        tone = scaled(scaled(color, 0.72) if back else color, 0.6 + 0.4 * abs(c))
        narrow = max(1, round(w * max(abs(c), 0.04)))
        img = Image.fromarray((mask * 255).astype("uint8"), "L").resize((narrow, h), Image.LANCZOS)
        if back:
            img = img.transpose(Image.FLIP_LEFT_RIGHT)
        a = np.zeros_like(mask)
        left = (w - narrow) // 2
        a[:, left:left + narrow] = np.asarray(img, dtype=np.float32) / 255
        return a, solid(tone, mask.shape)
    if anim == "flip":
        angle = flip_angle(t)
        c = math.cos(angle)
        if abs(c) < 0.03:
            angle = math.acos(math.copysign(0.03, c))
        a, facing = turned(art, pitch=angle, scale=0.8)
        back = c < 0
        tone = scaled(scaled(color, 0.72) if back else color, 0.6 + 0.4 * abs(c))
        return a, solid(tone, mask.shape)
    if anim == "swing":
        yaw = swing_angle(t)
        a, _ = turned(art, yaw=yaw, scale=0.86)
        return a, shade_across(art, yaw, color)
    if anim == "bounce":
        height, squash = bounce_state(t)
        base = 0.78
        sy = base * (1 - 0.16 * squash)
        sx = base * (1 + 0.1 * squash)
        nw, nh = max(1, round(w * sx)), max(1, round(h * sy))
        img = Image.fromarray((mask * 255).astype("uint8"), "L").resize((nw, nh), Image.LANCZOS)
        bottom = h - 0.05 * h - height * (h - 0.05 * h - nh)
        x0, y0 = (w - nw) // 2, int(round(bottom - nh))
        a = np.zeros_like(mask)
        ys0, ys1 = max(0, y0), min(h, y0 + nh)
        a[ys0:ys1, x0:x0 + nw] = (np.asarray(img, dtype=np.float32) / 255)[ys0 - y0:ys1 - y0]
        # A soft shadow on the ground, smaller and fainter while it is up.
        yy, xx = np.mgrid[0:h, 0:w].astype(np.float32)
        rx = w * 0.32 * (1 - 0.45 * height)
        ry = h * 0.02 + 1
        shadow = np.clip(1 - ((xx - w / 2) / rx) ** 2 - ((yy - h * 0.975) / ry) ** 2, 0, 1)
        shadow = shadow * 0.45 * (1 - 0.7 * height)
        return over(a, solid(color, mask.shape), shadow, solid(scaled(color, 0.45), mask.shape))
    if anim == "assemble":
        items = []
        for (x, y), cell in art.plan.items():
            dx, dy, alpha = assemble_place(cell, t)
            if alpha > 0.01:
                tone = mixed(color, WHITE, 0.5 * (1 - alpha))
                items.append(((x + 1 + dx) * cw, (y + dy) * ch, art.lines[y][x], alpha, tone))
        return art.chars(items)
    if anim == "decode":
        items = []
        light = mixed(color, WHITE, 0.55)
        for (x, y), cell in art.plan.items():
            c, kind = decode_char(cell, art.lines[y][x], t, i)
            if c:
                tone, alpha = {"noise": (light, 0.55), "flash": (WHITE, 1.0), "real": (color, 1.0)}[kind]
                items.append(((x + 1) * cw, y * ch, c, alpha, tone))
        return art.chars(items)
    if anim == "aurora":
        ys, xs = np.mgrid[0:h, 0:w].astype(np.float32)
        u = xs / w * 0.6 + ys / h * 0.4 - t
        k = (0.5 + 0.5 * np.sin(2 * np.pi * u))[..., None]
        q = (0.5 + 0.5 * np.sin(2 * np.pi * u * 2 + 1.3))[..., None] * 0.45
        base = np.array(color, dtype=np.float32)
        warm = np.array(mixed(hue_turn(color, 0.2), WHITE, 0.25), dtype=np.float32)
        cool = np.array(hue_turn(color, -0.2), dtype=np.float32)
        rgb = base + (warm - base) * k
        rgb = rgb + (cool - rgb) * q
        return mask, rgb
    return mask, solid(color, mask.shape)


def solid(color, shape):
    import numpy as np
    out = np.empty(shape + (3,), dtype=np.float32)
    out[:] = color
    return out


def over(top_a, top_c, low_a, low_c):
    """Paints one layer over another. Colors are (h, w, 3) arrays, alphas (h, w)."""
    import numpy as np
    a = top_a + low_a * (1 - top_a)
    safe = np.where(a > 0, a, 1)[..., None]
    c = (top_c * top_a[..., None] + low_c * (low_a * (1 - top_a))[..., None]) / safe
    return a, c


def to_rgba(a, rgb):
    import numpy as np
    out = np.empty(a.shape + (4,), dtype=np.uint8)
    out[..., :3] = np.clip(rgb, 0, 255).astype(np.uint8)
    out[..., 3] = (np.clip(a, 0, 1) * 255).astype(np.uint8)
    return out


def prune():
    """Keeps the 24 most recently used frame folders."""
    try:
        names = [os.path.join(CACHE, n) for n in os.listdir(CACHE)]
    except OSError:
        return
    folders = sorted((p for p in names if os.path.isdir(p)), key=os.path.getmtime, reverse=True)
    for old in folders[24:]:
        shutil.rmtree(old, ignore_errors=True)


def frame_set(anim, seconds, color, cw, ch):
    """Where the frames of one look live: (paths, w, h, ready, font), or None without a font."""
    lines, width = load_logo()
    font = font_file()
    if not font:
        return None
    count = max(2, round(FPS * seconds))
    key = hashlib.sha1(repr((VERSION, anim, lines, font, os.path.getmtime(font), cw, ch,
                             count, color)).encode()).hexdigest()[:16]
    folder = os.path.join(CACHE, key)
    w, h = (width + 2) * cw, len(lines) * ch
    paths = [os.path.join(folder, f"{i:03}.z") for i in range(count)]
    return paths, w, h, all(os.path.exists(p) for p in paths), font


def picture_frames(anim, seconds, color, cw, ch):
    """Paths of zlib-compressed RGBA frames for one loop, made once per look and cell size."""
    found = frame_set(anim, seconds, color, cw, ch)
    if not found:
        return None, 0, 0
    paths, w, h, ready, font = found
    folder = os.path.dirname(paths[0])
    if ready:
        os.utime(folder)
        return paths, w, h
    art = Art(cw, ch, font)
    os.makedirs(folder, exist_ok=True)
    for i, path in enumerate(paths):
        frame = to_rgba(*picture_frame(anim, art, color, i, len(paths)))
        tmp = f"{path}.{os.getpid()}.tmp"
        with open(tmp, "wb") as f:
            f.write(zlib.compress(frame.tobytes(), 6))
        os.replace(tmp, path)
    prune()
    return paths, w, h


def still_frame(color, cw, ch, font):
    """The whole logo standing still in one color, shown while the frames are being made."""
    path = os.path.join(runtime_dir(), f"still-{LOGO}-{cw}x{ch}-%02x%02x%02x.z" % color)
    if not os.path.exists(path):
        art = Art(cw, ch, font)
        frame = to_rgba(art.mask, solid(color, art.mask.shape))
        tmp = f"{path}.{os.getpid()}.tmp"
        with open(tmp, "wb") as f:
            f.write(zlib.compress(frame.tobytes(), 1))
        os.replace(tmp, path)
    return path


def gfx(keys, path=None):
    data = ";" + __import__("base64").b64encode(path.encode()).decode() if path else ""
    return f"\x1b_G{keys}{data}\x1b\\"


def play(ident, paths, w, h, seconds, replace):
    """Commands that give image `ident` the rest of its frames and start it. With `replace`
    its first frame, a still picture, becomes the animation's first frame in place."""
    gap = round(1000 * seconds / len(paths))
    common = f"i={ident},f=32,s={w},v={h},o=z,t=f,q=2"
    out = [gfx(f"a=f,{common},r=1,X=1", paths[0])] if replace else []
    out += [gfx(f"a=f,{common},z={gap}", p) for p in paths[1:]]
    out.append(gfx(f"a=a,i={ident},r=1,z={gap},q=2"))
    out.append(gfx(f"a=a,i={ident},s=3,v=1,q=2"))
    return "".join(out)


def recolor_frames(ident, paths, w, h, seconds):
    """Replaces every frame of a playing image with new ones of the same size."""
    common = f"i={ident},f=32,s={w},v={h},o=z,t=f,q=2"
    return "".join(gfx(f"a=f,{common},r={i + 1},X=1", p) for i, p in enumerate(paths))


def shell_tty(shell):
    try:
        path = os.readlink(f"/proc/{shell}/fd/0")
    except OSError:
        return None
    return path if path.startswith("/dev/pts/") else None


def register(ident, shell, look, cw, ch, count):
    """Remembers a playing logo, so --recolor can repaint it when the wallpaper changes."""
    tty_path = shell_tty(shell)
    if not tty_path:
        return
    data = {"ident": ident, "shell": shell, "tty": tty_path, "animation": look["animation"],
            "seconds": look["seconds"], "logo": LOGO, "cw": cw, "ch": ch, "count": count}
    with open(os.path.join(runtime_dir(), f"img-{ident}.json"), "w") as f:
        json.dump(data, f)
    with open(os.path.join(runtime_dir(), "cell"), "w") as f:
        json.dump({"cw": cw, "ch": ch}, f)


def detach():
    """Forks. The parent gets True and goes on, the child runs on its own, away from the shell."""
    if os.fork():
        return True
    os.setsid()
    if os.fork():
        os._exit(0)
    devnull = os.open(os.devnull, os.O_RDWR)
    for n in (0, 1, 2):
        os.dup2(devnull, n)
    return False


def picture(fd, top, look, shell):
    """Swap the text logo for an animated picture kitty plays itself. True if done.
    Frames not made yet for this color are made in the background while a still picture of
    the logo stands in, so the terminal is ready at once."""
    rows, cols, xpx, ypx = struct.unpack("HHHH", fcntl.ioctl(fd, termios.TIOCGWINSZ, b"\0" * 8))
    if not (rows and cols and xpx and ypx):
        return False
    cw, ch = xpx // cols, ypx // rows
    color = accent()
    try:
        found = frame_set(look["animation"], look["seconds"], color, cw, ch)
        if not found:
            return False
        paths, w, h, ready, font = found
        if ready:
            os.utime(os.path.dirname(paths[0]))
            first = paths[0]
        else:
            first = still_frame(color, cw, ch, font)
    except Exception:
        return False
    lines, width = load_logo()
    ident = random.randint(1, 0xFFFFFF)
    common = f"i={ident},f=32,s={w},v={h},o=z,t=f,q=2"
    out = ["\x1b[?2026h\x1b7"]
    for i in range(len(lines)):
        out.append(f"\x1b[{top + i};{LOGO_COL}H" + " " * width)
    # The picture has a spare column on each side, so it starts one column to the left.
    out.append(f"\x1b[{top};{LOGO_COL - 1}H")
    out.append(gfx(f"a=T,{common},c={width + 2},r={len(lines)},C=1", first))
    if ready:
        out.append(play(ident, paths, w, h, look["seconds"], replace=False))
    out.append("\x1b8\x1b[?2026l")
    os.write(fd, "".join(out).encode())
    try:
        register(ident, shell, look, cw, ch, len(paths))
    except OSError:
        pass
    if ready or detach():
        return True
    # The background child: make the frames, then turn the still picture into the animation.
    # Each burst of commands is one write, which the tty never splits between writers.
    try:
        paths, w, h = picture_frames(look["animation"], look["seconds"], color, cw, ch)
        if paths:
            os.write(fd, play(ident, paths, w, h, look["seconds"], replace=True).encode())
    finally:
        os._exit(0)


def recolor():
    """Called after the colors change: makes frames in the new accent for every logo still
    playing in a terminal, swaps them in place, and makes the frames a new terminal will want,
    so it opens at once."""
    color = accent()
    folder = runtime_dir()
    looks = {}
    for name in os.listdir(folder):
        if not (name.startswith("img-") and name.endswith(".json")):
            continue
        path = os.path.join(folder, name)
        try:
            with open(path) as f:
                rec = json.load(f)
            os.kill(rec["shell"], 0)
            if shell_tty(rec["shell"]) != rec["tty"]:
                raise OSError
        except (OSError, ValueError, KeyError, TypeError):
            try:
                os.remove(path)
            except OSError:
                pass
            continue
        looks.setdefault((rec["animation"], rec["seconds"], rec["logo"], rec["cw"], rec["ch"]),
                         []).append(rec)
    # The look of the next greeting, at the last cell size.
    try:
        with open(os.path.join(folder, "cell")) as f:
            cell = json.load(f)
        look = settings()
        if look["enabled"]:
            looks.setdefault((look["animation"], look["seconds"], look["logo"],
                              int(cell["cw"]), int(cell["ch"])), [])
    except (OSError, ValueError, KeyError, TypeError):
        pass
    def late(*_):
        raise TimeoutError

    signal.signal(signal.SIGALRM, late)
    global LOGO
    for (anim, seconds, logo, cw, ch), recs in looks.items():
        if logo not in LOGOS or not os.path.exists(logo_source(logo)):
            continue
        LOGO = logo
        try:
            paths, w, h = picture_frames(anim, seconds, color, cw, ch)
        except Exception:
            continue
        if not paths:
            continue
        for rec in recs:
            if len(paths) != rec["count"]:
                continue
            try:
                tty_fd = os.open(rec["tty"], os.O_WRONLY | os.O_NOCTTY)
            except OSError:
                continue
            signal.alarm(3)     # a terminal that stopped reading must not hold the rest
            try:
                os.write(tty_fd, recolor_frames(rec["ident"], paths, w, h, seconds).encode())
            except OSError:
                pass
            finally:
                signal.alarm(0)
                os.close(tty_fd)


def colors_stamp():
    try:
        return os.stat(os.path.join(STATE, "falcon", "colors.json")).st_mtime_ns
    except OSError:
        return None


def spin(fd, top, shell, look):
    lines, _ = load_logo()
    rendered, still = [], b""

    def paint():
        # The frames in the current accent, made again when the wallpaper changes it.
        nonlocal rendered, still
        color = accent()
        rendered = []
        for rows in text_frames(look["animation"], look["seconds"], color):
            moves = "".join(f"\x1b[{top + i};{LOGO_COL}H{r}" for i, r in enumerate(rows))
            rendered.append(("\x1b[?2026h\x1b7" + moves + "\x1b8\x1b[?2026l").encode())
        text = "".join(f"\x1b[{top + i};{LOGO_COL}H\x1b[1;38;2;%d;%d;%dm{r}\x1b[0m" % color
                       for i, r in enumerate(lines))
        still = ("\x1b[?2026h\x1b7" + text + "\x1b8\x1b[?2026l").encode()

    stamp = colors_stamp()
    paint()

    def rest(*_):
        # Leave the whole logo in place, not caught halfway through a move.
        try:
            os.write(fd, still)
        except OSError:
            pass
        os._exit(0)

    signal.signal(signal.SIGTERM, rest)
    size = term_size(fd)
    step = look["seconds"] / len(rendered)
    start = time.monotonic()
    n = 0
    while True:
        try:
            os.kill(shell, 0)
        except OSError:
            return
        try:
            if term_size(fd) != size:
                return
        except OSError:
            return
        if n % len(rendered) == 0 and colors_stamp() != stamp:
            stamp = colors_stamp()
            paint()
        os.write(fd, rendered[n % len(rendered)])
        n += 1
        delay = start + n * step - time.monotonic()
        if delay > 0:
            time.sleep(delay)


# ---------------------------------------------------------------- previews

PREVIEW_CELL = (9, 19)


def preview_folder(font, count, color):
    shapes = {name: load_logo(name)[0] for name in LOGOS if os.path.exists(logo_source(name))}
    key = hashlib.sha1(repr((VERSION, "preview", font, count, color, shapes)).encode()).hexdigest()[:16]
    return os.path.join(CACHE, "preview-" + key), list(shapes)


def make_clip(job):
    """One animated WebP: (logo, animation, path, seconds, count, color, font). Returns the job."""
    from PIL import Image
    logo, anim, path, seconds, count, color, font = job
    if not os.path.exists(path):
        art = Art(*PREVIEW_CELL, font, name=logo)
        frames = [Image.fromarray(to_rgba(*picture_frame(anim, art, color, i, count)), "RGBA")
                  for i in range(count)]
        tmp = f"{path}.{os.getpid()}.tmp.webp"
        frames[0].save(tmp, save_all=True, append_images=frames[1:],
                       duration=round(1000 * seconds / count), loop=0, quality=85, method=0)
        os.replace(tmp, path)
    return logo, anim, path


def previews(seconds, chosen):
    """Prints JSON lines for the Settings page: first {"logos": {name: still png}}, then one
    {"logo", "animation", "path"} per animated WebP, the chosen logo first. Every logo gets every
    animation, so picking another logo on the page shows its clips at once. Made in parallel and
    cached by accent, loop length and the logos' shapes."""
    font = font_file()
    if not font:
        return
    color = accent()
    count = max(2, round(FPS * seconds))
    folder, names = preview_folder(font, count, color)
    os.makedirs(folder, exist_ok=True)
    os.utime(folder)
    print(json.dumps({"logos": logo_pictures(font, color)}), flush=True)
    order = [chosen] + [n for n in names if n != chosen] if chosen in names else names
    jobs = [(logo, anim, os.path.join(folder, f"{logo}-{anim}.webp"), seconds, count, color, font)
            for logo in order for anim in ANIMATIONS]
    ready = [j for j in jobs if os.path.exists(j[2])]
    for logo, anim, path, *_ in ready:
        print(json.dumps({"logo": logo, "animation": anim, "path": path}), flush=True)
    todo = [j for j in jobs if not os.path.exists(j[2])]
    if todo:
        import multiprocessing
        workers = max(1, min(len(todo), (os.cpu_count() or 2) // 2))
        with multiprocessing.get_context("fork").Pool(workers) as pool:
            for logo, anim, path in pool.imap(make_clip, todo):
                print(json.dumps({"logo": logo, "animation": anim, "path": path}), flush=True)
    prune()


def logo_pictures(font, color):
    """A still PNG of every logo, for the logo cards of the Settings page."""
    from PIL import Image
    shapes = {name: load_logo(name)[0] for name in LOGOS if os.path.exists(logo_source(name))}
    key = hashlib.sha1(repr((VERSION, "logos", font, color, shapes)).encode()).hexdigest()[:16]
    folder = os.path.join(CACHE, "logos-" + key)
    os.makedirs(folder, exist_ok=True)
    os.utime(folder)
    out = {}
    for name in shapes:
        path = os.path.join(folder, name + ".png")
        if not os.path.exists(path):
            art = Art(*PREVIEW_CELL, font, name=name)
            Image.fromarray(to_rgba(art.mask, solid(color, art.shape)), "RGBA").save(path)
        out[name] = path
    return out


def kitty_palette():
    colors = {"foreground": "#dddddd", "background": "#000000"}
    base = ["#000000", "#cc0403", "#19cb00", "#cecb00", "#0d73cc", "#cb1ed1", "#0dcdcd", "#dddddd",
            "#767676", "#f2201f", "#23fd00", "#fffd00", "#1a8fff", "#fd28ff", "#14ffff", "#ffffff"]
    for i, c in enumerate(base):
        colors[f"color{i}"] = c
    for name in ("kitty.conf", "falcon-colors.conf"):
        try:
            with open(os.path.join(CONFIG, "kitty", name)) as f:
                for raw in f:
                    parts = raw.split()
                    if len(parts) == 2 and (parts[0] in colors) and parts[1].startswith("#"):
                        colors[parts[0]] = parts[1]
        except OSError:
            pass
    return colors


def to_html(text, palette):
    """fastfetch's colored output as rich text with the terminal's colors."""
    def esc(s):
        return s.replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;").replace(" ", "&nbsp;")

    out_lines = []
    fg = bg = None
    bold = False
    for raw in text.split("\n"):
        parts, col = [], 0
        for m in re.finditer(r"\x1b\[([0-9;]*)([A-Za-z])|([^\x1b]+)", raw):
            if m.group(3):
                chunk = m.group(3)
                style = []
                if fg:
                    style.append(f"color:{fg}")
                if bg:
                    style.append(f"background-color:{bg}")
                body = esc(chunk)
                if bold:
                    body = f"<b>{body}</b>"
                parts.append(f"<span style=\"{';'.join(style)}\">{body}</span>" if style else body)
                col += len(chunk)
                continue
            args, kind = m.group(1), m.group(2)
            if kind == "G":
                want = int(args or 1) - 1
                if want > col:
                    parts.append("&nbsp;" * (want - col))
                    col = want
                continue
            if kind != "m":
                continue
            nums = [int(n) for n in args.split(";") if n] or [0]
            k = 0
            while k < len(nums):
                n = nums[k]
                if n == 0:
                    fg = bg = None
                    bold = False
                elif n == 1:
                    bold = True
                elif n == 22:
                    bold = False
                elif 30 <= n <= 37:
                    fg = palette[f"color{n - 30}"]
                elif 90 <= n <= 97:
                    fg = palette[f"color{n - 82}"]
                elif 40 <= n <= 47:
                    bg = palette[f"color{n - 40}"]
                elif 100 <= n <= 107:
                    bg = palette[f"color{n - 92}"]
                elif n == 39:
                    fg = None
                elif n == 49:
                    bg = None
                elif n in (38, 48) and k + 4 < len(nums) and nums[k + 1] == 2:
                    value = "#%02x%02x%02x" % tuple(nums[k + 2:k + 5])
                    if n == 38:
                        fg = value
                    else:
                        bg = value
                    k += 4
                k += 1
        out_lines.append("".join(parts))
    while out_lines and out_lines[-1] == "":
        out_lines.pop()
    return "<br>".join(out_lines)


def preview_text(style):
    if style not in STYLES:
        style = DEFAULTS["style"]
    env = dict(os.environ, FALCON_SHELL="fish")
    out = subprocess.run(["fastfetch", "-c", config_file(style, logo=False), "--pipe", "false"],
                         stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, env=env,
                         text=True).stdout
    palette = kitty_palette()
    return {"html": to_html(out, palette), "background": palette["background"],
            "foreground": palette["foreground"], "lines": out.rstrip("\n").count("\n") + 1}


# ---------------------------------------------------------------- main

def main():
    args = sys.argv[1:]
    if "--previews" in args:
        look = settings()
        previews(look["seconds"], look["logo"])
        return
    if "--preview-text" in args:
        rest = args[args.index("--preview-text") + 1:]
        print(json.dumps(preview_text(rest[0] if rest else settings()["style"]), ensure_ascii=False))
        return
    shell = os.getppid()
    if "--shell" in args:
        shell = int(args[args.index("--shell") + 1])
    if "--stop" in args:
        stop(shell)
        return
    if "--recolor" in args:
        if not detach():
            try:
                recolor()
            finally:
                os._exit(0)
        return
    stop(shell)
    look = settings()
    if not look["enabled"]:
        return

    # fastfetch names the shell after its parent, which would be this script, so the shell that
    # started it is passed on and shown by the "shell" line of the config.
    try:
        with open(f"/proc/{os.getppid()}/comm") as comm:
            parent = comm.read().strip()
    except OSError:
        parent = ""
    env = dict(os.environ, FALCON_SHELL=parent) if parent else None
    out = subprocess.run(["fastfetch", "-c", config_file(look["style"]), "--pipe", "false"],
                         stdout=subprocess.PIPE, env=env).stdout
    try:
        fd = os.open("/dev/tty", os.O_RDWR | os.O_NOCTTY)
    except OSError:
        sys.stdout.buffer.write(out)
        return
    os.write(fd, out)
    printed = out.count(b"\n")
    row = cursor_row(fd)
    if row is None or printed < LOGO_LINES:
        return
    top = row - printed
    if top >= 1 and kitty_ok() and picture(fd, top, look, shell):
        return
    rows, _ = term_size(fd)
    # Too close to the bottom: the prompt would scroll the logo away.
    if top < 1 or row + 2 > rows:
        return

    pid = os.fork()
    if pid:
        with open(pid_file(shell), "w") as f:
            f.write(str(pid))
        return
    os.setsid()
    signal.signal(signal.SIGTERM, lambda *_: os._exit(0))
    signal.signal(signal.SIGHUP, lambda *_: os._exit(0))
    devnull = os.open(os.devnull, os.O_RDWR)
    for n in (0, 1, 2):
        os.dup2(devnull, n)
    try:
        spin(fd, top, shell, look)
    finally:
        try:
            if open(pid_file(shell)).read().strip() == str(os.getpid()):
                os.remove(pid_file(shell))
        except OSError:
            pass
        os._exit(0)


if __name__ == "__main__":
    main()
