#!/usr/bin/env python3
"""Talks to Claude for the dashboard AI chat.

Uses Claude Code (your subscription) when the `claude` command is available, otherwise an API key.
Settings: ai.backend is auto, claude-code or api.

  niri-desk-ai send       message from stdin, reply to stdout as JSON lines
  niri-desk-ai history    print the saved chat
  niri-desk-ai clear      delete the chat
  niri-desk-ai set-key    read the API key from stdin into a protected file
  niri-desk-ai status     key and SDK state
"""
import json
import os
import shutil
import signal
import subprocess
import sys
from pathlib import Path

sys.dont_write_bytecode = True
from niri_desk_tr import tr

HOME = Path.home()
CONFIG = Path(os.environ.get("XDG_CONFIG_HOME", HOME / ".config")) / "niri-desk"
STATE = Path(os.environ.get("XDG_STATE_HOME", HOME / ".local/state")) / "niri-desk"
HISTORY = STATE / "ai-history.json"
KEY_FILE = CONFIG / "secrets/anthropic-key"
VENV = HOME / ".local/share/niri-desk/venv/bin/python"
SESSION = STATE / "ai-session"
WORKDIR = STATE / "ai"
# Panel niri'dan ishga tushadi: PATH'da foydalanuvchi o'rnatgan joylar bo'lmasligi mumkin.
CLAUDE_PATHS = [HOME / ".local/bin/claude", HOME / ".local/share/mise/shims/claude", HOME / ".claude/local/claude", HOME / ".npm-global/bin/claude", Path("/usr/bin/claude")]
MODEL = "claude-opus-5-5"


def emit(kind, **fields):
    print(json.dumps({"t": kind, **fields}, ensure_ascii=False), flush=True)


def settings():
    data = {}
    for name in ("defaults.json", "settings.json"):
        path = CONFIG / name
        if path.exists():
            try:
                loaded = json.loads(path.read_text() or "{}")
            except ValueError:
                continue
            for key, value in loaded.items():
                if isinstance(value, dict) and isinstance(data.get(key), dict):
                    data[key] = {**data[key], **value}
                else:
                    data[key] = value
    return data


def load_history():
    try:
        return json.loads(HISTORY.read_text())
    except (OSError, ValueError):
        return []


def save_history(messages):
    STATE.mkdir(parents=True, exist_ok=True)
    tmp = HISTORY.with_suffix(".tmp")
    tmp.touch(mode=0o600)
    tmp.write_text(json.dumps(messages, ensure_ascii=False))
    os.replace(tmp, HISTORY)


def plain(message):
    content = message["content"]
    if isinstance(content, str):
        return content
    return "".join(b.get("text", "") for b in content if b.get("type") == "text")


def client_kwargs():
    # Muhit o'zgaruvchisi yoki `ant auth login` bo'lsa, SDK uni o'zi topadi.
    if not os.environ.get("ANTHROPIC_API_KEY") and KEY_FILE.exists():
        key = KEY_FILE.read_text().strip()
        if key:
            return {"api_key": key}
    return {}


def find_claude(ai):
    chosen = ai.get("claudePath")
    if chosen:
        return chosen if os.access(chosen, os.X_OK) else None
    found = shutil.which("claude")
    if found:
        return found
    return next((str(p) for p in CLAUDE_PATHS if os.access(p, os.X_OK)), None)


def backend(ai):
    wanted = ai.get("backend", "auto")
    if wanted in ("claude-code", "api"):
        return wanted
    return "claude-code" if find_claude(ai) else "api"


def system_prompt(s):
    ai = s.get("ai", {})
    target = s.get("lab", {}).get("target", "")
    system = ai.get("system") or "You are an assistant on the user's computer. Answer briefly and clearly, in the language the user writes in."
    if target:
        system += f"\nThe user's current training lab target: {target}."
    return system


def run_claude(path, ai, system, text, session):
    # Asboblarsiz: chat fayllarga tegmaydi va buyruq bajarmaydi.
    argv = [path, "-p", "--output-format", "stream-json", "--verbose", "--include-partial-messages",
            "--tools", "", "--strict-mcp-config", "--disable-slash-commands", "--setting-sources", "",
            "--system-prompt", system, "--system-prompt-snapshot", "off",
            "--model", ai.get("model") or MODEL, "--effort", ai.get("effort", "medium")]
    if session:
        argv += ["--resume", session]
    # Hisob obunadan ketishi uchun kalit o'zgaruvchilari o'tkazilmaydi.
    env = {k: v for k, v in os.environ.items() if k not in ("ANTHROPIC_API_KEY", "ANTHROPIC_AUTH_TOKEN")}
    WORKDIR.mkdir(parents=True, exist_ok=True)
    proc = subprocess.Popen(argv, stdin=subprocess.PIPE, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, text=True, cwd=WORKDIR, env=env)

    def stop(*_):
        proc.terminate()
        sys.exit(143)

    signal.signal(signal.SIGTERM, stop)
    proc.stdin.write(text)
    proc.stdin.close()
    reply, result, new_session = [], None, session
    for line in proc.stdout:
        try:
            event = json.loads(line)
        except ValueError:
            continue
        kind = event.get("type")
        if event.get("session_id"):
            new_session = event["session_id"]
        if kind == "stream_event":
            delta = event.get("event", {}).get("delta", {})
            if delta.get("type") == "text_delta":
                reply.append(delta["text"])
                emit("delta", text=delta["text"])
        elif kind == "result":
            result = event
    proc.wait()
    return "".join(reply), result, new_session


def send_claude(path, s, text):
    ai = s.get("ai", {})
    try:
        session = SESSION.read_text().strip()
    except OSError:
        session = ""
    system = system_prompt(s)
    reply, result, new_session = run_claude(path, ai, system, text, session)
    # Eski suhbat topilmasa, yangisini boshlaymiz.
    if result and result.get("is_error") and "no conversation" in str(result.get("result", "")).lower():
        SESSION.unlink(missing_ok=True)
        reply, result, new_session = run_claude(path, ai, system, text, "")
    if result is None:
        emit("error", message=tr("Claude Code did not respond."))
        return 1
    if result.get("is_error"):
        detail = str(result.get("result", ""))
        low = detail.lower()
        if "log in" in low or "logged in" in low or "login" in low:
            emit("error", message=tr("Claude Code is not signed in. Run in a terminal: claude auth login"))
        elif "limit" in low:
            emit("error", message=tr("Subscription limit reached: {detail}", detail=detail)[:400])
        else:
            emit("error", message=tr("Claude Code error: {detail}", detail=detail)[:400])
        return 1
    if result.get("stop_reason") == "refusal":
        emit("error", message=tr("The model did not answer this request. Try rephrasing it."))
        return 1
    if new_session:
        STATE.mkdir(parents=True, exist_ok=True)
        SESSION.write_text(new_session)
    if result.get("stop_reason") == "max_tokens":
        emit("delta", text="\n\n" + tr("[The reply was cut off at the length limit]"))
    save_history(load_history() + [{"role": "user", "content": text}, {"role": "assistant", "content": reply}])
    emit("done")
    return 0


def send():
    s = settings()
    ai = s.get("ai", {})
    if backend(ai) == "claude-code":
        path = find_claude(ai)
        if not path:
            emit("error", message=tr("Claude Code not found. Install it, or choose an API key in Settings → AI."))
            return 1
        text = sys.stdin.read().strip()
        if not text:
            emit("done")
            return 0
        return send_claude(path, s, text)
    try:
        import anthropic
    except ImportError:
        emit("error", message=tr("anthropic SDK not found. Run install.sh again."))
        return 1
    text = sys.stdin.read().strip()
    if not text:
        emit("done")
        return 0
    system = system_prompt(s)
    messages = load_history() + [{"role": "user", "content": text}]
    kwargs = {}
    if ai.get("fallbacks", True):
        kwargs = {"betas": ["server-side-fallback-2026-07-01"], "fallbacks": "default"}
    try:
        options = client_kwargs()
        if ai.get("baseUrl"):
            options["base_url"] = ai["baseUrl"]
        client = anthropic.Anthropic(**options)
        with client.beta.messages.stream(
            model=ai.get("model") or MODEL,
            max_tokens=int(ai.get("maxTokens", 16000)),
            system=system,
            thinking={"type": "adaptive"},
            output_config={"effort": ai.get("effort", "medium")},
            messages=messages,
            **kwargs,
        ) as stream:
            for chunk in stream.text_stream:
                emit("delta", text=chunk)
            final = stream.get_final_message()
    except anthropic.AuthenticationError:
        emit("error", message=tr("The API key is invalid or missing. Add it in Settings → AI."))
        return 1
    except anthropic.PermissionDeniedError:
        emit("error", message=tr("This key does not have enough permissions."))
        return 1
    except anthropic.NotFoundError:
        emit("error", message=tr("Model not found: {model}", model=ai.get("model") or MODEL))
        return 1
    except anthropic.RateLimitError:
        emit("error", message=tr("Rate limit reached. Try again shortly."))
        return 1
    except anthropic.BadRequestError as err:
        emit("error", message=tr("Request rejected: {detail}", detail=err.message)[:400])
        return 1
    except anthropic.APIStatusError as err:
        emit("error", message=tr("Service error ({code}). Try again later.", code=err.status_code))
        return 1
    except anthropic.APIConnectionError:
        emit("error", message=tr("Could not connect to the internet."))
        return 1
    except TypeError:
        # SDK hisob ma'lumoti umuman topilmaganda shu xatoni beradi.
        emit("error", message=tr("No API key set. Add it in Settings → AI."))
        return 1
    except anthropic.AnthropicError as err:
        emit("error", message=str(err)[:400])
        return 1
    if final.stop_reason == "refusal":
        # Rad etilgan navbat tarixga qo'shilmaydi, keyingi savol toza davom etadi.
        emit("error", message=tr("The model did not answer this request. Try rephrasing it."))
        return 1
    if final.stop_reason == "max_tokens":
        emit("delta", text="\n\n" + tr("[The reply was cut off at the length limit]"))
    messages.append({"role": "assistant", "content": [b.model_dump(mode="json", exclude_none=True) for b in final.content]})
    save_history(messages)
    emit("done")
    return 0


def main():
    action = sys.argv[1] if len(sys.argv) > 1 else ""
    if action == "send":
        return send()
    if action == "history":
        print(json.dumps([{"role": m["role"], "text": plain(m)} for m in load_history()], ensure_ascii=False))
        return 0
    if action == "clear":
        HISTORY.unlink(missing_ok=True)
        SESSION.unlink(missing_ok=True)
        return 0
    if action == "set-key":
        key = sys.stdin.read().strip()
        KEY_FILE.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
        if key:
            tmp = KEY_FILE.with_suffix(".tmp")
            tmp.touch(mode=0o600)
            tmp.write_text(key + "\n")
            os.replace(tmp, KEY_FILE)
            KEY_FILE.chmod(0o600)
        else:
            KEY_FILE.unlink(missing_ok=True)
        return 0
    if action == "status":
        try:
            import anthropic  # noqa: F401
            sdk = True
        except ImportError:
            sdk = False
        ai = settings().get("ai", {})
        path = find_claude(ai)
        signed_in = False
        if path:
            try:
                signed_in = json.loads(subprocess.run([path, "auth", "status"], capture_output=True, text=True, timeout=15).stdout).get("loggedIn", False)
            except (OSError, ValueError, subprocess.TimeoutExpired):
                pass
        print(json.dumps({"backend": backend(ai), "claude": path, "signedIn": signed_in, "sdk": sdk, "key": bool(os.environ.get("ANTHROPIC_API_KEY")) or KEY_FILE.exists()}))
        return 0
    print(__doc__.strip(), file=sys.stderr)
    return 2


# SDK alohida venv'da turadi: tizim Python'ini iflos qilmaydi. Yuklash sekin, faqat kerak bo'lganda.
if sys.argv[1:2] == ["status"] or (sys.argv[1:2] == ["send"] and backend(settings().get("ai", {})) == "api"):
    try:
        import anthropic  # noqa: F401
    except ImportError:
        if VENV.exists() and Path(sys.executable) != VENV:
            os.execv(str(VENV), [str(VENV), __file__, *sys.argv[1:]])
sys.exit(main())
