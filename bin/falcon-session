#!/usr/bin/env python3
"""Keeps the open windows on disk and brings them back after a reboot.

  falcon-session run      at login: restore, then keep the saved state current
  falcon-session watch    keep the saved state current (one copy runs at a time)
  falcon-session save     save the state now
  falcon-session restore  restore (does nothing when windows are open)

Each window comes back on its workspace and monitor, in its column, with its size, and floating
windows at their position. A terminal comes back in its folder. Only the app is started, never its
arguments, so a one-off terminal command does not run again. What is inside a window is up to the app.

While restoring, a small cover (quickshell/falcon/cover) hides the screen until every window is in
place. It is up in about 0.1 s, and apps start only once it is on screen.
"""
import fcntl
import json
import os
import select
import shlex
import shutil
import socket
import subprocess
import sys
import time
from pathlib import Path

STATE = Path(os.environ.get("XDG_STATE_HOME", Path.home() / ".local/state")) / "falcon"
FILE = STATE / "session.json"
FLAG = Path(os.environ.get("XDG_RUNTIME_DIR") or f"/run/user/{os.getuid()}") / "falcon-restoring"
COVER = "falcon-cover"
CONFIG = Path(os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config"))
COVER_DIR = CONFIG / "quickshell/falcon/cover"
# While windows come back niri's animations are off, so each window lands at once in its place
# and size and nothing is still sliding when the cover lifts. Included optionally by config.kdl.
QUIET = CONFIG / "niri/generated/restore.kdl"
REPORT = STATE / "restore.log"
DEBUG = bool(os.environ.get("FALCON_SESSION_DEBUG"))
T0 = time.monotonic()


def debug(*words):
    if DEBUG:
        print(f"{time.monotonic() - T0:6.3f}", *words, file=sys.stderr)
SKIP = {"org.quickshell", "falcon-scratch", "falcon-tool", "com.gabm.satty"}
# Folder option of each terminal. Their windows are separate processes, so the next can start at once.
TERMINALS = {"kitty": "--directory", "alacritty": "--working-directory", "foot": "--working-directory"}
# These only name a runtime, so the app cannot be started from them.
RUNTIMES = {"python", "python3", "node", "electron", "java", "bwrap", "sh", "bash", "zsh", "fish", "wine", "gjs"}
HELPERS = {"kitten", "kitty"}
# Picture-in-Picture windows belong to a video playing in a browser tab. No app brings them back
# at start, so waiting for one only held the cover up and then started a second browser window.
TRANSIENT_TITLES = {"picture-in-picture", "picture in picture", "картинка в картинке", "картинка-в-картинке"}

SAVE_DELAY = 1.5        # after a change, so a burst of events writes once
SAVE_EVERY = 30         # also catches a terminal changing folder, which sends no event
SETTLE = 1.5            # a browser restores its own windows, so more of them may still come
SETTLE_OTHER = 0.8      # other apps open one window per start, so the next start follows soon
BROWSERS = {"firefox", "firefox-esr", "librewolf", "zen", "zen-browser", "floorp", "waterfox", "chromium",
            "chrome", "google-chrome", "google-chrome-stable", "brave", "brave-browser", "vivaldi", "vivaldi-stable",
            "opera", "thorium-browser", "microsoft-edge", "microsoft-edge-stable", "telegram", "Telegram"}
COVER_WAIT = 1.5          # a cover that does not come up must not hold the windows back
POLL = 0.05             # how often new windows are looked for while restoring
LAUNCH_WAIT = 12        # a first launch that opened nothing by then is given up
RELAUNCH_WAIT = 1.8     # a second launch for more windows of a running app answers fast or not at all
RESTORE_WAIT = 60
IGNORED_EVENTS = {"KeyboardLayoutsChanged", "KeyboardLayoutSwitched", "OverviewOpenedOrClosed", "ConfigLoaded",
                  "ScreenshotCaptured", "CastsChanged", "CastStartedOrChanged", "CastStopped", "WindowUrgencyChanged",
                  "WorkspaceUrgencyChanged"}


def ask(request):
    """Sends one request straight through niri's socket, which takes well under a millisecond, while
    starting `niri msg` takes about ten. Restoring asks many times a second. None when it fails."""
    try:
        with socket.socket(socket.AF_UNIX) as sock:
            sock.settimeout(2)
            sock.connect(os.environ["NIRI_SOCKET"])
            sock.sendall(json.dumps(request).encode() + b"\n")
            sock.shutdown(socket.SHUT_WR)
            data = b""
            while not data.endswith(b"\n"):
                chunk = sock.recv(65536)
                if not chunk:
                    break
                data += chunk
        reply = json.loads(data)
    except (OSError, KeyError, ValueError):
        return None
    return reply.get("Ok") if isinstance(reply, dict) else None


def niri_json(what):
    request = what.capitalize()
    reply = ask(request)
    if isinstance(reply, dict) and request in reply:
        return reply[request]
    return json.loads(subprocess.run(["niri", "msg", "--json", what], capture_output=True, text=True, check=True).stdout)


def window_id(o):
    return int(o["--id"])


fixed = lambda value: {"SetFixed": value}
# The socket form of each action used here, built from the same words `niri msg action` takes.
REQUESTS = {
    "spawn": lambda o, p: {"Spawn": {"command": p}},
    "focus-window": lambda o, p: {"FocusWindow": {"id": window_id(o)}},
    "move-window-to-monitor": lambda o, p: {"MoveWindowToMonitor": {"id": window_id(o), "output": p[0]}},
    "move-window-to-workspace": lambda o, p: {"MoveWindowToWorkspace": {
        "window_id": int(o["--window-id"]), "reference": {"Index": int(p[0])}, "focus": o.get("--focus") != "false"}},
    "move-window-to-floating": lambda o, p: {"MoveWindowToFloating": {"id": window_id(o)}},
    "set-window-width": lambda o, p: {"SetWindowWidth": {"id": window_id(o), "change": fixed(int(p[0]))}},
    "set-window-height": lambda o, p: {"SetWindowHeight": {"id": window_id(o), "change": fixed(int(p[0]))}},
    "move-floating-window": lambda o, p: {"MoveFloatingWindow": {
        "id": window_id(o), "x": fixed(float(o["-x"])), "y": fixed(float(o["-y"]))}},
    "move-column-to-index": lambda o, p: {"MoveColumnToIndex": {"index": int(p[0])}},
    "consume-or-expel-window-left": lambda o, p: {"ConsumeOrExpelWindowLeft": {"id": window_id(o)}},
    "fullscreen-window": lambda o, p: {"FullscreenWindow": {"id": window_id(o)}},
}


def action(*args):
    args = [str(a) for a in args]
    options, words = {}, []
    rest = iter(args[1:])
    for word in rest:
        if word == "--":
            words.extend(rest)
        elif word.startswith("-"):
            options[word] = next(rest, "")
        else:
            words.append(word)
    try:
        request = REQUESTS[args[0]](options, words)
    except (KeyError, IndexError, ValueError):
        request = None
    t = time.monotonic()
    if request and ask({"Action": request}) == "Handled":
        debug("action", args[0], f"{(time.monotonic() - t) * 1000:.1f} ms")
        return
    debug("fallback", args)
    subprocess.run(["niri", "msg", "action", *args], capture_output=True, check=False)


def executable(pid):
    try:
        argv = Path(f"/proc/{pid}/cmdline").read_bytes().split(b"\0")[0].decode()
    except (OSError, UnicodeDecodeError):
        return ""
    return os.path.basename(argv)


def terminal_folder(pid):
    """The folder of the terminal's shell."""
    try:
        children = Path(f"/proc/{pid}/task/{pid}/children").read_text().split()
    except OSError:
        return ""
    for child in children:
        if executable(child) in HELPERS:
            continue
        try:
            return os.readlink(f"/proc/{child}/cwd")
        except OSError:
            continue
    return ""


def zen_on():
    try:
        with (CONFIG / "niri/generated/zen.kdl").open() as f:
            return f.readline().strip() == "// zen"
    except OSError:
        return False


def transient(title):
    return isinstance(title, str) and title.strip().lower() in TRANSIENT_TITLES


def snapshot():
    workspaces = {w["id"]: w for w in niri_json("workspaces")}
    outputs = niri_json("outputs")
    zen = zen_on()
    items = []
    for w in niri_json("windows"):
        app = w.get("app_id") or ""
        space = workspaces.get(w.get("workspace_id"))
        if not app or app in SKIP or not space or not w.get("pid") or transient(w.get("title")):
            continue
        exe = executable(w["pid"])
        if not exe:
            continue
        layout = w.get("layout") or {}
        pos = layout.get("pos_in_scrolling_layout") or [999, 1]
        tile = layout.get("tile_size") or [0, 0]
        size = layout.get("window_size") or tile
        logical = (outputs.get(space.get("output")) or {}).get("logical") or {}
        floating = w.get("is_floating", False)
        item = {
            "app": app,
            "exe": exe,
            "title": w.get("title") or "",
            "output": space.get("output") or "",
            "workspace": space["idx"],
            "column": pos[0],
            "row": pos[1],
            "floating": floating,
            "width": size[0],
            "height": size[1],
            # niri has no fullscreen flag. Focus mode has no gaps, so a column can fill the screen there.
            "fullscreen": not floating and not zen and tile[0] >= logical.get("width", 1e9) and tile[1] >= logical.get("height", 1e9),
            "active": space.get("active_window_id") == w["id"],
            "workspaceActive": bool(space.get("is_active")),
            "focused": bool(w.get("is_focused")),
        }
        if floating:
            where = layout.get("tile_pos_in_workspace_view")
            if where:
                item["x"], item["y"] = where
        if exe in TERMINALS:
            item["folder"] = terminal_folder(w["pid"])
        items.append(item)
    items.sort(key=lambda i: (i["output"], i["workspace"], i["floating"], i["column"], i["row"]))
    return items


def write(items):
    text = json.dumps(items, ensure_ascii=False, indent=1)
    try:
        if FILE.read_text() == text:
            return
    except OSError:
        pass
    STATE.mkdir(parents=True, exist_ok=True)
    tmp = FILE.with_suffix(".tmp")
    tmp.write_text(text)
    os.replace(tmp, FILE)


def save():
    write(snapshot())


def shutting_down():
    # Windows close one by one on the way down, and that must not become the saved state.
    state = subprocess.run(["systemctl", "is-system-running"], capture_output=True, text=True, check=False).stdout.strip()
    return state == "stopping"


def watch():
    STATE.mkdir(parents=True, exist_ok=True)
    # A restore that was killed midway must not leave the animations off.
    quiet(False)
    lock = (STATE / "session.lock").open("w")
    try:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        return 0
    stream = subprocess.Popen(["niri", "msg", "--json", "event-stream"], stdout=subprocess.PIPE, text=True)
    next_save = time.monotonic() + SAVE_EVERY
    while True:
        ready, _, _ = select.select([stream.stdout], [], [], max(0, next_save - time.monotonic()))
        if ready:
            line = stream.stdout.readline()
            if not line:
                # niri is gone. A change still waiting may be part of that, so it is dropped.
                return 0
            try:
                event = next(iter(json.loads(line)), "")
            except (ValueError, TypeError):
                continue
            if event not in IGNORED_EVENTS:
                next_save = min(next_save, time.monotonic() + SAVE_DELAY)
        if time.monotonic() >= next_save:
            next_save = time.monotonic() + SAVE_EVERY
            try:
                if not shutting_down():
                    save()
            except (OSError, ValueError, subprocess.CalledProcessError):
                pass


def setting(section, key, fallback):
    for name in ("settings.json", "defaults.json"):
        try:
            value = json.loads((CONFIG / "falcon" / name).read_text() or "{}").get(section, {}).get(key)
        except (OSError, ValueError, AttributeError):
            continue
        if value is not None:
            return value
    return fallback


def enabled():
    return setting("session", "restore", True)


def desktop_command(app):
    """The app's own start command from its desktop file."""
    dirs = os.environ.get("XDG_DATA_DIRS", "/usr/local/share:/usr/share").split(":")
    dirs.insert(0, os.environ.get("XDG_DATA_HOME", str(Path.home() / ".local/share")))
    dirs.append(str(Path.home() / ".local/share/flatpak/exports/share"))
    dirs.append("/var/lib/flatpak/exports/share")
    files = [f for d in dirs for f in sorted(Path(d, "applications").glob("*.desktop"))]
    named = [f for f in files if f.stem.lower() == app.lower()]
    for path in named + files:
        try:
            fields = {}
            for line in path.read_text(errors="replace").splitlines():
                if line.startswith("[") and fields:
                    break
                key, sep, value = line.partition("=")
                if sep:
                    fields.setdefault(key.strip(), value.strip())
        except OSError:
            continue
        if path not in named and fields.get("StartupWMClass", "").lower() != app.lower():
            continue
        if fields.get("Terminal") == "true" or not fields.get("Exec"):
            continue
        try:
            argv = shlex.split(fields["Exec"])
        except ValueError:
            continue
        argv = [a for a in argv if not (len(a) == 2 and a[0] == "%") and a not in ("@@", "@@u")]
        while argv and argv[-1] == "--":
            argv.pop()
        if argv and shutil.which(argv[0]):
            return argv
    return None


def launch_command(item):
    exe = item.get("exe", "")
    # A path in the file is never run, only a name found the normal way.
    safe_exe = exe if exe and "/" not in exe and exe not in RUNTIMES and shutil.which(exe) else ""
    if safe_exe in TERMINALS:
        folder = item.get("folder") or ""
        return [safe_exe, TERMINALS[safe_exe], folder] if os.path.isdir(folder) else [safe_exe]
    app = item.get("app") or ""
    command = desktop_command(app) if app else None
    if command:
        return command
    return [safe_exe] if safe_exe else None


class Group:
    """Windows still to come from one app."""

    def __init__(self, command):
        self.command = command
        self.items = []
        self.launched = 0.0
        self.launches = 0
        self.arrived = 0.0
        self.got_window = False

    @property
    def browser(self):
        return bool(self.items) and self.items[0].get("exe") in BROWSERS

    @property
    def terminal(self):
        return bool(self.items) and self.items[0].get("exe") in TERMINALS

    def launch(self, now):
        # Each terminal window is its own process, so all of them start at once and are told
        # apart by their folder when they arrive.
        for item in (self.items if self.terminal else self.items[:1]):
            action("spawn", "--", *(launch_command(item) or self.command))
        self.launched = now
        self.launches += 1
        self.got_window = False

    def due(self, now):
        if not self.items:
            return False
        if not self.launched:
            return True
        if self.terminal:
            if now - self.launched >= LAUNCH_WAIT:
                self.items.clear()
            return False
        if self.got_window:
            return now - self.arrived >= (SETTLE if self.browser else SETTLE_OTHER)
        return now - self.launched >= (LAUNCH_WAIT if self.launches == 1 else RELAUNCH_WAIT)


def pick(group, window):
    if group.terminal:
        # The shell starts a moment after the window, and its folder says which saved one this is.
        folder = ""
        end = time.monotonic() + 0.5
        while not folder and time.monotonic() < end:
            folder = terminal_folder(window.get("pid"))
            if not folder:
                time.sleep(0.02)
        for i, item in enumerate(group.items):
            if folder and item.get("folder") == folder:
                return group.items.pop(i)
        for i, item in enumerate(group.items):
            if not item.get("folder") or not os.path.isdir(item["folder"]):
                return group.items.pop(i)
        return group.items.pop(0)
    for i, item in enumerate(group.items):
        if item.get("title") and item.get("title") == window.get("title"):
            return group.items.pop(i)
    return group.items.pop(0)


def workspace_ranks(items):
    """niri drops empty workspaces, so saved numbers can have holes in them."""
    ranks = {}
    for output in {i.get("output", "") for i in items}:
        used = sorted({i.get("workspace", 1) for i in items if i.get("output", "") == output})
        for rank, number in enumerate(used, 1):
            ranks[output, number] = rank
    return ranks


def place(bound, ranks, outputs):
    """Puts windows on their workspaces, lowest first, because a higher one exists only after that.
    A window sent to a workspace that did not exist yet lands on the last one, so every window is
    checked again each time and moved only when it is not where it belongs."""
    spaces = windows = None
    for window_id, item in sorted(bound.items(), key=lambda b: ranks[b[1]["output"], b[1]["workspace"]]):
        # Asked again only after a move, which can add or renumber workspaces.
        if spaces is None:
            spaces = {w["id"]: w for w in niri_json("workspaces")}
            windows = {w["id"]: w for w in niri_json("windows")}
        window = windows.get(window_id)
        if not window:
            continue
        space = spaces.get(window.get("workspace_id")) or {}
        output = item["output"] if item["output"] in outputs else space.get("output")
        rank = ranks[item["output"], item["workspace"]]
        if output and space.get("output") != output:
            action("move-window-to-monitor", "--id", window_id, output)
            spaces = None
        if space.get("output") != output or space.get("idx") != rank:
            action("move-window-to-workspace", "--window-id", window_id, "--focus", "false", rank)
            spaces = None


def quiet(on):
    """Turns niri's animations off for the restore, or back to the user's own."""
    try:
        if on:
            QUIET.parent.mkdir(parents=True, exist_ok=True)
            QUIET.write_text("// restore: written by falcon-session while windows come back\nanimations {\n    off\n}\n")
        elif QUIET.exists() and QUIET.read_text():
            QUIET.write_text("")
        else:
            return
    except OSError:
        return
    ask({"Action": {"LoadConfigFile": {}}})


def fix_floating(bound):
    """niri takes a floating place inside the working area (under the panel's reserved strip) but
    reports it in the whole view, so a window lands off by that strip; each one is read back and
    moved by the difference."""
    current = {w["id"]: w for w in niri_json("windows")}
    for window_id, item in bound.items():
        if not item.get("floating") or "x" not in item or window_id not in current:
            continue
        where = (current[window_id].get("layout") or {}).get("tile_pos_in_workspace_view")
        if not where:
            continue
        dx, dy = round(where[0] - item["x"]), round(where[1] - item["y"])
        if dx or dy:
            action("move-floating-window", "--id", window_id, "-x", int(item["x"] - dx), "-y", int(item["y"] - dy))


def float_window(window_id, item):
    action("move-window-to-floating", "--id", window_id)
    if item.get("width") and item.get("height"):
        action("set-window-width", "--id", window_id, int(item["width"]))
        action("set-window-height", "--id", window_id, int(item["height"]))
    if "x" in item and "y" in item:
        action("move-floating-window", "--id", window_id, "-x", int(item["x"]), "-y", int(item["y"]))


def space_of(item, ranks):
    return item.get("output", ""), ranks[item.get("output", ""), item.get("workspace", 1)]


def arrange_columns(bound, ranks, only=None):
    """Rebuilds columns of each workspace (or of the workspaces in `only`). Moving a column needs
    focus, which costs a frame each, so windows already in their place are left alone."""
    current = {w["id"]: w for w in niri_json("windows")}
    spaces = {}
    for window_id, item in bound.items():
        if only is not None and space_of(item, ranks) not in only:
            continue
        if not item.get("floating") and window_id in current:
            spaces.setdefault((item.get("output", ""), ranks[item.get("output", ""), item.get("workspace", 1)]), []).append((window_id, item))
    for members in spaces.values():
        members.sort(key=lambda m: (m[1].get("column", 999), m[1].get("row", 1)))
        wanted = {}
        column = 0
        last = None
        for window_id, item in members:
            if item.get("column") != last or last is None:
                column += 1
                row = 1
                last = item.get("column")
            else:
                row += 1
            wanted[window_id] = (column, row)
        now = {i: ((current[i].get("layout") or {}).get("pos_in_scrolling_layout") or [0, 0]) for i, _ in members}
        if all(tuple(now[i]) == wanted[i] for i in wanted):
            continue
        for window_id, _ in members:
            column, row = wanted[window_id]
            here = next((w for w in niri_json("windows") if w["id"] == window_id), None)
            if here and tuple((here.get("layout") or {}).get("pos_in_scrolling_layout") or [0, 0]) == (column, row):
                continue
            action("focus-window", "--id", window_id)
            if row == 1:
                action("move-column-to-index", column)
            else:
                action("move-column-to-index", column + 1)
                action("consume-or-expel-window-left", "--id", window_id)


def fix_sizes(bound, outputs, only=None, ranks=None):
    """Returns whether any size had to change."""
    changed = False
    current = {w["id"]: w for w in niri_json("windows")}
    columns = {}
    for item in bound.values():
        key = (item.get("output"), item.get("workspace"), item.get("column"))
        columns[key] = columns.get(key, 0) + 1
    for window_id, item in bound.items():
        if item.get("floating") or item.get("fullscreen") or window_id not in current or not item.get("width"):
            continue
        if only is not None and space_of(item, ranks) not in only:
            continue
        layout = current[window_id].get("layout") or {}
        tile = layout.get("window_size") or layout.get("tile_size") or [0, 0]
        if abs(tile[0] - item["width"]) > 1:
            action("set-window-width", "--id", window_id, int(item["width"]))
            changed = True
        # A lone window normally fills the height, and the panel may not be up yet. A fixed
        # height would stop it following the panel, so only a clearly shorter one is set.
        screen = ((outputs.get(item.get("output")) or {}).get("logical") or {}).get("height", 0)
        stacked = columns[item.get("output"), item.get("workspace"), item.get("column")] > 1
        if item.get("height") and abs(tile[1] - item["height"]) > 1 and (stacked or item["height"] < screen * 0.85):
            action("set-window-height", "--id", window_id, int(item["height"]))
            changed = True
    return changed


def filling(window, outputs, output):
    tile = (window.get("layout") or {}).get("tile_size") or [0, 0]
    logical = (outputs.get(output) or {}).get("logical") or {}
    return tile[0] >= logical.get("width", 1e9) and tile[1] >= logical.get("height", 1e9)


def restore_focus(bound, outputs):
    current = {w["id"]: w for w in niri_json("windows")}
    for window_id, item in bound.items():
        # The action toggles, and an app may already have come back fullscreen by itself.
        if item.get("fullscreen") and window_id in current and not filling(current[window_id], outputs, item["output"]):
            action("fullscreen-window", "--id", window_id)
    # The window each workspace had in view, then the one with the keyboard last.
    ordered = sorted(bound.items(), key=lambda b: (b[1].get("workspaceActive", False), b[1].get("focused", False)))
    for window_id, item in ordered:
        if item.get("active") or item.get("focused"):
            action("focus-window", "--id", window_id)


def number(value, fallback, low=None):
    if isinstance(value, bool) or not isinstance(value, (int, float)) or value != value:
        return fallback
    return value if low is None or value >= low else fallback


def clean(item):
    """A saved window with every field of the right type, or None. The file may come from an older
    version or be edited by hand, and one bad entry must not stop the rest."""
    if not isinstance(item, dict):
        return None
    text = lambda key: item.get(key) if isinstance(item.get(key), str) else ""
    flag = lambda key: item.get(key) is True
    out = {
        "app": text("app"), "exe": text("exe"), "title": text("title"), "output": text("output"),
        "workspace": int(number(item.get("workspace"), 1, 1)),
        "column": int(number(item.get("column"), 999, 1)),
        "row": int(number(item.get("row"), 1, 1)),
        "floating": flag("floating"),
        "width": number(item.get("width"), 0, 0), "height": number(item.get("height"), 0, 0),
        "fullscreen": flag("fullscreen"), "active": flag("active"),
        "workspaceActive": flag("workspaceActive"), "focused": flag("focused"),
    }
    if (not out["app"] and not out["exe"]) or transient(out["title"]):
        return None
    if "x" in item and "y" in item:
        out["x"], out["y"] = number(item["x"], None), number(item["y"], None)
        if out["x"] is None or out["y"] is None:
            del out["x"], out["y"]
    if text("folder"):
        out["folder"] = text("folder")
    return out


def own_windows():
    """Windows that count as the user's. The shell's own windows do not."""
    return [w for w in niri_json("windows") if (w.get("app_id") or "") not in SKIP]


def open_cover(caption=True):
    if not (COVER_DIR / "shell.qml").exists() or not shutil.which("qs"):
        return None
    env = dict(os.environ, FALCON_COVER_FLAG=str(FLAG))
    if not caption:
        env["FALCON_COVER_TEXT"] = " "
    else:
        try:
            sys.path.insert(0, str(Path(__file__).resolve().parent))
            from falcon_tr import tr
            env["FALCON_COVER_TEXT"] = tr("Restoring your windows")
        except Exception:  # noqa: BLE001  the English text is used then
            pass
    font = setting("appearance", "font", "")
    if isinstance(font, str) and font:
        env["FALCON_COVER_FONT"] = font
    try:
        return subprocess.Popen(["qs", "-n", "-p", str(COVER_DIR)], env=env, stdin=subprocess.DEVNULL,
                                stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except OSError:
        return None


def close_cover(cover):
    """The flag is gone by now, so the cover fades out and quits by itself."""
    if not cover:
        return
    try:
        cover.wait(timeout=1.5)
    except subprocess.TimeoutExpired:
        cover.kill()
        cover.wait()


def wait_for_cover(cover):
    if not cover:
        return
    end = time.monotonic() + COVER_WAIT
    while time.monotonic() < end:
        if cover.poll() is not None:
            return
        try:
            if any(layer.get("namespace") == COVER for layer in niri_json("layers")):
                # One more frame, so the cover is on screen and not only mapped.
                time.sleep(0.03)
                return
        except (OSError, ValueError, subprocess.CalledProcessError):
            pass
        time.sleep(0.02)


def welcome():
    """At login with nothing to bring back, the cover still comes up out of the login screen's
    black and opens onto the desktop, so the session never just appears."""
    if own_windows():
        return
    try:
        FLAG.write_text(str(time.time()))
    except OSError:
        return
    cover = open_cover(caption=False)
    try:
        wait_for_cover(cover)
        # The cover's own rise from black takes 0.7 s; the shell and wallpaper come up meanwhile.
        time.sleep(1.1)
    finally:
        FLAG.unlink(missing_ok=True)
        close_cover(cover)


def restore(force, greet=False):
    """Returns 0. With `greet` (at login) the welcome cover shows when nothing is restored."""
    shown = False
    try:
        shown = bring_back_saved(force)
    finally:
        if greet and not shown:
            welcome()
    return 0


def bring_back_saved(force):
    if not force and not enabled():
        return False
    if own_windows():
        return False
    try:
        items = json.loads(FILE.read_text())
    except (OSError, ValueError):
        return False
    if not isinstance(items, list) or not items:
        return False
    started = time.monotonic()
    entries = [i for i in map(clean, items) if i]
    if not entries:
        return False
    # The cover starts first and comes up while the plan is made.
    try:
        FLAG.write_text(str(time.time()))
    except OSError:
        pass
    cover = open_cover()
    quiet(True)
    back = 0
    covered = lifted = None
    groups, wanted = {}, []
    try:
        groups, wanted = plan(entries)
        if wanted:
            debug("planned")
            gate = CoverGate(cover)
            back = bring_back(groups, wanted, gate)
            covered = gate.up_at
            lifted = time.monotonic()
    finally:
        quiet(False)
        FLAG.unlink(missing_ok=True)
        close_cover(cover)
        report(started, covered, lifted, len(wanted), back, groups)
    return bool(wanted)


def report(started, covered, lifted, wanted, back, groups):
    """One line per restore in restore.log, to judge the speed after a real boot: the time from
    the start until the cover starts to lift, with every window in place."""
    missing = sum(len(g.items) for g in groups.values())
    line = (f"{time.strftime('%Y-%m-%d %H:%M:%S')} restored {back}/{wanted} windows in "
            f"{((lifted or time.monotonic()) - started):.2f} s (cover up after {((covered or started) - started):.2f} s)"
            + (f", {missing} not back" if missing else "") + "\n")
    try:
        old = REPORT.read_text().splitlines(keepends=True)[-29:] if REPORT.exists() else []
        REPORT.write_text("".join(old) + line)
    except OSError:
        pass
    print(line.strip(), file=sys.stderr)


def plan(items):
    groups = {}
    wanted = []
    for item in items:
        if not item:
            continue
        command = launch_command(item)
        if not command:
            continue
        wanted.append(item)
        groups.setdefault(item.get("app") or item.get("exe"), Group(command)).items.append(item)
    return groups, wanted


class CoverGate:
    """Whether the cover is on screen yet, looked at without waiting. Apps start once it is: at a
    cold boot the cover, the shell, a browser and a messenger loading together kept the cover
    away for a second, so the panel and windows showed and then were covered."""

    def __init__(self, cover):
        self.cover = cover
        self.start = time.monotonic()
        self.up_at = None if cover else self.start

    def up(self):
        if self.up_at is not None:
            return True
        now = time.monotonic()
        if self.cover.poll() is not None or now - self.start >= COVER_WAIT:
            self.up_at = now
        else:
            try:
                if any(layer.get("namespace") == COVER for layer in niri_json("layers")):
                    self.up_at = now
                    debug("cover up")
            except (OSError, ValueError, subprocess.CalledProcessError):
                pass
        return self.up_at is not None


def bring_back(groups, wanted, gate=None):
    ranks = workspace_ranks(wanted)
    outputs = niri_json("outputs")
    bound = {}
    settled = set()
    start = time.monotonic()
    while time.monotonic() - start < RESTORE_WAIT and any(g.items for g in groups.values()):
        now = time.monotonic()
        arrived = False
        for window in niri_json("windows"):
            if window["id"] in bound:
                continue
            app = window.get("app_id") or ""
            group = groups.get(app) or groups.get(executable(window.get("pid")))
            if not group or not group.items:
                continue
            item = pick(group, window)
            debug("window", app, repr(window.get("title"))[:40])
            bound[window["id"]] = item
            group.arrived = now
            group.got_window = True
            arrived = True
            if item.get("floating"):
                float_window(window["id"], item)
        if arrived:
            place(bound, ranks, outputs)
            # A workspace whose windows are all in is put in order now, while slower apps start.
            waiting = {space_of(i, ranks) for g in groups.values() for i in g.items}
            ready = {space_of(i, ranks) for i in bound.values()} - waiting - settled
            if ready:
                arrange_columns(bound, ranks, ready)
                fix_sizes(bound, outputs, ready, ranks)
                settled |= ready
                debug("settled early", sorted(ready))
        for group in groups.values():
            if not group.launched and gate and not gate.up():
                continue
            if group.due(now):
                # A browser brings back its own windows; starting it again would only open an
                # empty one, so whatever it did not bring back is let go.
                if group.got_window and group.browser:
                    debug("browser done", group.command, len(group.items))
                    group.items.clear()
                    continue
                # A launch that opened nothing costs that window, not the rest of the app.
                if group.launched and not group.got_window:
                    # The app is up but opens no more windows (a dialog, a viewer, a single-window
                    # app), so the rest of its saved windows cannot come back either.
                    if group.launches > 1:
                        debug("gave up", group.command, len(group.items))
                        group.items.clear()
                        continue
                    group.items.pop(0)
                    if not group.items:
                        continue
                debug("launch", group.command)
                group.launch(now)
        if not any(g.items for g in groups.values()):
            break
        time.sleep(POLL)

    debug("all windows in")
    # Sizes settle only after the app answers, so they get a second look. With animations off
    # nothing has to finish moving, so the waits are only for the apps' answers.
    time.sleep(0.06)
    arrange_columns(bound, ranks)
    debug("columns")
    if fix_sizes(bound, outputs):
        time.sleep(0.1)
        fix_sizes(bound, outputs)
    debug("sizes")
    fix_floating(bound)
    restore_focus(bound, outputs)
    time.sleep(0.05)
    debug("arranged")
    return len(bound)


def main():
    args = sys.argv[1:]
    try:
        if args[:1] == ["save"]:
            save()
            return 0
        if args[:1] == ["restore"]:
            return restore("--force" in args)
        if args[:1] == ["watch"]:
            return watch()
        if args[:1] == ["run"]:
            try:
                restore(False, greet=True)
            except Exception as error:  # noqa: BLE001  saving must keep working whatever restore met
                print(f"restore failed: {error!r}", file=sys.stderr)
            return watch()
    except subprocess.CalledProcessError as error:
        print(f"niri is not answering: {error}", file=sys.stderr)
        return 1
    print(__doc__.strip(), file=sys.stderr)
    return 2


sys.exit(main())
