#!/usr/bin/env python3
"""Claude Code status line hook: saves subscription limits for the panel widget. Prints nothing."""
import json
import os
import sys
import tempfile
import time
from pathlib import Path

STATE = Path(os.environ.get("XDG_STATE_HOME", Path.home() / ".local/state")) / "niri-desk"


def main():
    try:
        limits = json.load(sys.stdin).get("rate_limits")
    except ValueError:
        return
    if not isinstance(limits, dict):
        return
    out = {"updated": int(time.time())}
    for name in ("five_hour", "seven_day"):
        window = limits.get(name)
        if isinstance(window, dict) and "used_percentage" in window:
            out[name] = {"used": window["used_percentage"], "resets": window.get("resets_at", 0)}
    if len(out) == 1:
        return
    STATE.mkdir(parents=True, exist_ok=True)
    fd, tmp = tempfile.mkstemp(dir=STATE, prefix=".claude-usage")
    with os.fdopen(fd, "w") as file:
        json.dump(out, file)
    os.replace(tmp, STATE / "claude-usage.json")


if __name__ == "__main__":
    main()
