#!/usr/bin/env python3
"""settings.json dagi bitta qiymatni o'zgartiradi. Ochiq shell uni darhol qo'llaydi.

  falcon-set windows.gaps 8
  falcon-set appearance.mode '"light"'
  falcon-set --reset windows.gaps
"""
import json
import os
import subprocess
import sys
import tempfile
from pathlib import Path

path = Path(os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config")) / "falcon/settings.json"
args = sys.argv[1:]
reset = args[:1] == ["--reset"]
if reset:
    args = args[1:]
if len(args) != (1 if reset else 2):
    print(__doc__.strip(), file=sys.stderr)
    sys.exit(2)
data = json.loads(path.read_text() or "{}") if path.exists() else {}
keys = args[0].split(".")
node = data
for key in keys[:-1]:
    node = node.setdefault(key, {})
if reset:
    node.pop(keys[-1], None)
else:
    try:
        node[keys[-1]] = json.loads(args[1])
    except ValueError:
        node[keys[-1]] = args[1]
text = json.dumps(data, indent=2, ensure_ascii=False) + "\n"


def refused():
    """A value the desktop cannot use must not reach the file: every later change would fail too."""
    checker = Path(__file__).with_name("falcon-apply")
    if not checker.exists():
        return ""
    with tempfile.TemporaryDirectory() as folder:
        trial = Path(folder)
        (trial / "falcon").mkdir()
        (trial / "falcon/settings.json").write_text(text)
        (trial / "falcon/defaults.json").symlink_to(path.with_name("defaults.json"))
        (trial / "niri").symlink_to(path.parents[1] / "niri")
        run = subprocess.run([str(checker), "--check"], env=dict(os.environ, XDG_CONFIG_HOME=folder), capture_output=True, text=True, check=False)
    return run.stderr.strip() if run.returncode else ""


problem = refused()
if problem:
    print(problem, file=sys.stderr)
    sys.exit(1)
tmp = path.with_name(f"{path.name}.{os.getpid()}.tmp")
tmp.write_text(text)
os.replace(tmp, path)
