#!/usr/bin/env python3
"""Live subtitles for whatever is playing: listens to the system output and recognizes speech locally.

Audio stays on this computer and is not saved. Prints JSON lines:
  {"status": "loading|listening|missing|error"}, {"line": "..."} finished, {"partial": "..."} in progress.
"""
import json
import os
import re
import signal
import subprocess
import sys
import threading
import time

RATE = 16000
HOP = 2.5
COMMIT = 8.0
LIMIT = 12.0
QUIET = 0.0008
MODEL = os.environ.get("NIRI_DESK_LYRICS_MODEL", "small")
# Whisper invents these over music and silence, they are not in the audio.
NOISE = re.compile(r"(субтитр|продолжение следует|подпис|смотрите на видео|корректор|редактор субтитров|thanks for watching|subscribe|amara\.org|спасибо за просмотр|♪|^\W*$)", re.I)


def real_text(segment):
    text = segment.text.strip()
    # Labels like ПОЗИТИВНАЯ МУЗЫКА are written in capitals. no_speech_prob is not used: singing scores high on it.
    return not NOISE.search(text) and not text.isupper() and segment.avg_logprob > -1.4 and segment.compression_ratio < 2.4


def louder(audio, np):
    """Quiet system volume must not lower recognition quality."""
    peak = float(np.percentile(np.abs(audio), 99.5))
    return np.clip(audio / max(peak, 1e-3) * 0.7, -1, 1)


def say(**data):
    print(json.dumps(data, ensure_ascii=False), flush=True)


def monitor_source():
    source = os.environ.get("NIRI_DESK_LYRICS_SOURCE")
    if source:
        return source
    return subprocess.run(["pactl", "get-default-sink"], capture_output=True, text=True).stdout.strip() + ".monitor"


class Recorder:
    def __init__(self):
        self.lock = threading.Lock()
        self.data = bytearray()
        self.process = subprocess.Popen(["parec", "-d", monitor_source(), "--format=s16le", f"--rate={RATE}", "--channels=1", "--latency-msec=200"], stdout=subprocess.PIPE, stderr=subprocess.DEVNULL)
        threading.Thread(target=self.pump, daemon=True).start()

    def pump(self):
        while chunk := self.process.stdout.read(3200):
            with self.lock:
                self.data += chunk
                extra = len(self.data) - int(LIMIT * 2 * RATE)
                if extra > 0:
                    del self.data[:extra]

    def peek(self):
        with self.lock:
            return bytes(self.data)

    def drop(self, seconds):
        with self.lock:
            del self.data[:int(seconds * RATE) * 2]


def main():
    os.nice(10)
    signal.signal(signal.SIGTERM, lambda *_: sys.exit(0))
    try:
        import numpy as np
        from faster_whisper import WhisperModel
    except ImportError:
        say(status="missing")
        return
    say(status="loading")
    try:
        model = WhisperModel(MODEL, device="cpu", compute_type="int8", cpu_threads=max(2, (os.cpu_count() or 4) // 2))
    except Exception as error:
        say(status="error", message=str(error)[:200])
        return
    recorder = Recorder()
    say(status="listening")
    # The track title is the first hint: an intro without words must not decide the language.
    title = " ".join(sys.argv[1:])
    language = "ru" if re.search(r"[А-Яа-яЁё]", title) else None
    votes = []
    tick = 0
    last = ""
    pending = ""

    def commit(text):
        nonlocal last
        text = text.strip()
        if text and text != last:
            say(line=text)
            last = text

    def flush():
        nonlocal pending
        commit(pending)
        pending = ""
        say(partial="")

    try:
        while recorder.process.poll() is None:
            time.sleep(HOP)
            raw = recorder.peek()
            if len(raw) < RATE * 2 * 2:
                continue
            audio = np.frombuffer(raw, dtype=np.int16).astype(np.float32) / 32768
            if float(np.sqrt(np.mean(audio[-RATE * 2:] ** 2))) < QUIET:
                recorder.drop(len(raw) / 2 / RATE)
                flush()
                continue
            # Every few windows the language is checked again: a song can change it, a first guess can be wrong.
            tick += 1
            if len(audio) >= RATE * 4 and tick % 4 == 0:
                guess, probability, _ = model.detect_language(louder(audio, np))
                votes = (votes + [guess] if probability > 0.6 else votes)[-3:]
                if len(votes) == 3 and len(set(votes)) == 1 and votes[0] != language:
                    language = votes[0]
                    say(language=language)
            segments, info = model.transcribe(louder(audio, np), language=language, beam_size=5, vad_filter=False, condition_on_previous_text=False, no_speech_threshold=None)
            found = [s for s in segments if real_text(s)]
            length = len(audio) / RATE
            if not found:
                if length >= COMMIT:
                    recorder.drop(length - 2)
                flush()
                continue
            keep = found[-1]
            done = found[:-1]
            if length >= LIMIT - 1:
                done, keep = found, None
            for segment in done:
                commit(segment.text)
            if keep is None:
                recorder.drop(found[-1].end if found[-1].end < length else length)
                pending = ""
                say(partial="")
            else:
                if done:
                    recorder.drop(keep.start)
                pending = keep.text
                say(partial=pending.strip())
    finally:
        recorder.process.kill()


if __name__ == "__main__":
    main()
