#!/usr/bin/env bash
# Searches a picture on Google and opens the results in the browser. Usage: niri-desk-lens IMAGE
# The browser itself has to send the picture: Google ties it to the session that sent it, so results
# of an upload made by any other program open empty. So a small local page posts it and goes away.
# The picture goes only to Google.
set -euo pipefail

page="$(mktemp --tmpdir="${XDG_RUNTIME_DIR:-/tmp}" niri-desk-lens.XXXXXX.html)"
{
    cat <<HTML
<!doctype html>
<meta charset="utf-8">
<title>Google</title>
<form id="form" method="post" enctype="multipart/form-data" action="https://lens.google.com/v3/upload?ep=ccm&hl=$("$HOME/.local/bin/niri-desk-tr" --lang)&st=$(date +%s%3N)">
<input type="file" name="encoded_image" id="file">
</form>
<script>
HTML
    # A JavaScript string cannot hold a line break, so these three parts make one line.
    printf 'const bytes = Uint8Array.from(atob("'
    base64 -w0 "$1"
    printf '"), c => c.charCodeAt(0));\n'
    cat <<'HTML'
const list = new DataTransfer();
list.items.add(new File([bytes], "image.png", { type: "image/png" }));
document.getElementById("file").files = list.files;
document.getElementById("form").submit();
</script>
HTML
} >"$page"

xdg-open "$page" >/dev/null 2>&1
# The browser only opens a tab and may be on another workspace, so it is brought forward.
sleep 0.4
"$HOME/.local/bin/niri-desk-raise" 'firefox|chrom|brave|zen|helium' true >/dev/null 2>&1 || true
# The page holds the picture, and a browser that is just starting needs time to read it.
(sleep 30; rm -f "$page") >/dev/null 2>&1 &
disown
