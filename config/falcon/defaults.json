    "lock": "Mod+X",
    "overview": "Mod+O",
    "scratch": "Mod+Grave",
    "sticky": "Mod+S",
    "browser": "Mod+B",
    "files": "Mod+E",
    "notes": "Mod+N",
    "close": "Mod+Q",
    "widthCycle": "Mod+R",
    "maximize": "Mod+M",
    "fullscreen": "Mod+Shift+F",
    "screenshot": "Mod+Shift+S",
    "record": "Mod+Shift+R",
    "ocr": "Mod+P",
    "translate": "Mod+Alt+P",
    "widgets": "Mod+Shift+W",
