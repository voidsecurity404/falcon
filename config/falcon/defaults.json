    "autoBackForth": false,
    "animations": true,
    "animationSpeed": 1.0,
    "rules": [],
    "edgeMargin": 0,
    "shadowSoftness": 34,
    "blurStrength": 3,
    "overviewZoom": 0.46
  },
  "panel": {
    "position": "top",
    "style": "hug",
    "ribbon": true,
    "hideEmpty": false,
    "lang": true,
    "wifi": true,
    "volume": true,
    "battery": true,
    "tray": true,
    "clockSeconds": false,
    "clockDate": false,
    "clock24": true,
    "claude": true,
