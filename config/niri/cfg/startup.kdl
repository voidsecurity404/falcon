spawn-at-startup "awww-daemon"
spawn-at-startup "~/.local/bin/niri-desk-wallpaper" "--restore"
spawn-at-startup "~/.local/bin/niri-desk-shell"
spawn-at-startup "wl-paste" "--watch" "cliphist" "store"
spawn-at-startup "hypridle"
spawn-sh-at-startup "systemctl --user start hyprpolkitagent.service"
spawn-at-startup "~/.local/bin/niri-desk-session" "restore"
