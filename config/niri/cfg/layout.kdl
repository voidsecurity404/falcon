layout {
    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
    }

    // Fon workspace bilan birga siljimasligi uchun shaffof (rules.kdl ga qarang).
    background-color "transparent"

    border {
        off
    }
    shadow {
        softness 34
        spread 0
        offset x=0 y=14
    }
}

overview {
    zoom 0.46
    workspace-shadow {
        off
    }
}

gestures {
    hot-corners {
        off
    }
}

blur {
    passes 3
    offset 3.0
    noise 0.02
    saturation 1.3
}

animations {
    workspace-switch {
        spring damping-ratio=1.0 stiffness=800 epsilon=0.0001
    }
    window-open {
        duration-ms 220
        curve "ease-out-expo"
    }
    window-close {
        duration-ms 160
        curve "ease-out-quad"
    }
    horizontal-view-movement {
        spring damping-ratio=1.0 stiffness=700 epsilon=0.0001
    }
    window-movement {
        spring damping-ratio=1.0 stiffness=700 epsilon=0.0001
    }
    window-resize {
        spring damping-ratio=1.0 stiffness=700 epsilon=0.0001
    }
    overview-open-close {
        spring damping-ratio=1.0 stiffness=800 epsilon=0.0001
    }
}

prefer-no-csd

screenshot-path "~/Pictures/Screenshots/%Y-%m-%d_%H-%M-%S.png"

// Alt+Tab: oxirgi ishlatilgan oynalar, jonli ko'rinish bilan.
recent-windows {
    debounce-ms 500
    open-delay-ms 120
    highlight {
        padding 18
        corner-radius 16
    }
    previews {
        max-height 320
        max-scale 0.4
    }
    binds {
        Alt+Tab { next-window; }
        Alt+Shift+Tab { previous-window; }
        Alt+grave { next-window filter="app-id"; }
        Alt+Shift+grave { previous-window filter="app-id"; }
    }
}

hotkey-overlay {
    skip-at-startup
}

environment {
    QT_QPA_PLATFORM "wayland"
    QT_WAYLAND_DISABLE_WINDOWDECORATION "1"
    ELECTRON_OZONE_PLATFORM_HINT "auto"
}
