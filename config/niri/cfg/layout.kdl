layout {
    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
    }

    // Fon workspace bilan birga siljimasligi uchun shaffof (rules.kdl ga qarang).
    background-color "transparent"

    border {
        off
    }
    shadow {
        softness 34
        spread 0
        offset x=0 y=14
    }
}

overview {
    zoom 0.46
    workspace-shadow {
        off
    }
}

gestures {
    // Pointer in the top left corner of the screen opens the overview of workspaces.
    hot-corners {
        top-left
    }
}

blur {
    passes 3
    offset 3.0
    noise 0.02
    saturation 1.3
}

animations {
    workspace-switch {
        spring damping-ratio=1.0 stiffness=800 epsilon=0.0001
    }
    // window-open comes from Settings (windows.openAnimation), see generated/settings.kdl.
    window-close {
        duration-ms 160
        curve "ease-out-quad"
    }
    horizontal-view-movement {
        spring damping-ratio=1.0 stiffness=700 epsilon=0.0001
    }
    window-movement {
        spring damping-ratio=1.0 stiffness=700 epsilon=0.0001
    }
    window-resize {
        spring damping-ratio=1.0 stiffness=700 epsilon=0.0001
    }
    overview-open-close {
        spring damping-ratio=1.0 stiffness=800 epsilon=0.0001
    }
}

prefer-no-csd

// Alt+Tab is our own card fan (modules/WindowSwitcher.qml). niri still keeps the order of recent windows.
recent-windows {
    off
    debounce-ms 500
}

hotkey-overlay {
    skip-at-startup
}

environment {
    QT_QPA_PLATFORM "wayland"
    QT_WAYLAND_DISABLE_WINDOWDECORATION "1"
    QT_QPA_PLATFORMTHEME "qt6ct"
    ELECTRON_OZONE_PLATFORM_HINT "auto"
}
