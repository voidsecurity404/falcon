// Column and height presets, border, tab indicator, hot corner, title bars and every
// animation come from Settings (generated/settings.kdl).
layout {
    // Fon workspace bilan birga siljimasligi uchun shaffof (rules.kdl ga qarang).
    background-color "transparent"

    shadow {
        softness 34
        spread 0
        offset x=0 y=14
    }
}

overview {
    zoom 0.46
    workspace-shadow {
        off
    }
}

blur {
    passes 3
    offset 3.0
    noise 0.02
    saturation 1.3
}

// Alt+Tab is our own card fan (modules/WindowSwitcher.qml). niri still keeps the order of recent windows.
recent-windows {
    off
    debounce-ms 500
}

hotkey-overlay {
    skip-at-startup
}

// environment is written by falcon-apply into generated/settings.kdl (ENVIRONMENT), since
// GIO_EXTRA_MODULES needs the home folder's full path and niri allows only one such block.
