// falcon: asosiy fayl. Har bir mavzu alohida turadi.
// Tartib muhim: keyingi include avvalgisini ustidan yozadi.
include "cfg/layout.kdl"
// Rules for every window from Settings, before the app rules so those still win.
include optional=true "generated/window-defaults.kdl"
include "cfg/rules.kdl"
include "cfg/startup.kdl"
include "cfg/binds.kdl"

// Bu fayllar avtomatik yoziladi, qo'lda o'zgartirmang:
// settings.kdl va binds.kdl — Sozlamalar oynasidan, colors.kdl — fon rasmidan, zen.kdl — fokus rejimidan, sticky.kdl — sticky oynadan.
include "generated/settings.kdl"
include "generated/binds.kdl"
include "generated/colors.kdl"
include "generated/zen.kdl"
// Written by the shell while a window is sticky. Optional, so a fresh install works without it.
include optional=true "generated/sticky.kdl"
// Written by game mode (bin/falcon-game): animations and shadows off. Empty when off.
include optional=true "generated/game.kdl"
// Written by falcon-session while windows come back after login: animations off. Empty otherwise.
include optional=true "generated/restore.kdl"

// O'z qo'shimchalaringiz shu faylga yoziladi, yangilanishda tegilmaydi.
include "cfg/user.kdl"
