layout {
    focus-ring {
        active-color "#8fc7ee"
        inactive-color "#3a4652"
        urgent-color "#ffb4ab"
    }
    shadow {
        color "#00000070"
    }
}
recent-windows {
    highlight {
        active-color "#8fc7ee"
        urgent-color "#ffb4ab"
    }
}
overview {
    backdrop-color "#0b1a29"
}
