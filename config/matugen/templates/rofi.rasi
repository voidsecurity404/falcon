/* Generated by matugen from the wallpaper, do not edit by hand. */
* {
    background-color: transparent;
    text-color: {{colors.on_surface.default.hex}};
    bg: {{colors.surface_container.default.hex}}f0;
    bg-alt: {{colors.surface_container_high.default.hex}};
    accent: {{colors.primary.default.hex}};
    on-accent: {{colors.on_primary.default.hex}};
    muted: {{colors.on_surface_variant.default.hex}};
    font: "Geist 12";
}
window { background-color: @bg; border: 1px; border-color: {{colors.outline_variant.default.hex}}; border-radius: 18px; width: 560px; padding: 14px; }
mainbox { spacing: 10px; children: [ inputbar, listview ]; }
inputbar { background-color: @bg-alt; border-radius: 12px; padding: 10px 14px; spacing: 8px; children: [ prompt, entry ]; }
prompt { text-color: @accent; }
entry { placeholder-color: @muted; }
listview { lines: 8; spacing: 4px; scrollbar: false; }
element { padding: 8px 12px; border-radius: 10px; spacing: 10px; }
element selected.normal { background-color: @accent; text-color: @on-accent; }
element-icon { size: 22px; background-color: transparent; }
element-text { background-color: transparent; text-color: inherit; }
