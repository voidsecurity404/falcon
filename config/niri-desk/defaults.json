{
  "appearance": {
    "mode": "dark",
    "scheme": "scheme-tonal-spot",
    "accent": "",
    "font": "Geist",
    "monoFont": "Geist Mono",
    "fontScale": 1.0,
    "panelOpacity": 0.65,
    "terminalOpacity": 0.78,
    "terminalFontSize": 11,
    "cursorTheme": "Adwaita",
    "cursorSize": 24,
    "language": "auto",
    "cursorHideTyping": true,
    "cursorHideAfter": 0
  },
  "terminal": {
    "cursorShape": "block",
    "cursorBlink": true,
    "padding": 14,
    "lineHeight": 120,
    "scrollback": 2000
  },
  "windows": {
    "gaps": 14,
    "radius": 13,
    "focusRing": 2,
    "shadow": true,
    "blur": true,
    "inactiveOpacity": 1.0,
    "centerFocused": "never",
    "centerSingle": true,
    "defaultWidth": 0.5,
    "tabbedByDefault": false,
    "focusFollowsMouse": false,
    "warpMouse": false,
    "autoBackForth": false,
    "animations": true,
    "animationSpeed": 1.0,
    "rules": [],
    "edgeMargin": 0,
    "shadowSoftness": 34,
    "blurStrength": 3,
    "overviewZoom": 0.46
  },
  "panel": {
    "position": "top",
    "ribbon": true,
    "hideEmpty": false,
    "lang": true,
    "wifi": true,
    "volume": true,
    "battery": true,
    "tray": true,
    "clockSeconds": false,
    "clockDate": false,
    "clock24": true,
    "claude": true
  },
  "keyboard": {
    "layouts": "us,ru",
    "options": "grp:alt_shift_toggle,compose:caps",
    "repeatDelay": 300,
    "repeatRate": 35,
    "perWindow": true,
    "numlock": true
  },
  "pointer": {
    "tap": true,
    "naturalScroll": true,
    "disableWhileTyping": true,
    "touchpadSpeed": 0.0,
    "scrollFactor": 0.8,
    "mouseFlat": true,
    "mouseSpeed": 0.0,
    "clickMethod": "button-areas",
    "mouseNaturalScroll": false
  },
  "idle": {
    "lock": 300,
    "screenOff": 360,
    "suspend": 1800
  },
  "notifications": {
    "seconds": 3.6,
    "history": 30
  },
  "nightlight": {
    "temperature": 4000,
    "auto": false,
    "from": "20:00",
    "to": "07:00"
  },
  "weather": {
    "enabled": true,
    "lat": 41.31,
    "lon": 69.28,
    "unit": "celsius"
  },
  "wallpaperDir": "~/Pictures/Wallpapers",
  "binds": {
    "terminal": "Mod+Return",
    "apps": "",
    "clipboard": "Mod+V",
    "dashboard": "Mod+D",
    "control": "Mod+C",
    "wallpapers": "Mod+W",
    "settings": "Mod+Comma",
    "zen": "Mod+F",
    "lock": "Mod+X",
    "overview": "Mod+O",
    "scratch": "Mod+Grave",
    "sticky": "Mod+S",
    "browser": "Mod+B",
    "files": "Mod+E",
    "notes": "Mod+N",
    "close": "Mod+Q",
    "widthCycle": "Mod+R",
    "maximize": "Mod+M",
    "fullscreen": "Mod+Shift+F",
    "screenshot": "Mod+Shift+S",
    "record": "Mod+Shift+R",
    "ocr": "Mod+P",
    "translate": "Mod+Alt+P",
    "widgets": "Mod+Shift+W"
  },
  "session": {
    "restore": true
  },
  "translate": {
    "to": ""
  },
  "monitors": {},
  "schedule": {
    "mode": false,
    "lightFrom": "07:00",
    "darkFrom": "19:00"
