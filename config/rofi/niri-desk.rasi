// niri-desk app launcher. Colors come from the wallpaper through niri-desk-colors.rasi.
configuration {
    show-icons: true;
    icon-theme: "Adwaita";
    font: "Geist 12";
    terminal: "kitty";
    matching: "normal";
    sort: true;
    drun-match-fields: "name,generic,keywords,exec";
    drun-display-format: "{name}";
    window-format: "{t}";
    hover-select: true;
    me-select-entry: "";
    me-accept-entry: "MousePrimary";
    kb-mode-next: "Tab";
    kb-mode-previous: "ISO_Left_Tab";
    kb-row-tab: "";
    kb-element-next: "";
    kb-element-prev: "";
}

@import "niri-desk-colors"

* {
    background-color: transparent;
    text-color: @nd-text;
    border-color: transparent;
}

window {
    location: north;
    anchor: north;
    y-offset: 52px;
    width: 780px;
    padding: 10px;
    border: 1px;
    border-radius: 16px;
    border-color: @nd-outline;
    background-color: @nd-pill;
}

mainbox {
    spacing: 8px;
    children: [ inputbar, message, listview, mode-switcher ];
}

inputbar {
    spacing: 10px;
    padding: 10px 12px;
    border-radius: 11px;
    background-color: @nd-field;
    children: [ textbox-mark, entry ];
}

textbox-mark {
    expand: false;
    str: "›";
    text-color: @nd-accent;
    vertical-align: 0.5;
    font: "Geist Medium 15";
}

entry {
    vertical-align: 0.5;
    cursor-color: @nd-accent;
    cursor-width: 2px;
    placeholder-color: @nd-muted;
    font: "Geist 13";
}

mode-switcher {
    spacing: 4px;
}

button {
    padding: 6px 10px;
    horizontal-align: 0.5;
    border-radius: 8px;
    text-color: @nd-muted;
    font: "Geist 10.5";
    vertical-align: 0.5;
}

button selected {
    background-color: @nd-accent-soft;
    text-color: @nd-accent;
}

listview {
    columns: 4;
    lines: 4;
    flow: horizontal;
    fixed-columns: true;
    fixed-height: false;
    dynamic: true;
    cycle: true;
    scrollbar: false;
    spacing: 8px;
}

element {
    orientation: vertical;
    spacing: 8px;
    padding: 14px 8px 10px 8px;
    border: 1px;
    border-radius: 15px;
    border-color: transparent;
    background-color: @nd-field;
}

element normal.normal, element alternate.normal, element normal.active, element alternate.active {
    background-color: @nd-field;
    text-color: @nd-text;
}

element selected.normal, element selected.active {
    background-color: @nd-accent-soft;
    border-color: @nd-accent;
    text-color: @nd-accent;
}

/* The empty row under a calculator result stays invisible. */
element normal.urgent, element alternate.urgent, element selected.urgent {
    background-color: transparent;
    border-color: transparent;
    text-color: @nd-error;
}

element-icon {
    size: 44px;
    horizontal-align: 0.5;
    text-color: inherit;
}

element-text {
    horizontal-align: 0.5;
    vertical-align: 0.5;
    text-color: inherit;
    highlight: bold;
    font: "Geist 11";
}

message {
    padding: 0px 12px;
}

error-message {
    padding: 8px 12px;
}


textbox {
    text-color: @nd-muted;
    font: "Geist 15";
}
