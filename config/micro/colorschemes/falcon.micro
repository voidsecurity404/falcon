# Falcon: only the terminal's own colors, so micro follows the wallpaper
# the moment kitty does. blue is the theme's primary, magenta its tertiary,
# cyan its secondary; red, green and yellow keep their meaning.
color-link default "default"
color-link comment "brightblack"
color-link identifier "blue"
color-link constant "magenta"
color-link constant.string "green"
color-link constant.string.char "green"
color-link constant.number "magenta"
color-link constant.bool "magenta"
color-link statement "blue,default"
color-link symbol "cyan"
color-link symbol.brackets "default"
color-link preproc "brightmagenta"
color-link type "cyan"
color-link special "magenta"
color-link underlined "underline blue"
color-link error "bold red"
color-link todo "bold yellow"
color-link hlsearch "black,yellow"
color-link statusline "black,blue"
color-link tabbar "white,black"
color-link indent-char "brightblack"
color-link line-number "brightblack"
color-link current-line-number "blue"
color-link diff-added "green"
color-link diff-modified "yellow"
color-link diff-deleted "red"
color-link gutter-error "red"
color-link gutter-warning "yellow"
color-link cursor-line "black"
color-link color-column "black"
color-link selection "black,blue"
color-link scrollbar "blue"
color-link message "blue"
color-link divider "blue"
color-link match-brace "black,cyan"
